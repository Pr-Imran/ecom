@using FashionStore.Application.Email
@model FashionStore.Application.Email.PasswordResetEmail
@{
    Layout = "_EmailLayout";
}
<p>Hello@(string.IsNullOrWhiteSpace(Model.RecipientName) || Model.RecipientName == "there" ? string.Empty : $" {Model.RecipientName}"),</p>
<p>We received a request to reset the password for your @Model.StoreName account. Click the button below to choose a new password.</p>
<div style="margin:8px 0 20px 0;">
    <a class="btn" href="@Model.ResetUrl">Reset my password</a>
</div>
<div class="box">
    <p class="muted" style="margin:0;">This link expires in @Model.ExpiryHours hour@(Model.ExpiryHours == 1 ? string.Empty : "s"). If the button does not work, copy and paste this address into your browser:</p>
    <p class="muted" style="margin:4px 0 0 0;word-break:break-all;">@Model.ResetUrl</p>
</div>
<p class="muted">If you did not request a password reset, you can safely ignore this email. Your password will not be changed.</p>
