@using FashionStore.Application.Email
@model FashionStore.Application.Email.LowStockAlertEmail
@{
    Layout = "~/Views/Emails/_EmailLayout.cshtml";
}
<p>Hello,</p>
<p>The following product variants are at or below their configured low-stock threshold and need attention:</p>
<table role="presentation" class="items-table" cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <th>Product</th>
        <th>Variant</th>
        <th align="right">Available</th>
        <th align="right">Threshold</th>
    </tr>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.ProductName</td>
            <td>@item.Variant</td>
            <td align="right">@item.Available</td>
            <td align="right">@(item.Threshold?.ToString() ?? "-")</td>
        </tr>
    }
</table>
<div style="margin:20px 0 8px 0;">
    <a class="btn" href="@Model.InventoryUrl">Open inventory</a>
</div>
<p class="muted">This is an automated alert. Reply to this email to contact your inventory administrator.</p>
