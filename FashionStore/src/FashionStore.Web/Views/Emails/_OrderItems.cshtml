@using FashionStore.Application.Email
@model FashionStore.Application.Email.OrderEmail
<table role="presentation" class="items-table" cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <th>Product</th>
        <th align="right">Qty</th>
        <th align="right">Price</th>
        <th align="right">Total</th>
    </tr>
    @foreach (var line in Model.Items)
    {
        <tr>
            <td>
                <strong>@line.ProductName</strong>
                @if (!string.IsNullOrWhiteSpace(line.Variant))
                {
                    <br /><span class="muted">@line.Variant</span>
                }
            </td>
            <td align="right">@line.Quantity</td>
            <td align="right">@line.UnitPrice.ToString("N2")</td>
            <td align="right">@line.LineTotal.ToString("N2")</td>
        </tr>
    }
</table>
<table role="presentation" class="totals" cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="right" class="grand">Order total (@Model.Currency)</td>
        <td align="right" class="grand" style="width:110px;">@Model.GrandTotal.ToString("N2")</td>
    </tr>
</table>
