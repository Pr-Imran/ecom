@using FashionStore.Application.Email
@model FashionStore.Application.Email.OrderDeliveredEmail
@{
    Layout = "~/Views/Emails/_EmailLayout.cshtml";
}
<p>Hello@(string.IsNullOrWhiteSpace(Model.RecipientName) || Model.RecipientName == "there" ? string.Empty : $" {Model.RecipientName}"),</p>
<p>Your <strong>order @Model.OrderNumber</strong> has been delivered. We hope you love everything you ordered.</p>
<p>If anything is not right, you can start a return from your order page within the return window.</p>
<div style="margin:8px 0 20px 0;">
    <a class="btn" href="@Model.OrderUrl">View my order</a>
</div>
<h2 style="font-size:16px;margin:0 0 12px 0;">Order summary</h2>
@{ await Html.RenderPartialAsync("~/Views/Emails/_OrderItems.cshtml", Model); }
