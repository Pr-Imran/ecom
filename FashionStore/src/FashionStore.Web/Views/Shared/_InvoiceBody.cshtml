@using FashionStore.Application.Formatting
@model FashionStore.Web.Models.InvoiceViewModel
@{
    var invoice = Model.Invoice;
    var branding = Model.Branding;
    var currency = invoice.Currency;
}

<div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden print:shadow-none print:border-0" id="invoiceBody">
    <!-- Branding header -->
    <div class="border-b border-gray-200 px-5 py-6 sm:px-8 flex flex-col sm:flex-row justify-between gap-6 print:px-0">
        <div>
            @if (!string.IsNullOrWhiteSpace(branding.LogoPath))
            {
                <img src="@branding.LogoPath" alt="@branding.CompanyName" class="h-10 w-auto mb-3 object-contain" />
            }
            <p class="text-2xl font-bold text-gray-900">@(string.IsNullOrWhiteSpace(branding.CompanyName) ? "FashionStore" : branding.CompanyName)</p>
            @if (!string.IsNullOrWhiteSpace(branding.CompanyAddress))
            {
                <p class="text-sm text-gray-500 mt-1">@branding.CompanyAddress</p>
            }
            @if (!string.IsNullOrWhiteSpace(branding.CompanyEmail))
            {
                <p class="text-sm text-gray-500">@branding.CompanyEmail</p>
            }
            @if (!string.IsNullOrWhiteSpace(branding.CompanyPhone))
            {
                <p class="text-sm text-gray-500">@branding.CompanyPhone</p>
            }
        </div>
        <div class="sm:text-right">
            <p class="text-3xl font-bold text-gray-900 tracking-tight">INVOICE</p>
            <p class="mt-2 text-lg font-bold text-brand-primary font-mono">#@invoice.InvoiceNumber</p>
            <p class="text-sm text-gray-500">Order @invoice.PublicOrderNumber</p>
            <p class="text-sm text-gray-500">Issued @InvoiceFormatting.FormatDate(invoice.IssueDateUtc)</p>
            <p class="text-sm text-gray-500">Status <span class="font-medium text-gray-700">@invoice.Status</span></p>
        </div>
    </div>

    <!-- Addresses -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 px-5 py-6 sm:px-8 border-b border-gray-200 print:px-0">
        <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Bill to</p>
            @if (invoice.BillingAddress is not null)
            {
                <p class="font-medium text-gray-900">@invoice.BillingAddress.RecipientName</p>
                <p class="text-sm text-gray-600 mt-0.5">@invoice.BillingAddress.AddressLine1</p>
                if (!string.IsNullOrWhiteSpace(invoice.BillingAddress.AddressLine2))
                {
                    <p class="text-sm text-gray-600">@invoice.BillingAddress.AddressLine2</p>
                }
                <p class="text-sm text-gray-600">@invoice.BillingAddress.City@(!string.IsNullOrWhiteSpace(invoice.BillingAddress.Region) ? ", " + invoice.BillingAddress.Region : "") @invoice.BillingAddress.PostalCode</p>
                <p class="text-sm text-gray-600">@invoice.BillingAddress.CountryCode</p>
                if (!string.IsNullOrWhiteSpace(invoice.BillingAddress.Phone))
                {
                    <p class="text-sm text-gray-500 mt-1">@invoice.BillingAddress.Phone</p>
                }
            }
            else
            {
                <p class="text-sm text-gray-400">—</p>
            }
        </div>
        <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Ship to</p>
            @if (invoice.ShippingAddress is not null)
            {
                <p class="font-medium text-gray-900">@invoice.ShippingAddress.RecipientName</p>
                <p class="text-sm text-gray-600 mt-0.5">@invoice.ShippingAddress.AddressLine1</p>
                if (!string.IsNullOrWhiteSpace(invoice.ShippingAddress.AddressLine2))
                {
                    <p class="text-sm text-gray-600">@invoice.ShippingAddress.AddressLine2</p>
                }
                <p class="text-sm text-gray-600">@invoice.ShippingAddress.City@(!string.IsNullOrWhiteSpace(invoice.ShippingAddress.Region) ? ", " + invoice.ShippingAddress.Region : "") @invoice.ShippingAddress.PostalCode</p>
                <p class="text-sm text-gray-600">@invoice.ShippingAddress.CountryCode</p>
                if (!string.IsNullOrWhiteSpace(invoice.ShippingAddress.Phone))
                {
                    <p class="text-sm text-gray-500 mt-1">@invoice.ShippingAddress.Phone</p>
                }
                if (!string.IsNullOrWhiteSpace(invoice.ShippingAddress.DeliveryInstructions))
                {
                    <p class="text-xs text-gray-500 italic mt-1">Note: @invoice.ShippingAddress.DeliveryInstructions</p>
                }
            }
            else
            {
                <p class="text-sm text-gray-400">—</p>
            }
        </div>
    </div>

    <!-- Customer / Payment / Delivery -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 px-5 py-6 sm:px-8 border-b border-gray-200 bg-gray-50/50 print:px-0 print:bg-transparent">
        <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Customer</p>
            <p class="text-sm text-gray-700 font-medium">@(string.IsNullOrWhiteSpace(invoice.CustomerName) ? "Guest" : invoice.CustomerName)</p>
            @if (!string.IsNullOrWhiteSpace(invoice.GuestEmail))
            {
                <p class="text-sm text-gray-600">@invoice.GuestEmail</p>
            }
            @if (!string.IsNullOrWhiteSpace(invoice.GuestPhone))
            {
                <p class="text-sm text-gray-600">@invoice.GuestPhone</p>
            }
        </div>
        <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Payment</p>
            <p class="text-sm text-gray-700">@(string.IsNullOrWhiteSpace(invoice.PaymentMethodCode) ? "—" : invoice.PaymentMethodCode)</p>
            <p class="text-sm text-gray-600">@invoice.PaymentStatus</p>
            <p class="text-sm text-gray-600">Paid @InvoiceFormatting.FormatMoney(invoice.PaidAmount, currency)</p>
            <p class="text-sm text-gray-600">Outstanding @InvoiceFormatting.FormatMoney(invoice.OutstandingAmount, currency)</p>
        </div>
        <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Delivery</p>
            <p class="text-sm text-gray-700">@(string.IsNullOrWhiteSpace(invoice.ShippingMethodName) ? "—" : invoice.ShippingMethodName)</p>
            @if (!string.IsNullOrWhiteSpace(invoice.TrackingNumber))
            {
                <p class="text-sm text-gray-600">@invoice.TrackingNumber</p>
            }
        </div>
    </div>

    <!-- Line items: table on desktop / print, cards on small screens -->
    <div class="px-5 py-6 sm:px-8 print:px-0">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Items</p>

        <table class="hidden sm:table print:table w-full text-sm">
            <thead>
                <tr class="bg-gray-900 text-left text-white">
                    <th class="py-2 px-3 font-semibold">Item</th>
                    <th class="py-2 px-3 font-semibold">SKU</th>
                    <th class="py-2 px-3 font-semibold">Colour / Size</th>
                    <th class="py-2 px-3 font-semibold text-right">Qty</th>
                    <th class="py-2 px-3 font-semibold text-right">Unit</th>
                    <th class="py-2 px-3 font-semibold text-right">Total</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in invoice.Items)
                {
                    <tr>
                        <td class="py-3 px-3 font-medium text-gray-900">@item.ProductName</td>
                        <td class="py-3 px-3 text-gray-500 font-mono text-xs">@item.Sku</td>
                        <td class="py-3 px-3 text-gray-600">
                            @if (!string.IsNullOrWhiteSpace(item.ColourName) || !string.IsNullOrWhiteSpace(item.SizeName))
                            {
                                <span class="inline-flex items-center gap-1.5">
                                    @if (!string.IsNullOrWhiteSpace(item.ColourName))
                                    {
                                        <span class="inline-block w-3 h-3 rounded-full border border-gray-300" style="background-color: @(!string.IsNullOrWhiteSpace(item.ColourValue) && item.ColourValue != "none" ? item.ColourValue : "#e5e7eb")"></span>
                                        <span class="font-medium text-gray-800">@item.ColourName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.SizeName))
                                    {
                                        <span class="text-gray-500">/</span>
                                        <span class="font-medium text-gray-800">@item.SizeName</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="text-gray-400">—</span>
                            }
                        </td>
                        <td class="py-3 px-3 text-right">@item.Quantity</td>
                        <td class="py-3 px-3 text-right">@InvoiceFormatting.FormatMoney(item.UnitPrice, currency)</td>
                        <td class="py-3 px-3 text-right font-semibold text-gray-900">@InvoiceFormatting.FormatMoney(item.LineTotal, currency)</td>
                    </tr>
                }
            </tbody>
        </table>

        <ul class="sm:hidden print:hidden space-y-3">
            @foreach (var item in invoice.Items)
            {
                <li class="border border-gray-200 rounded-lg p-4">
                    <div class="flex items-start justify-between gap-3">
                        <p class="font-medium text-gray-900 text-sm leading-snug">@item.ProductName</p>
                        <p class="font-semibold text-gray-900 text-sm whitespace-nowrap">@InvoiceFormatting.FormatMoney(item.LineTotal, currency)</p>
                    </div>
                    <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500">
                        <span class="font-mono">@item.Sku</span>
                        @if (!string.IsNullOrWhiteSpace(item.ColourName))
                        {
                            <span class="inline-flex items-center gap-1">
                                <span class="inline-block w-2.5 h-2.5 rounded-full border border-gray-300" style="background-color: @(!string.IsNullOrWhiteSpace(item.ColourValue) && item.ColourValue != "none" ? item.ColourValue : "#e5e7eb")"></span>
                                <span class="font-medium text-gray-700">@item.ColourName</span>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.SizeName))
                        {
                            <span class="font-medium text-gray-700">Size @item.SizeName</span>
                        }
                    </div>
                    <div class="mt-2 flex items-center justify-between text-xs text-gray-500">
                        <span>Qty @item.Quantity × @InvoiceFormatting.FormatMoney(item.UnitPrice, currency)</span>
                    </div>
                </li>
            }
        </ul>

        <!-- Totals -->
        <div class="mt-6 flex justify-end">
            <div class="w-full sm:w-80 space-y-1.5 text-sm">
                <div class="flex justify-between py-0.5"><span class="text-gray-500">Subtotal</span><span class="text-gray-800">@InvoiceFormatting.FormatMoney(invoice.Subtotal, currency)</span></div>
                @if (invoice.CouponDiscount > 0)
                {
                    <div class="flex justify-between py-0.5"><span class="text-gray-500">Coupon discount</span><span class="text-gray-800">-@InvoiceFormatting.FormatMoney(invoice.CouponDiscount, currency)</span></div>
                }
                @if (invoice.ProductDiscount > 0)
                {
                    <div class="flex justify-between py-0.5"><span class="text-gray-500">Product discount</span><span class="text-gray-800">-@InvoiceFormatting.FormatMoney(invoice.ProductDiscount, currency)</span></div>
                }
                <div class="flex justify-between py-0.5"><span class="text-gray-500">Shipping</span><span class="text-gray-800">@InvoiceFormatting.FormatMoney(invoice.ShippingCharge, currency)</span></div>
                <div class="flex justify-between py-0.5"><span class="text-gray-500">Tax</span><span class="text-gray-800">@InvoiceFormatting.FormatMoney(invoice.Tax, currency)</span></div>
                <div class="flex justify-between border-t border-gray-200 pt-2 text-base font-bold text-gray-900"><span>Grand total</span><span>@InvoiceFormatting.FormatMoney(invoice.GrandTotal, currency)</span></div>
                <div class="flex justify-between py-0.5 pt-1"><span class="text-gray-500">Paid</span><span class="text-gray-700">@InvoiceFormatting.FormatMoney(invoice.PaidAmount, currency)</span></div>
                <div class="flex justify-between py-0.5"><span class="text-gray-500">Outstanding</span><span class="font-medium text-gray-800">@InvoiceFormatting.FormatMoney(invoice.OutstandingAmount, currency)</span></div>
                @if (invoice.RefundedAmount > 0)
                {
                    <div class="flex justify-between py-0.5"><span class="text-gray-500">Refunded</span><span class="text-gray-700">@InvoiceFormatting.FormatMoney(invoice.RefundedAmount, currency)</span></div>
                }
            </div>
        </div>

        @if (invoice.Notes.Count > 0)
        {
            <div class="mt-6 border-t border-gray-200 pt-4">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Notes</p>
                @foreach (var note in invoice.Notes)
                {
                    <p class="text-sm text-gray-600">@note</p>
                }
            </div>
        }

        @if (invoice.RefundReferences.Count > 0)
        {
            <div class="mt-6 border-t border-gray-200 pt-4">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Returns &amp; refunds</p>
                @foreach (var refund in invoice.RefundReferences)
                {
                    <p class="text-sm text-gray-600">
                        @if (string.IsNullOrWhiteSpace(refund.ProviderRefundId))
                        {
                            <text>Refund of @InvoiceFormatting.FormatMoney(refund.Amount, refund.Currency) on @InvoiceFormatting.FormatDate(refund.CreatedAtUtc)</text>
                        }
                        else
                        {
                            <text>Refund @refund.ProviderRefundId of @InvoiceFormatting.FormatMoney(refund.Amount, refund.Currency) on @InvoiceFormatting.FormatDate(refund.CreatedAtUtc)</text>
                        }
                    </p>
                }
            </div>
        }
    </div>

    <!-- Registration / footer line -->
    @if (!string.IsNullOrWhiteSpace(branding.TaxId) || !string.IsNullOrWhiteSpace(branding.RegistrationNumber))
    {
        <div class="border-t border-gray-200 px-5 py-4 sm:px-8 flex flex-col sm:flex-row justify-between gap-1 text-xs text-gray-400 print:px-0">
            <span>@(string.IsNullOrWhiteSpace(branding.CompanyName) ? "FashionStore" : branding.CompanyName) · @branding.CompanyAddress</span>
            <span>
                @if (!string.IsNullOrWhiteSpace(branding.TaxId))
                {
                    <span>Tax ID @branding.TaxId</span>
                }
                @if (!string.IsNullOrWhiteSpace(branding.TaxId) && !string.IsNullOrWhiteSpace(branding.RegistrationNumber))
                {
                    <span> · </span>
                }
                @if (!string.IsNullOrWhiteSpace(branding.RegistrationNumber))
                {
                    <span>Reg @branding.RegistrationNumber</span>
                }
            </span>
        </div>
    }

    <p class="text-center text-xs text-gray-400 pb-5 print:hidden">Generated @InvoiceFormatting.FormatDate(invoice.GeneratedAtUtc)</p>
</div>
