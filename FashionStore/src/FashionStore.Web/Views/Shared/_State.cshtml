@model FashionStore.Application.DTOs.StateViewModel

@{
    var icons = new Dictionary<string, string>
    {
        ["empty"] = "M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0zM9 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm6 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-7 4h8m-9 0v0a3 3 0 0 1 1.5-2.6M12 12v4",
        ["loading"] = "M12 3a9 9 0 1 0 9 9",
        ["not-found"] = "M9 9l6 6m0-6l-6 6M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
        ["access-denied"] = "M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2zm10-10V7a4 4 0 0 0-8 0v4h8z",
        ["error"] = "M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z",
        ["offline"] = "M3 3l18 18M7 10a5 5 0 0 0 5 5m5-4a3 3 0 0 1 1.7 5.4M8 3.4A7 7 0 0 1 21 10c0 1.5-.4 2.8-1.2 4M12 19h.01M2 10a7 7 0 0 1 .6-2.8"
    };
    var state = string.IsNullOrEmpty(Model.Type) ? "empty" : Model.Type;
}

<div class="flex flex-col items-center justify-center text-center px-6 py-16">
    <div class="mb-5">
        <svg class="w-16 h-16 mx-auto @(state == "loading" ? "animate-spin" : "") text-gray-300"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
             role="img" aria-label="@Model.Title">
            <path stroke-linecap="round" stroke-linejoin="round" d="@(icons.TryGetValue(state, out var d) ? d : icons["empty"])" />
        </svg>
    </div>

    <h2 class="text-xl font-semibold text-gray-900 mb-2">@Model.Title</h2>
    <p class="text-sm text-gray-500 max-w-sm mb-2">@Model.Message</p>

    @if (!string.IsNullOrWhiteSpace(Model.Details))
    {
        <div class="w-full max-w-md mt-2 mb-4 text-left">
            <pre class="text-xs bg-gray-50 border border-gray-200 rounded-lg p-4 text-gray-600 overflow-x-auto">@Model.Details</pre>
        </div>
    }

    @if (Model.PrimaryAction is not null || Model.SecondaryAction is not null)
    {
        <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
            @if (Model.PrimaryAction is not null)
            {
                <a href="@Model.PrimaryAction.Url"
                   class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-brand-primary text-white text-sm font-medium hover:opacity-90 transition-opacity">
                    @Model.PrimaryAction.Label
                </a>
            }
            @if (Model.SecondaryAction is not null)
            {
                <a href="@Model.SecondaryAction.Url"
                   class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors">
                    @Model.SecondaryAction.Label
                </a>
            }
        </div>
    }
</div>
