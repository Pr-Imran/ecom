@{
    var variant = ViewData["variant"] as string ?? "info";
    var title = ViewData["title"] as string ?? "";
    var classes = variant switch
    {
        "success" => "alert-success",
        "warning" => "alert-warning",
        "danger" => "alert-danger",
        _ => "alert-info"
    };
}
<div class="@classes @ViewData["class"]" role="alert">
    <div class="flex-1">
        @if (!string.IsNullOrEmpty(title))
        {
            <p class="font-medium">@title</p>
        }
        <p class="text-sm">@RenderBody()</p>
    </div>
    <button class="btn-icon ml-auto flex-shrink-0" onclick="this.parentElement.remove()" aria-label="Dismiss">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
</div>
