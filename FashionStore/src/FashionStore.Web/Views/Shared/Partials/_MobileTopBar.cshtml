@model FashionStore.Application.DTOs.Navigation.HeaderViewModel

<div class="lg:hidden sticky top-0 z-50 bg-white border-b">
    <div class="flex items-center justify-between px-4 py-3">
        @* Page Title / Logo *@
        <div class="flex items-center gap-3">
            <a href="/" class="text-xl font-bold text-brand-primary">
                FashionStore
            </a>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2">
            @* Search Action *@
            <button type="button" data-mobile-search-toggle class="p-2 text-gray-600 hover:text-brand-primary">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </button>

            @* Cart Action *@
            <a href="/cart" class="p-2 text-gray-600 hover:text-brand-primary relative">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                @if (Model?.CartItemCount > 0)
                {
                    <span class="absolute top-1 right-1 bg-brand-accent text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center">
                        @Model.CartItemCount
                    </span>
                }
            </a>

            @* User Menu (if authenticated) *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/account" class="p-2 text-gray-600 hover:text-brand-primary">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </a>
            }
            else
            {
                <a href="/account/login" class="p-2 text-brand-primary font-medium text-sm">Sign In</a>
            }
        </div>
    </div>
</div>

@* Mobile Search Overlay *@
<div id="mobile-search-overlay" class="lg:hidden fixed inset-0 bg-white z-50 hidden">
    <div class="flex items-center border-b p-4">
        <button data-close-mobile-search class="p-2 -ml-2 text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </button>
        <form action="/search" method="GET" class="flex-1 ml-2">
            <input type="text"
                   name="q"
                   placeholder="Search products..."
                   class="w-full px-4 py-2 bg-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-primary"
                   autofocus
                   autocomplete="off" />
        </form>
    </div>
    <div class="p-4">
        <div class="text-sm text-gray-500 mb-3">Popular Searches</div>
        <div class="flex flex-wrap gap-2">
            <a href="/search?q=dresses" class="px-3 py-1.5 bg-gray-100 rounded-full text-sm hover:bg-gray-200">Dresses</a>
            <a href="/search?q=shoes" class="px-3 py-1.5 bg-gray-100 rounded-full text-sm hover:bg-gray-200">Shoes</a>
            <a href="/search?q=jeans" class="px-3 py-1.5 bg-gray-100 rounded-full text-sm hover:bg-gray-200">Jeans</a>
            <a href="/search?q=bags" class="px-3 py-1.5 bg-gray-100 rounded-full text-sm hover:bg-gray-200">Bags</a>
            <a href="/search?q=accessories" class="px-3 py-1.5 bg-gray-100 rounded-full text-sm hover:bg-gray-200">Accessories</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchToggle = document.querySelector('[data-mobile-search-toggle]');
        const closeSearch = document.querySelector('[data-close-mobile-search]');
        const overlay = document.getElementById('mobile-search-overlay');

        searchToggle?.addEventListener('click', () => overlay.classList.remove('hidden'));
        closeSearch?.addEventListener('click', () => overlay.classList.add('hidden'));
    });
</script>
