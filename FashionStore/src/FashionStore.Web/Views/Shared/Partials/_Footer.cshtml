@{
    var showNewsletter = ViewData["ShowNewsletter"] as bool? ?? true;
}

<footer class="bg-gray-900 text-white mt-auto">
    @* Newsletter Section *@
    @if (showNewsletter)
    {
        <div class="border-b border-gray-800">
            <div class="container mx-auto px-4 py-8">
                <div class="max-w-2xl mx-auto text-center">
                    <h3 class="text-xl font-bold mb-2">Subscribe to Our Newsletter</h3>
                    <p class="text-gray-400 mb-4">Get the latest fashion trends and exclusive offers delivered to your inbox.</p>
                    <form class="flex flex-col sm:flex-row gap-3">
                        <input type="email"
                               placeholder="Enter your email"
                               class="flex-1 px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-primary"
                               required />
                        <button type="submit" class="px-6 py-3 bg-brand-primary text-white font-medium rounded-lg hover:bg-brand-primary/90 transition-colors whitespace-nowrap">
                            Subscribe
                        </button>
                    </form>
                    <p class="text-xs text-gray-500 mt-2">By subscribing, you agree to our Privacy Policy. Unsubscribe anytime.</p>
                </div>
            </div>
        </div>
    }

    @* Footer Links *@
    <div class="py-12">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8">
                <div class="col-span-2 lg:col-span-1">
                    <div class="text-xl font-bold mb-4">FashionStore</div>
                    <p class="text-gray-400 text-sm mb-4">Your destination for the latest fashion trends.</p>
                    <div class="flex gap-4">
                        <a href="#" class="text-gray-400 hover:text-white transition-colors">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition-colors">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition-colors">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        </a>
                    </div>
                </div>

                <div>
                    <h4 class="font-bold mb-4">Shop</h4>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="/products" class="hover:text-white transition-colors">All Products</a></li>
                        <li><a href="/new-arrivals" class="hover:text-white transition-colors">New Arrivals</a></li>
                        <li><a href="/sale" class="hover:text-white transition-colors">Sale</a></li>
                        <li><a href="/clothing" class="hover:text-white transition-colors">Clothing</a></li>
                        <li><a href="/shoes" class="hover:text-white transition-colors">Shoes</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="font-bold mb-4">Help</h4>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="/shipping" class="hover:text-white transition-colors">Shipping Info</a></li>
                        <li><a href="/returns" class="hover:text-white transition-colors">Returns & Exchanges</a></li>
                        <li><a href="/faq" class="hover:text-white transition-colors">FAQ</a></li>
                        <li><a href="/size-guide" class="hover:text-white transition-colors">Size Guide</a></li>
                        <li><a href="/contact" class="hover:text-white transition-colors">Contact Us</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="font-bold mb-4">Company</h4>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
                        <li><a href="/careers" class="hover:text-white transition-colors">Careers</a></li>
                        <li><a href="/press" class="hover:text-white transition-colors">Press</a></li>
                        <li><a href="/sustainability" class="hover:text-white transition-colors">Sustainability</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="font-bold mb-4">Customer Service</h4>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="mailto:support@fashionstore.com" class="hover:text-white transition-colors">support@fashionstore.com</a></li>
                        <li><a href="tel:+1234567890" class="hover:text-white transition-colors">+1 (234) 567-890</a></li>
                        <li class="text-gray-500">Mon-Fri: 9AM - 6PM EST</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @* Bottom Bar *@
    <div class="border-t border-gray-800 py-6">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-400">
                <div class="flex flex-wrap gap-4">
                    <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
                    <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
                    <a href="/cookie-policy" class="hover:text-white transition-colors">Cookie Policy</a>
                    <a href="/accessibility" class="hover:text-white transition-colors">Accessibility</a>
                </div>
                <div class="flex items-center gap-4">
                    <span>&copy; @DateTime.UtcNow.Year FashionStore. All rights reserved.</span>
                </div>
            </div>
        </div>
    </div>
</footer>

@* Cookie Consent *@
<div id="cookie-consent" class="fixed bottom-0 left-0 right-0 bg-white border-t shadow-lg z-50 hidden">
    <div class="container mx-auto px-4 py-4">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <p class="text-sm text-gray-600 text-center md:text-left">
                We use cookies to enhance your experience. By continuing to browse, you agree to our 
                <a href="/cookie-policy" class="text-brand-primary hover:underline">Cookie Policy</a>.
            </p>
            <div class="flex gap-3">
                <button id="cookie-decline" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-100">
                    Decline
                </button>
                <button id="cookie-accept" class="px-4 py-2 text-sm bg-brand-primary text-white rounded-lg hover:bg-brand-primary/90">
                    Accept
                </button>
            </div>
        </div>
    </div>
</div>
