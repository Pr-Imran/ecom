<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] - FashionStore</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-gray-50">
    <header class="bg-white border-b">
        <div class="container mx-auto px-4 py-4 flex items-center justify-between">
            <h1 class="text-xl font-bold">My Account</h1>
            <a href="/" class="text-sm text-gray-600 hover:text-brand-primary">← Continue Shopping</a>
        </div>
    </header>
    <div class="flex-1 container mx-auto px-4 py-6">
        <div class="flex flex-col lg:flex-row gap-6">
            <aside class="lg:w-64 flex-shrink-0">
                <nav class="bg-white rounded-lg shadow-sm border p-4">
                    <ul class="space-y-1">
                        @foreach (var item in (ViewData["AccountNav"] as IEnumerable<FashionStore.Application.DTOs.Navigation.NavigationItem> ?? Enumerable.Empty<FashionStore.Application.DTOs.Navigation.NavigationItem>()))
                        {
                            var isActive = Context.Request.Path.StartsWithSegments(item.Url);
                            <li>
                                <a href="@item.Url" class="block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(isActive ? "bg-brand-primary text-white" : "text-gray-700 hover:bg-gray-100")">
                                    @item.Label
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </aside>
            <main class="flex-1">
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
