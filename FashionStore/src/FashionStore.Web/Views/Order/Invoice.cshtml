@model FashionStore.Web.Models.InvoiceViewModel
@{
    ViewData["Title"] = "Invoice " + Model.Invoice.InvoiceNumber;
    ViewData["HideMobileHeader"] = true;
    var accessToken = Model.GuestAccessToken;
    var publicOrderNumber = Model.Invoice.PublicOrderNumber;
}

@section Styles {
    <style>
        .invoice-appbar { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,0.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-brand-border, #e5e7eb); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .invoice-sheet { border: 1px solid var(--color-brand-border, #e5e7eb); border-radius: 14px; background: #fff; overflow: hidden; }
        .invoice-sticky-actions { position: sticky; bottom: 0; z-index: 20; background: rgba(255,255,255,0.94); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-top: 1px solid var(--color-brand-border, #e5e7eb); }
        @@media print {
            .invoice-appbar, .invoice-sticky-actions, .invoice-actions-row, .invoice-back-link { display: none !important; }
            .invoice-sheet { border: 0; border-radius: 0; }
            body { background: #fff; }
        }
    </style>
}

<!-- App-like header -->
<header class="invoice-appbar lg:hidden" role="banner">
    <div class="flex items-center justify-between gap-2 px-3 py-2">
        <div class="flex items-center gap-1 min-w-0">
            <a href="/orders/@publicOrderNumber@(string.IsNullOrWhiteSpace(accessToken) ? "" : "?t=" + Uri.EscapeDataString(accessToken))" class="btn-icon -ml-2 flex-shrink-0" aria-label="Go back to order">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </a>
            <span class="text-base font-bold text-brand-text-primary truncate">Invoice @Model.Invoice.InvoiceNumber</span>
        </div>
        <span class="w-8"></span>
    </div>
</header>

<!-- Desktop heading + actions -->
<div class="hidden lg:block container mx-auto px-4 pt-6 invoice-actions-row">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-brand-text-primary">Invoice @Model.Invoice.InvoiceNumber</h1>
        <div class="flex gap-2">
            <a href="/orders/@publicOrderNumber/pdf@(string.IsNullOrWhiteSpace(accessToken) ? "" : "?t=" + Uri.EscapeDataString(accessToken))"
               class="btn-primary px-4 py-2 text-sm">Download PDF</a>
            <button type="button" onclick="window.print()" class="btn-secondary px-4 py-2 text-sm">Print</button>
        </div>
    </div>
</div>

<div class="container mx-auto px-4 pt-4 pb-4 max-w-3xl lg:pt-6 invoice-back-link">
    <a href="/orders/@publicOrderNumber@(string.IsNullOrWhiteSpace(accessToken) ? "" : "?t=" + Uri.EscapeDataString(accessToken))"
       class="text-sm text-brand-text-muted hover:text-brand-primary">
        ← Back to order
    </a>
</div>

<div class="container mx-auto px-4 pb-10 safe-bottom max-w-3xl">
    <div class="invoice-sheet">
        <partial name="_InvoiceBody" model="Model" />
    </div>
</div>

<!-- Sticky Download + Print actions (mobile) -->
<div class="invoice-sticky-actions lg:hidden safe-bottom">
    <div class="grid grid-cols-2 gap-3 px-4 py-3">
        <a href="/orders/@publicOrderNumber/pdf@(string.IsNullOrWhiteSpace(accessToken) ? "" : "?t=" + Uri.EscapeDataString(accessToken))"
           class="btn-primary py-3 text-center text-sm">Download PDF</a>
        <button type="button" onclick="window.print()" class="btn-secondary py-3 text-sm">Print</button>
    </div>
</div>
