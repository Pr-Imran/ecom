@{
    ViewData["Title"] = "Track Your Order";
    ViewData["HideMobileHeader"] = true;
    var error = ViewData["LookupError"] as string;
    var orderNumber = ViewData["LookupOrderNumber"] as string;
    var email = ViewData["LookupEmail"] as string;
}

@section Styles {
    <style>
        .track-appbar { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,0.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-brand-border, #e5e7eb); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
    </style>
}

<!-- App-like header -->
<header class="track-appbar lg:hidden" role="banner">
    <div class="flex items-center justify-between gap-2 px-3 py-2">
        <div class="flex items-center gap-1">
            <button type="button" class="btn-icon -ml-2" onclick="history.back()" aria-label="Go back">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <span class="text-base font-bold text-brand-text-primary">Track Your Order</span>
        </div>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-bold text-brand-primary tracking-tight">
            FashionStore
        </a>
    </div>
</header>

<!-- Desktop heading -->
<div class="hidden lg:block container mx-auto px-4 pt-6">
    <h1 class="text-2xl font-bold text-brand-text-primary">Track Your Order</h1>
</div>

<div class="container mx-auto px-4 pt-4 pb-10 safe-bottom max-w-lg lg:pt-6">
    <div class="rounded-brand-sm border border-brand-border bg-white p-5">
        <div class="text-brand-text-muted mb-4">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
        </div>
        <h2 class="text-base font-bold text-brand-text-primary">Find your order</h2>
        <p class="text-sm text-brand-text-muted mt-1">
            Enter your order number and the email address you used at checkout to view your order status and details.
        </p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert-danger mt-4" role="alert"><p class="text-sm">@error</p></div>
        }

        <form method="post" asp-action="Track" class="mt-5 space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label for="publicOrderNumber" class="block text-xs font-semibold text-brand-text-primary mb-1">Order number</label>
                <input id="publicOrderNumber"
                       name="publicOrderNumber"
                       type="text"
                       value="@orderNumber"
                       placeholder="e.g. ORD-2025-000123"
                       required
                       class="w-full rounded-brand-sm border border-brand-border bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/40"
                       autocomplete="off" />
            </div>
            <div>
                <label for="email" class="block text-xs font-semibold text-brand-text-primary mb-1">Email used at checkout</label>
                <input id="email"
                       name="email"
                       type="email"
                       value="@email"
                       placeholder="you@example.com"
                       required
                       class="w-full rounded-brand-sm border border-brand-border bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/40"
                       autocomplete="email" />
            </div>
            <button type="submit" class="btn-primary w-full py-3 text-center">View my order</button>
        </form>

        <p class="mt-4 text-xs text-brand-text-muted">
            Placed an order as a signed-in customer?
            <a asp-controller="Order" asp-action="Index" class="text-brand-primary font-medium hover:underline">Go to My Orders</a>.
        </p>
    </div>
</div>
