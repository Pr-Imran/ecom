@model FashionStore.Application.DTOs.Orders.CustomerOrderListResultDto
@using FashionStore.Domain.Enums
@{
    ViewData["Title"] = "My Orders";
    ViewData["HideMobileHeader"] = true;
    var appliedStatus = Model.AppliedStatus;
    var search = Model.AppliedSearch;
}

@section Styles {
    <style>
        .order-appbar { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,0.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-brand-border, #e5e7eb); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .order-card { border: 1px solid var(--color-brand-border, #e5e7eb); border-radius: 14px; background: #fff; overflow: hidden; }
        .order-thumb { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; background: var(--color-brand-surface, #f9fafb); flex-shrink: 0; }
        .status-pill { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.125rem 0.625rem; border-radius: 999px; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; }
        .status-placed { background: #FEF3C7; color: #92400E; }
        .status-confirmed { background: #DBEAFE; color: #1E40AF; }
        .status-processing { background: #E0E7FF; color: #3730A3; }
        .status-shipped { background: #EDE9FE; color: #5B21B6; }
        .status-delivered { background: #DCFCE7; color: #166534; }
        .status-completed { background: #DCFCE7; color: #166534; }
        .status-cancelled { background: #FEE2E2; color: #991B1B; }
        .filter-chip { padding: 0.375rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; border: 1px solid var(--color-brand-border, #e5e7eb); background: #fff; color: #4B5563; }
        .filter-chip.active { background: var(--color-brand-primary, #8B4513); border-color: var(--color-brand-primary, #8B4513); color: #fff; }
    </style>
}

<!-- App-like header -->
<header class="order-appbar lg:hidden" role="banner">
    <div class="flex items-center justify-between gap-2 px-3 py-2">
        <div class="flex items-center gap-1">
            <button type="button" class="btn-icon -ml-2" onclick="history.back()" aria-label="Go back">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <span class="text-base font-bold text-brand-text-primary">My Orders</span>
            @if (Model.TotalCount > 0)
            {
                <span class="text-sm text-brand-text-muted">(@Model.TotalCount)</span>
            }
        </div>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-bold text-brand-primary tracking-tight">
            FashionStore
        </a>
    </div>
</header>

<!-- Desktop heading -->
<div class="hidden lg:block container mx-auto px-4 pt-6">
    <h1 class="text-2xl font-bold text-brand-text-primary">My Orders</h1>
</div>

<div class="container mx-auto px-4 pt-3 pb-10 safe-bottom lg:pt-6">
    <!-- Search -->
    <form method="get" asp-action="Index" class="flex items-center gap-2">
        <div class="relative flex-1">
            <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-brand-text-muted">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </span>
            <input type="search"
                   name="search"
                   value="@search"
                   placeholder="Search by order number or product"
                   class="w-full rounded-full border border-brand-border bg-white pl-9 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/40"
                   aria-label="Search orders" />
        </div>
        <input type="hidden" name="status" value="@(appliedStatus?.ToString())" />
        <button type="submit" class="btn-primary rounded-full px-5 py-2.5 text-sm">Search</button>
    </form>

    <!-- Status filter -->
    <div class="flex gap-2 mt-3 overflow-x-auto scrollbar-hide -mx-4 px-4">
        <a href="@Url.Action("Index", new { search, status = (OrderStatus?)null })" class="filter-chip @(appliedStatus is null ? "active" : "")">All</a>
        @foreach (var status in new[]
        {
            OrderStatus.Placed,
            OrderStatus.Confirmed,
            OrderStatus.Processing,
            OrderStatus.Shipped,
            OrderStatus.Delivered,
            OrderStatus.Cancelled
        })
        {
            <a href="@Url.Action("Index", new { search, status })" class="filter-chip @(appliedStatus == status ? "active" : "")">
                @switch (status)
                {
                    case OrderStatus.Placed: <text>Placed</text>; break;
                    case OrderStatus.Confirmed: <text>Confirmed</text>; break;
                    case OrderStatus.Processing: <text>Processing</text>; break;
                    case OrderStatus.Shipped: <text>Shipped</text>; break;
                    case OrderStatus.Delivered: <text>Delivered</text>; break;
                    case OrderStatus.Cancelled: <text>Cancelled</text>; break;
                    default: <text>@status</text>; break;
                }
            </a>
        }
    </div>

    @if (TempData["OrderMessage"] != null)
    {
        <div class="alert-success mt-4" role="alert"><p class="text-sm">@TempData["OrderMessage"]</p></div>
    }
    @if (TempData["OrderError"] != null)
    {
        <div class="alert-danger mt-4" role="alert"><p class="text-sm">@TempData["OrderError"]</p></div>
    }

    @if (Model.Items.Count == 0)
    {
        <!-- Native empty state -->
        <div class="text-center py-16">
            <div class="mx-auto mb-4 w-20 h-20 text-brand-text-muted">
                <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                </svg>
            </div>
            <h2 class="text-lg font-bold text-brand-text-primary">
                @if (!string.IsNullOrEmpty(search) || appliedStatus.HasValue)
                {
                    <text>No orders found</text>
                }
                else
                {
                    <text>No orders yet</text>
                }
            </h2>
            <p class="text-sm text-brand-text-muted mt-2 max-w-sm mx-auto">
                @if (!string.IsNullOrEmpty(search) || appliedStatus.HasValue)
                {
                    <text>Try a different search term or status filter.</text>
                }
                else
                {
                    <text>When you place an order it will show up here so you can track it.</text>
                }
            </p>
            @if (string.IsNullOrEmpty(search) && !appliedStatus.HasValue)
            {
                <a asp-controller="Home" asp-action="Index" class="btn-primary mt-6 px-6 py-3 text-center">Start shopping</a>
            }
        </div>
    }
    else
    {
        <!-- Order cards -->
        <ul class="mt-4 space-y-4">
            @foreach (var order in Model.Items)
            {
                <li>
                    <a asp-action="Details" asp-route-publicOrderNumber="@order.PublicOrderNumber" class="order-card block hover:border-brand-primary transition-colors">
                        <div class="px-4 pt-3 pb-2 flex items-center justify-between gap-2">
                            <span class="text-xs font-bold text-brand-text-primary">@order.PublicOrderNumber</span>
                            <span class="status-pill status-@order.OrderStatus.ToLowerInvariant()">@order.OrderStatus</span>
                        </div>
                        <div class="px-4 pb-2 flex items-center gap-3">
                            @if (!string.IsNullOrEmpty(order.ThumbnailUrl))
                            {
                                <img src="@order.ThumbnailUrl" alt="@order.FirstItemName" class="order-thumb" loading="lazy" />
                            }
                            else
                            {
                                <div class="order-thumb flex items-center justify-center text-brand-text-muted">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                                    </svg>
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-brand-text-primary truncate">@order.FirstItemName</p>
                                <p class="text-xs text-brand-text-muted">@order.ItemCount item(s)</p>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <p class="text-sm font-bold text-brand-text-primary">$@order.GrandTotal.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</p>
                                <p class="text-[11px] text-brand-text-muted">@order.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</p>
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>

        <!-- Pagination -->
        @if (Model.HasMore || Model.Page > 1)
        {
            var totalPages = Math.Max(1, (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize));
            <nav class="mt-6 flex items-center justify-between" aria-label="Pagination">
                @if (Model.Page > 1)
                {
                    <a href="@Url.Action("Index", new { search, status = appliedStatus, page = Model.Page - 1, pageSize = Model.PageSize })" class="btn-icon text-brand-text-primary" aria-label="Previous page">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </a>
                }
                else
                {
                    <span></span>
                }
                <span class="text-xs text-brand-text-muted">Page @Model.Page of @totalPages</span>
                @if (Model.HasMore)
                {
                    <a href="@Url.Action("Index", new { search, status = appliedStatus, page = Model.Page + 1, pageSize = Model.PageSize })" class="btn-icon text-brand-text-primary" aria-label="Next page">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                }
                else
                {
                    <span></span>
                }
            </nav>
        }
    }
</div>
