@model FashionStore.Application.DTOs.Products.CartViewData
@{
    var availableCount = Model.Items.Count(i => i.IsAvailable);
    var hasCheckoutItems = availableCount > 0;
    var pricing = Model.Pricing;
    var hasPromotions = pricing != null && pricing.PromotionsDiscount > 0;
    var hasCoupon = pricing != null && pricing.CouponApplied;
    var total = pricing?.Total ?? Model.Subtotal;
}

<div class="rounded-brand-sm bg-white border border-brand-border p-4 sm:p-5">
    <h2 class="text-base font-bold text-brand-text-primary">Order Summary</h2>

    @if (Model.HasUnavailableItems)
    {
        <div class="mt-3 flex items-start gap-2 rounded-brand-sm bg-brand-surface border border-brand-danger px-3 py-2" role="alert">
            <svg class="w-4 h-4 text-brand-danger flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
            <p class="text-xs text-brand-text-muted">Unavailable items are shown but excluded from your subtotal.</p>
        </div>
    }

    <div class="mt-4 flex items-center justify-between text-sm">
        <span class="text-brand-text-muted">Subtotal (@availableCount item(s))</span>
        <span class="font-semibold text-brand-text-primary" data-cart-subtotal>@Model.FormattedSubtotal</span>
    </div>

    @if (hasPromotions || hasCoupon)
    {
        <div class="mt-3 space-y-2" data-cart-breakdown>
            @if (pricing != null)
            {
                foreach (var item in pricing.Breakdown)
                {
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-brand-text-muted">@item.Label</span>
                        <span class="font-medium text-brand-success">-$@item.Amount.ToString("N2")</span>
                    </div>
                }

                @if (pricing.IsFreeShipping)
                {
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-brand-text-muted">Free shipping</span>
                        <span class="font-medium text-brand-success">-$0.00</span>
                    </div>
                }
            }
        </div>
    }

    @if (hasCoupon && pricing != null)
    {
        <div class="mt-4 rounded-brand-sm bg-brand-surface border border-brand-border px-3 py-2 flex items-center justify-between gap-2" data-cart-coupon-applied>
            <div class="flex items-center gap-2 min-w-0">
                <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                </svg>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-brand-text-primary truncate">@pricing.AppliedCouponCode</p>
                    <p class="text-xs text-brand-text-muted">Coupon applied</p>
                </div>
            </div>
            <button type="button" class="text-xs font-medium text-brand-danger flex-shrink-0" data-cart-coupon-remove>Remove</button>
        </div>
    }
    else if (!hasCoupon)
    {
        <div class="mt-4 border-t border-brand-border pt-4">
            <div class="flex items-center justify-between text-sm">
                <span class="text-brand-text-muted">Coupon code</span>
                <button type="button" class="text-sm font-medium text-brand-primary" data-cart-coupon-toggle>Apply coupon</button>
            </div>
            <form class="hidden mt-3" data-cart-coupon-form onsubmit="return false;">
                <div class="flex gap-2">
                    <input type="text"
                           name="coupon"
                           class="flex-1 min-w-0 px-3 py-2 bg-brand-surface rounded-brand-sm border border-brand-border text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary"
                           placeholder="Enter coupon code"
                           aria-label="Coupon code"
                           data-cart-coupon-input />
                    <button type="button" class="btn-primary py-2 px-4 text-sm" data-cart-coupon-apply>Apply</button>
                </div>
                <p class="mt-2 text-xs text-brand-text-muted" data-cart-coupon-message></p>
            </form>
        </div>
    }

    @if (pricing != null && !string.IsNullOrEmpty(pricing.CouponMessage) && !pricing.CouponApplied)
    {
        <p class="mt-3 text-xs text-brand-danger" data-cart-coupon-message-static role="alert">@pricing.CouponMessage</p>
    }

    <div class="mt-3 flex items-center justify-between text-sm">
        <span class="text-brand-text-muted">Shipping</span>
        <span class="text-brand-text-muted">@(pricing != null && pricing.IsFreeShipping ? "Free" : "Calculated at checkout")</span>
    </div>

    <div class="mt-4 flex items-center justify-between border-t border-brand-border pt-4">
        <span class="text-sm font-semibold text-brand-text-primary">Total</span>
        <span class="text-lg font-bold text-brand-text-primary" data-cart-total>$@total.ToString("N2")</span>
    </div>

    <button type="button"
            class="btn-primary w-full mt-4 py-3.5 text-base"
            data-cart-checkout
            @(hasCheckoutItems ? "" : "disabled")
            aria-disabled="@(hasCheckoutItems ? "false" : "true")">
        Proceed to Checkout
    </button>

    @if (!hasCheckoutItems)
    {
        <p class="mt-2 text-xs text-brand-text-muted text-center">Add available items to your cart to check out.</p>
    }
</div>
