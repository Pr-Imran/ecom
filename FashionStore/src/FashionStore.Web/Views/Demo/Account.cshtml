@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Demo - Account Layout";
}

<div class="bg-white rounded-lg shadow-sm border p-6">
    <h2 class="text-2xl font-bold mb-4">Customer Account Layout Demo</h2>
    
    <div class="prose max-w-none">
        <p class="text-gray-600 mb-6">
            This page demonstrates the customer account layout. Note how on desktop you have a sidebar navigation,
            while on mobile you have card-based navigation menu and bottom navigation.
        </p>

        <div class="grid md:grid-cols-2 gap-4 mb-6">
            <div class="border rounded-lg p-4">
                <h4 class="font-bold mb-2">Desktop Features:</h4>
                <ul class="space-y-2 text-sm text-gray-600">
                    <li>• Sticky sidebar navigation</li>
                    <li>• Account header with user info</li>
                    <li>• Breadcrumb navigation</li>
                    <li>• Logout action in header</li>
                </ul>
            </div>
            <div class="border rounded-lg p-4">
                <h4 class="font-bold mb-2">Mobile Features:</h4>
                <ul class="space-y-2 text-sm text-gray-600">
                    <li>• Profile card with avatar</li>
                    <li>• Horizontal scrollable menu cards</li>
                    <li>• Fixed bottom navigation</li>
                    <li>• Safe-area spacing</li>
                </ul>
            </div>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-sm text-blue-800">
                <strong>Tip:</strong> Resize your browser or use browser DevTools device emulation to see mobile layout.
            </p>
        </div>
    </div>
</div>
