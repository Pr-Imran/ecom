@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories";
    ViewData["PageTitle"] = "Categories";
}

<div class="space-y-4">
    @* Mobile Search & Filter *@
    <div class="lg:hidden">
        <div class="relative">
            <input type="text" id="mobileSearch" placeholder="Search categories..." 
                   class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
            <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </div>
    </div>

    @* Desktop Toolbar *@
    <div class="hidden lg:flex items-center justify-between gap-4">
        <div class="flex-1 max-w-md">
            <input type="text" id="desktopSearch" placeholder="Search categories..." 
                   class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
        </div>
        <div class="flex items-center gap-2">
            <label class="text-sm text-gray-600">Show:</label>
            <select id="filterStatus" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary">
                <option value="active">Active Only</option>
                <option value="all">All</option>
            </select>
            <button id="btnAdd" class="px-4 py-2 bg-brand-primary text-white rounded-lg hover:bg-brand-primary/90 text-sm font-medium">
                + Add Category
            </button>
        </div>
    </div>

    @* Categories List - Desktop Table *@
    <div class="hidden lg:block bg-white rounded-lg shadow-sm border overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50 border-b">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Parent</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Menu</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody id="categoriesTableBody" class="divide-y divide-gray-200">
                <tr>
                    <td colspan="7" class="px-6 py-8 text-center text-gray-500 text-sm">
                        <svg class="w-8 h-8 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                        </svg>
                        <p>No categories yet. Click "Add Category" to create one.</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @* Categories List - Mobile Cards *@
    <div id="categoriesCards" class="lg:hidden space-y-3 pb-24">
        <div class="bg-white rounded-lg border p-4 text-center text-gray-500 text-sm py-8">
            <p>No categories yet. Tap the + button to create one.</p>
        </div>
    </div>
</div>

@* Floating Add Button (Mobile) *@
<button id="btnAddMobile" class="lg:hidden fixed bottom-20 right-4 w-14 h-14 bg-brand-primary text-white rounded-full shadow-lg flex items-center justify-center hover:bg-brand-primary/90 z-30">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
    </svg>
</button>

@* Category Form Modal *@
<div id="categoryModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-white rounded-t-2xl sm:rounded-2xl w-full sm:max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="sticky top-0 bg-white border-b px-6 py-4 flex items-center justify-between rounded-t-2xl">
            <h3 id="modalTitle" class="text-lg font-bold">Add Category</h3>
            <button class="btn-close-modal text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form id="categoryForm" class="p-6 space-y-4">
            <input type="hidden" id="categoryId" />
            
            <div>
                <label for="categoryName" class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
                <input type="text" id="categoryName" required maxlength="200"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
            </div>

            <div>
                <label for="categorySlug" class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
                <input type="text" id="categorySlug" maxlength="200" readonly
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 bg-gray-50 text-gray-600 text-sm" />
                <p class="text-xs text-gray-500 mt-1">Auto-generated from name</p>
            </div>

            <div>
                <label for="categoryDescription" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea id="categoryDescription" maxlength="2000" rows="3"
                          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"></textarea>
            </div>

            <div>
                <label for="categoryParent" class="block text-sm font-medium text-gray-700 mb-1">Parent Category</label>
                <select id="categoryParent" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm">
                    <option value="">None (Root Category)</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="categoryDisplayOrder" class="block text-sm font-medium text-gray-700 mb-1">Display Order</label>
                    <input type="number" id="categoryDisplayOrder" value="0" min="0"
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
                </div>
                <div>
                    <label for="categoryImageUrl" class="block text-sm font-medium text-gray-700 mb-1">Image URL</label>
                    <input type="url" id="categoryImageUrl" maxlength="500"
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
                </div>
            </div>

            <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="categoryIsActive" checked class="w-4 h-4 text-brand-primary border-gray-300 rounded focus:ring-brand-primary" />
                    <span class="text-sm text-gray-700">Active</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="categoryShowInMainMenu" class="w-4 h-4 text-brand-primary border-gray-300 rounded focus:ring-brand-primary" />
                    <span class="text-sm text-gray-700">Show in Main Menu</span>
                </label>
            </div>

            <div class="border-t pt-4 mt-4">
                <h4 class="text-sm font-medium text-gray-700 mb-3">SEO</h4>
                <div class="space-y-3">
                    <div>
                        <label for="categorySeoTitle" class="block text-xs text-gray-600 mb-1">SEO Title</label>
                        <input type="text" id="categorySeoTitle" maxlength="200"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label for="categorySeoDescription" class="block text-xs text-gray-600 mb-1">SEO Description</label>
                        <textarea id="categorySeoDescription" maxlength="2000" rows="2"
                                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm"></textarea>
                    </div>
                </div>
            </div>
        </form>
        <div class="sticky bottom-0 bg-white border-t px-6 py-4 flex items-center justify-end gap-3 rounded-b-2xl">
            <button type="button" class="btn-close-modal px-4 py-2 border border-gray-300 rounded-lg text-sm hover:bg-gray-50">Cancel</button>
            <button type="submit" form="categoryForm" class="px-6 py-2 bg-brand-primary text-white rounded-lg text-sm hover:bg-brand-primary/90 font-medium">Save Category</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let categories = [];
        let isEditing = false;

        // Auto-generate slug from name
        document.getElementById('categoryName').addEventListener('input', function() {
            const slug = this.value.toLowerCase()
                .replace(/ /g, '-')
                .replace(/--+/g, '-')
                .trim('-');
            document.getElementById('categorySlug').value = slug;
        });

        // Modal controls
        document.querySelectorAll('.btn-close-modal').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('categoryModal').classList.add('hidden');
            });
        });

        document.getElementById('btnAdd').addEventListener('click', openAddModal);
        document.getElementById('btnAddMobile').addEventListener('click', openAddModal);

        function openAddModal() {
            isEditing = false;
            document.getElementById('modalTitle').textContent = 'Add Category';
            document.getElementById('categoryForm').reset();
            document.getElementById('categoryId').value = '';
            document.getElementById('categoryModal').classList.remove('hidden');
        }

        // Load categories
        async function loadCategories() {
            const includeInactive = document.getElementById('filterStatus').value === 'all';
            const response = await fetch(`/api/admin/categories?includeInactive=${includeInactive}`);
            if (response.ok) {
                categories = await response.json();
                renderCategories();
                updateParentSelect();
            }
        }

        function renderCategories() {
            // Desktop table
            const tableBody = document.getElementById('categoriesTableBody');
            if (categories.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="7" class="px-6 py-8 text-center text-gray-500 text-sm">No categories found</td></tr>';
            } else {
                tableBody.innerHTML = categories.map(c => `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900">${c.name}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${c.slug}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${c.parentCategoryName || '-'}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${c.displayOrder}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium ${c.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                ${c.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${c.showInMainMenu ? 'Yes' : 'No'}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <button onclick="editCategory('${c.id}')" class="text-brand-primary hover:text-brand-primary/80 mr-3">Edit</button>
                            <button onclick="deleteCategory('${c.id}')" class="text-red-600 hover:text-red-700">Delete</button>
                        </td>
                    </tr>
                `).join('');
            }

            // Mobile cards
            const cardsContainer = document.getElementById('categoriesCards');
            if (categories.length === 0) {
                cardsContainer.innerHTML = '<div class="bg-white rounded-lg border p-4 text-center text-gray-500 text-sm py-8"><p>No categories yet.</p></div>';
            } else {
                cardsContainer.innerHTML = categories.map(c => `
                    <div class="bg-white rounded-lg border p-4">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex-1">
                                <h3 class="font-bold text-gray-900">${c.name}</h3>
                                <p class="text-xs text-gray-500 mt-1">${c.slug}</p>
                            </div>
                            <span class="px-2 py-1 rounded-full text-xs font-medium ${c.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                ${c.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </div>
                        <div class="text-xs text-gray-600 space-y-1 mb-3">
                            ${c.parentCategoryName ? `<div>Parent: ${c.parentCategoryName}</div>` : ''}
                            <div>Order: ${c.displayOrder} | Menu: ${c.showInMainMenu ? 'Yes' : 'No'}</div>
                        </div>
                        <div class="flex gap-2 pt-3 border-t">
                            <button onclick="editCategory('${c.id}')" class="flex-1 px-3 py-2 bg-brand-primary text-white rounded-lg text-sm">Edit</button>
                            <button onclick="deleteCategory('${c.id}')" class="px-3 py-2 border border-red-200 text-red-600 rounded-lg text-sm">Delete</button>
                        </div>
                    </div>
                `).join('');
            }
        }

        function updateParentSelect() {
            const select = document.getElementById('categoryParent');
            const options = ['<option value="">None (Root Category)</option>'];
            categories.filter(c => c.id !== document.getElementById('categoryId').value).forEach(c => {
                options.push(`<option value="${c.id}">${c.name}</option>`);
            });
            select.innerHTML = options.join('');
        }

        async function editCategory(id) {
            const category = categories.find(c => c.id === id);
            if (!category) return;

            isEditing = true;
            document.getElementById('modalTitle').textContent = 'Edit Category';
            document.getElementById('categoryId').value = category.id;
            document.getElementById('categoryName').value = category.name;
            document.getElementById('categorySlug').value = category.slug;
            document.getElementById('categoryDescription').value = category.description || '';
            document.getElementById('categoryParent').value = category.parentCategoryId || '';
            document.getElementById('categoryDisplayOrder').value = category.displayOrder;
            document.getElementById('categoryImageUrl').value = category.imageUrl || '';
            document.getElementById('categoryIsActive').checked = category.isActive;
            document.getElementById('categoryShowInMainMenu').checked = category.showInMainMenu;
            document.getElementById('categorySeoTitle').value = category.seoTitle || '';
            document.getElementById('categorySeoDescription').value = category.seoDescription || '';
            
            document.getElementById('categoryModal').classList.remove('hidden');
        }

        async function deleteCategory(id) {
            if (!confirm('Are you sure you want to delete this category?')) return;

            const response = await fetch(`/api/admin/categories/${id}`, { method: 'DELETE' });
            if (response.ok) {
                await loadCategories();
            } else {
                const error = await response.json();
                alert(error.error || 'Failed to delete category');
            }
        }

        // Form submission
        document.getElementById('categoryForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const data = {
                id: document.getElementById('categoryId').value || undefined,
                name: document.getElementById('categoryName').value,
                description: document.getElementById('categoryDescription').value,
                parentCategoryId: document.getElementById('categoryParent').value || null,
                displayOrder: parseInt(document.getElementById('categoryDisplayOrder').value),
                imageUrl: document.getElementById('categoryImageUrl').value || null,
                iconUrl: null,
                isActive: document.getElementById('categoryIsActive').checked,
                showInMainMenu: document.getElementById('categoryShowInMainMenu').checked,
                seoTitle: document.getElementById('categorySeoTitle').value || null,
                seoDescription: document.getElementById('categorySeoDescription').value || null
            };

            const url = isEditing ? `/api/admin/categories/${data.id}` : '/api/admin/categories';
            const method = isEditing ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                document.getElementById('categoryModal').classList.add('hidden');
                await loadCategories();
            } else {
                const error = await response.json();
                alert(error.error || 'Failed to save category');
            }
        });

        // Filter change
        document.getElementById('filterStatus').addEventListener('change', loadCategories);

        // Initial load
        loadCategories();
    </script>
}
