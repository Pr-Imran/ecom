@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pages";
    ViewData["PageTitle"] = "Pages";
}

<div class="space-y-4 pb-28">
    @* Header actions *@
    <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
        <div class="relative flex-1">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="search" id="pageSearch" placeholder="Search pages..."
                   class="w-full border border-gray-300 rounded-lg pl-10 pr-4 py-2.5 text-sm focus:ring-2 focus:ring-brand-primary focus:border-transparent" />
        </div>
        <button id="btnNewPage" class="px-4 py-2.5 bg-brand-primary text-white rounded-lg hover:bg-brand-primary/90 text-sm font-medium whitespace-nowrap">
            Add Page
        </button>
    </div>

    @* Status filter chips *@
    <div class="flex gap-2 overflow-x-auto pb-1">
        <button class="status-chip px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-brand-primary text-white" data-status="">All</button>
        @foreach (var status in new[] { "Published", "Draft", "Archived" })
        {
            <button class="status-chip px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap border border-gray-300 text-gray-600 hover:bg-gray-50" data-status="@status">@status</button>
        }
    </div>

    @* List (preview cards) *@
    <div id="pagesList" class="space-y-3">
        <div class="bg-white rounded-lg border p-6 text-center text-gray-500 text-sm">
            <p>Loading pages...</p>
        </div>
    </div>
</div>

@* Editor modal *@
<div id="pageModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/40" data-close-modal></div>
    <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center p-0 sm:p-6">
        <div class="bg-white w-full sm:max-w-2xl rounded-t-2xl sm:rounded-2xl shadow-xl max-h-[90vh] flex flex-col">
            <div class="flex items-center justify-between px-6 py-4 border-b">
                <h3 id="modalTitle" class="text-lg font-semibold text-gray-900">New Page</h3>
                <button class="btn-icon" data-close-modal aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="p-6 overflow-y-auto space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                        <input type="text" id="fTitle" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
                        <input type="text" id="fSlug" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary" />
                        <p class="text-xs text-gray-500 mt-1">Public URL: /pages/<span id="slugPreview"></span></p>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Summary</label>
                        <textarea id="fSummary" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <select id="fStatus" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white">
                            <option value="Draft">Draft</option>
                            <option value="Published">Published</option>
                            <option value="Archived">Archived</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Template</label>
                        <select id="fTemplate" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white">
                            <option value="Default">Default</option>
                            <option value="FullWidth">Full Width</option>
                        </select>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Content</label>
                        <textarea id="fBody" rows="8" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:ring-2 focus:ring-brand-primary" placeholder="<h2>Heading</h2><p>Body text...</p>"></textarea>
                        <p class="text-xs text-gray-500 mt-1">HTML is sanitized on save. Scripts and unsafe markup are stripped.</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Meta Title</label>
                        <input type="text" id="fMetaTitle" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Meta Description</label>
                        <input type="text" id="fMetaDesc" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
                    </div>
                </div>
            </div>
            <div class="flex items-center justify-between px-6 py-4 border-t">
                <span id="deletePageBtnWrap" class="hidden">
                    <button id="btnDeletePage" class="px-4 py-2 text-sm font-medium text-red-600 hover:text-red-700">Delete</button>
                </span>
                <div class="flex gap-2 ml-auto">
                    <button class="px-4 py-2 text-sm border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50" data-close-modal>Cancel</button>
                    <button id="btnSavePage" class="px-4 py-2 text-sm font-medium bg-brand-primary text-white rounded-lg hover:bg-brand-primary/90">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const statusColors = {
                Published: 'bg-emerald-50 text-emerald-700',
                Draft: 'bg-amber-50 text-amber-700',
                Archived: 'bg-gray-100 text-gray-600'
            };

            let editingId = null;

            function api(path, options) {
                return fetch(path, options).then(async res => {
                    if (res.ok) return res.json();
                    let error = 'Request failed';
                    try {
                        const body = await res.json();
                        error = body.error || body.title || error;
                    } catch (e) { /* ignore */ }
                    throw new Error(error);
                });
            }

            function esc(value) {
                if (value === null || value === undefined) return '';
                return String(value).replace(/[&<>"']/g, c => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[c]));
            }

            function badge(value) {
                return `<span class="inline-flex px-2 py-1 rounded-full text-xs font-medium ${statusColors[value] || 'bg-gray-100 text-gray-600'}">${esc(value)}</span>`;
            }

            async function loadPages() {
                const search = document.getElementById('pageSearch').value.trim();
                const status = document.querySelector('.status-chip.bg-brand-primary')?.dataset.status || '';
                const params = new URLSearchParams();
                if (search) params.set('search', search);
                params.set('page', 1);
                params.set('pageSize', 200);

                const data = await api('/api/admin/content/pages?' + params.toString());
                renderPages(data.items || [], data.totalCount || 0);
            }

            function renderPages(items, total) {
                const container = document.getElementById('pagesList');
                if (items.length === 0) {
                    container.innerHTML = `<div class="bg-white rounded-lg border p-6 text-center text-gray-500 text-sm"><p>No pages found.</p></div>`;
                    return;
                }

                container.innerHTML = items.map(page => `
                    <div class="bg-white rounded-lg border shadow-sm p-4 flex items-start gap-3 cursor-pointer hover:border-brand-primary/50 transition-colors" data-page-id="${page.id}">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-semibold text-gray-900 truncate">${esc(page.title)}</h3>
                                ${badge(page.status)}
                                ${page.isSystem ? '<span class="text-xs text-gray-400">System</span>' : ''}
                            </div>
                            <p class="text-sm text-gray-500 mt-0.5">/${esc(page.slug)}</p>
                            <p class="text-xs text-gray-400 mt-1">
                                ${page.publishedAtUtc ? 'Published ' + new Date(page.publishedAtUtc).toLocaleDateString() : 'Not published'} &middot; Updated ${page.updatedAtUtc ? new Date(page.updatedAtUtc).toLocaleDateString() : 'never'}
                            </p>
                        </div>
                        <svg class="w-4 h-4 text-gray-400 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                `).join('');

                container.querySelectorAll('[data-page-id]').forEach(el => {
                    el.addEventListener('click', () => openEditor(el.dataset.pageId));
                });
            }

            function openEditor(id) {
                editingId = id || null;
                document.getElementById('modalTitle').textContent = id ? 'Edit Page' : 'New Page';
                document.getElementById('deletePageBtnWrap').classList.toggle('hidden', !id);

                if (id) {
                    api('/api/admin/content/pages/' + id).then(page => {
                        document.getElementById('fTitle').value = page.title || '';
                        document.getElementById('fSlug').value = page.slug || '';
                        document.getElementById('slugPreview').textContent = page.slug || '';
                        document.getElementById('fSummary').value = page.summary || '';
                        document.getElementById('fBody').value = page.bodyHtml || '';
                        document.getElementById('fStatus').value = page.status || 'Draft';
                        document.getElementById('fTemplate').value = page.template || 'Default';
                        document.getElementById('fMetaTitle').value = page.metaTitle || '';
                        document.getElementById('fMetaDesc').value = page.metaDescription || '';
                        document.getElementById('pageModal').classList.remove('hidden');
                    }).catch(err => alert(err.message));
                } else {
                    document.getElementById('fTitle').value = '';
                    document.getElementById('fSlug').value = '';
                    document.getElementById('slugPreview').textContent = '';
                    document.getElementById('fSummary').value = '';
                    document.getElementById('fBody').value = '';
                    document.getElementById('fStatus').value = 'Draft';
                    document.getElementById('fTemplate').value = 'Default';
                    document.getElementById('fMetaTitle').value = '';
                    document.getElementById('fMetaDesc').value = '';
                    document.getElementById('pageModal').classList.remove('hidden');
                }
            }

            function payload() {
                return JSON.stringify({
                    title: document.getElementById('fTitle').value,
                    slug: document.getElementById('fSlug').value,
                    summary: document.getElementById('fSummary').value,
                    bodyHtml: document.getElementById('fBody').value,
                    template: document.getElementById('fTemplate').value,
                    status: document.getElementById('fStatus').value,
                    metaTitle: document.getElementById('fMetaTitle').value,
                    metaDescription: document.getElementById('fMetaDesc').value
                });
            }

            function bindModal() {
                const modal = document.getElementById('pageModal');
                modal.querySelectorAll('[data-close-modal]').forEach(el => el.addEventListener('click', () => modal.classList.add('hidden')));

                document.getElementById('btnSavePage').addEventListener('click', async () => {
                    const options = {
                        method: editingId ? 'PUT' : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: payload()
                    };
                    const path = editingId ? '/api/admin/content/pages/' + editingId : '/api/admin/content/pages';
                    try {
                        await api(path, options);
                        modal.classList.add('hidden');
                        await loadPages();
                    } catch (err) { alert(err.message); }
                });

                document.getElementById('btnDeletePage').addEventListener('click', async () => {
                    if (!editingId) return;
                    if (!confirm('Delete this page?')) return;
                    try {
                        await api('/api/admin/content/pages/' + editingId, { method: 'DELETE' });
                        modal.classList.add('hidden');
                        await loadPages();
                    } catch (err) { alert(err.message); }
                });

                document.getElementById('fTitle').addEventListener('input', e => {
                    if (!editingId) {
                        const slug = e.target.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
                        document.getElementById('fSlug').value = slug;
                        document.getElementById('slugPreview').textContent = slug;
                    }
                });
            }

            document.getElementById('btnNewPage').addEventListener('click', () => openEditor(null));
            document.getElementById('pageSearch').addEventListener('input', debounce(loadPages, 300));
            document.querySelectorAll('.status-chip').forEach(chip => {
                chip.addEventListener('click', () => {
                    document.querySelectorAll('.status-chip').forEach(c => {
                        c.className = 'status-chip px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap border border-gray-300 text-gray-600 hover:bg-gray-50';
                    });
                    chip.className = 'status-chip px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-brand-primary text-white';
                    loadPages();
                });
            });

            function debounce(fn, wait) {
                let t;
                return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), wait); };
            }

            bindModal();
            loadPages();
        })();
    </script>
}
