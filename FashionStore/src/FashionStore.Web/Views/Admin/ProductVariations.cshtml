@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Variation Builder";
    ViewData["PageTitle"] = "Variation Builder";
}

<div class="space-y-6">
    @* Step 1: Select product *@
    <div class="bg-white rounded-lg border p-5">
        <h3 class="font-bold text-gray-900 mb-3">1. Select Product</h3>
        <div class="flex flex-col sm:flex-row gap-3">
            <select id="productSelect" class="flex-1 border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-brand-primary">
                <option value="">Loading products...</option>
            </select>
            <button id="btnLoadVariations" class="px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium disabled:opacity-50" disabled>
                Load Variations
            </button>
        </div>
    </div>

    @* Step 2: Attribute selection & combination generation *@
    <div id="builderSection" class="hidden space-y-6">
        <div class="bg-white rounded-lg border p-5">
            <h3 class="font-bold text-gray-900 mb-3">2. Select Attributes & Values</h3>
            <div id="attributeCheckboxes" class="space-y-3"></div>
            <div id="selectedValuesSummary" class="mt-4 hidden">
                <div class="flex flex-col sm:flex-row sm:items-end gap-3">
                    <div class="flex-1">
                        <label class="block text-sm font-medium text-gray-700 mb-1">SKU Pattern</label>
                        <input type="text" id="skuPattern" placeholder="{SKU}-{COLOUR}-{SIZE}" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm" />
                        <p class="text-xs text-gray-500 mt-1">Tokens: {attributeSlug}. Base SKU from product. Leave empty for auto.</p>
                    </div>
                    <div class="w-full sm:w-48">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Base Price</label>
                        <input type="number" id="basePrice" step="0.01" min="0" value="0" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm" />
                    </div>
                    <button id="btnGenerateCombos" class="px-4 py-2.5 bg-brand-primary text-white rounded-lg text-sm font-medium">
                        Generate Combinations
                    </button>
                </div>
            </div>
        </div>

        @* Step 3: Combination matrix / cards *@
        <div id="combinationsSection" class="hidden">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-bold text-gray-900">3. Review & Save Variants</h3>
                <span id="comboCount" class="text-sm text-gray-500"></span>
            </div>

            @* Desktop Matrix *@
            <div class="hidden lg:block bg-white rounded-lg border overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Combination</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">SKU</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Compare At</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Active</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Default</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Remove</th>
                        </tr>
                    </thead>
                    <tbody id="comboTableBody" class="divide-y divide-gray-200"></tbody>
                </table>
            </div>

            @* Mobile Cards *@
            <div id="comboCards" class="lg:hidden space-y-3"></div>

            @* Bulk actions *@
            <div class="mt-4 bg-white rounded-lg border p-4">
                <h4 class="font-bold text-gray-900 text-sm mb-3">Bulk Actions</h4>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs text-gray-600 mb-1">Price Adjustment</label>
                        <div class="flex gap-2">
                            <input type="number" id="bulkPriceAdjustment" step="0.01" class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="e.g. 5.00" />
                            <select id="bulkPriceMode" class="border border-gray-300 rounded-lg px-2 py-2 text-sm">
                                <option value="amount">Amount</option>
                                <option value="percent">Percent</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-600 mb-1">Stock Adjustment</label>
                        <input type="number" id="bulkStockAdjustment" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="e.g. +10 or -5" />
                    </div>
                    <div class="flex items-end gap-2">
                        <button id="btnApplyBulk" class="px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium flex-1">Apply to Selected</button>
                        <button id="btnActivateAll" class="px-3 py-2 border border-green-200 text-green-700 rounded-lg text-sm">Activate All</button>
                        <button id="btnDeactivateAll" class="px-3 py-2 border border-red-200 text-red-600 rounded-lg text-sm">Deactivate All</button>
                    </div>
                </div>
            </div>

            @* Sticky save bar *@
            <div class="sticky bottom-0 z-20 bg-white/95 backdrop-blur border-t p-4 mt-4 flex items-center justify-between">
                <span id="saveSummary" class="text-sm text-gray-600"></span>
                <button id="btnSaveVariants" class="px-6 py-2.5 bg-green-600 text-white rounded-lg text-sm font-bold hover:bg-green-700">
                    Save All Variants
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let currentProductId = null;
let availableAttributes = [];
let selectedValueIds = new Set();
let combos = [];
let existingVariants = [];

document.addEventListener('DOMContentLoaded', async () => {
    await loadProducts();
    await loadAttributes();
});

async function loadProducts() {
    const response = await fetch('/api/admin/products');
    const products = response.ok ? await response.json() : [];
    const select = document.getElementById('productSelect');
    select.innerHTML = '<option value="">Select a product...</option>' +
        (Array.isArray(products) ? products.map(p => `<option value="${p.id}">${p.name}</option>`).join('') : '');
    document.getElementById('btnLoadVariations').disabled = !products.length;
}

async function loadAttributes() {
    const response = await fetch('/api/admin/attributes');
    availableAttributes = response.ok ? await response.json() : [];
    if (!Array.isArray(availableAttributes)) availableAttributes = [];
    renderAttributeCheckboxes();
}

function renderAttributeCheckboxes() {
    const container = document.getElementById('attributeCheckboxes');
    const variationAttrs = availableAttributes.filter(a => a.isVariationAttribute && a.isActive);
    if (!variationAttrs.length) {
        container.innerHTML = '<p class="text-sm text-gray-500">No variation attributes available. Create some first.</p>';
        return;
    }
    container.innerHTML = variationAttrs.map(attr => {
        const activeValues = (attr.values || []).filter(v => v.isActive);
        return `
            <div class="border rounded-lg p-4">
                <label class="flex items-center gap-2 cursor-pointer mb-2">
                    <input type="checkbox" data-attr-id="${attr.id}" class="attr-check w-4 h-4 text-brand-primary rounded" />
                    <span class="font-medium text-gray-900">${attr.name}</span>
                </label>
                <div class="flex flex-wrap gap-2 ml-6">
                    ${activeValues.map(v => `
                        <button type="button" data-attr-id="${attr.id}" data-value-id="${v.id}" data-value-name="${v.name}"
                            class="value-chip px-3 py-1.5 border border-gray-300 rounded-lg text-sm transition-colors">
                            ${v.hexColour ? `<span class="inline-block w-3 h-3 rounded-full border border-gray-300 mr-1" style="background:${v.hexColour}"></span>` : ''}
                            ${v.name}
                        </button>
                    `).join('')}
                </div>
            </div>
        `;
    }).join('');
}

document.addEventListener('click', (e) => {
    if (e.target.classList.contains('value-chip')) {
        e.preventDefault();
        const btn = e.target;
        const attrId = btn.dataset.attrId;
        const valueId = btn.dataset.valueId;
        if (selectedValueIds.has(valueId)) {
            selectedValueIds.delete(valueId);
            btn.classList.remove('bg-brand-primary', 'text-white', 'border-brand-primary');
            btn.classList.add('border-gray-300');
        } else {
            const attr = availableAttributes.find(a => a.id === attrId);
            const valuesForAttr = (attr?.values || []).filter(v => v.isActive);
            valuesForAttr.forEach(v => {
                if (v.id !== valueId) {
                    selectedValueIds.delete(v.id);
                    const chip = document.querySelector(`.value-chip[data-value-id="${v.id}"]`);
                    if (chip) {
                        chip.classList.remove('bg-brand-primary', 'text-white', 'border-brand-primary');
                        chip.classList.add('border-gray-300');
                    }
                }
            });
            selectedValueIds.add(valueId);
            btn.classList.remove('border-gray-300');
            btn.classList.add('bg-brand-primary', 'text-white', 'border-brand-primary');
        }
        document.getElementById('selectedValuesSummary').classList.toggle('hidden', selectedValueIds.size === 0);
    }
});

document.getElementById('btnLoadVariations').addEventListener('click', async () => {
    currentProductId = document.getElementById('productSelect').value;
    if (!currentProductId) return;
    document.getElementById('builderSection').classList.remove('hidden');
    const response = await fetch(`/api/admin/products/${currentProductId}/variants`);
    existingVariants = response.ok ? await response.json() : [];
    if (!Array.isArray(existingVariants)) existingVariants = [];
    renderExistingVariantsSummary();
});

function renderExistingVariantsSummary() {
    const section = document.getElementById('combinationsSection');
    if (!existingVariants.length) {
        section.classList.add('hidden');
        return;
    }
    section.classList.remove('hidden');
    renderCombos();
}

document.getElementById('btnGenerateCombos').addEventListener('click', async () => {
    if (!selectedValueIds.size) {
        alert('Select at least one attribute value per dimension.');
        return;
    }
    const request = {
        productId: currentProductId,
        attributeValueIds: [...selectedValueIds],
        skuPattern: document.getElementById('skuPattern').value || '',
        basePrice: parseFloat(document.getElementById('basePrice').value) || 0,
        generateAllCombinations: true
    };
    const response = await fetch(`/api/admin/products/${currentProductId}/variants/generate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(request)
    });
    if (!response.ok) {
        const err = await response.json();
        alert(err.error || 'Failed to generate combinations');
        return;
    }
    combos = await response.json();
    if (!Array.isArray(combos)) combos = [];
    renderCombos();
});

function renderCombos() {
    document.getElementById('combinationsSection').classList.remove('hidden');
    document.getElementById('comboCount').textContent = `${combos.length} combination(s)`;

    const tbody = document.getElementById('comboTableBody');
    const cards = document.getElementById('comboCards');

    tbody.innerHTML = combos.map((combo, idx) => {
        const exists = !!combo.exists;
        const existingId = combo.existingVariantId || '';
        const display = Object.entries(combo.displayValues || {}).map(([k, v]) => `<span class="inline-flex items-center gap-1 rounded bg-gray-100 px-2 py-0.5 text-xs font-medium">${k}: ${v}</span>`).join(' ');
        return `
            <tr data-idx="${idx}">
                <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-1.5">${display}</div>
                    ${exists ? '<span class="text-xs text-amber-600 mt-1 inline-block">Existing variant</span>' : ''}
                </td>
                <td class="px-4 py-3">
                    <input type="text" data-field="sku" value="${exists ? combo.sku || '' : combo.suggestedSku || ''}" class="w-40 border border-gray-300 rounded px-2 py-1.5 text-sm" />
                </td>
                <td class="px-4 py-3">
                    <input type="number" data-field="price" step="0.01" min="0" value="${combo.price ?? 0}" class="w-28 border border-gray-300 rounded px-2 py-1.5 text-sm" />
                </td>
                <td class="px-4 py-3">
                    <input type="number" data-field="compareAt" step="0.01" min="0" value="${combo.compareAtPrice ?? ''}" class="w-28 border border-gray-300 rounded px-2 py-1.5 text-sm" />
                </td>
                <td class="px-4 py-3">
                    <input type="number" data-field="stock" min="0" value="${combo.stockQuantity ?? 0}" class="w-24 border border-gray-300 rounded px-2 py-1.5 text-sm" />
                </td>
                <td class="px-4 py-3">
                    <input type="checkbox" data-field="active" ${combo.isActive === false ? '' : 'checked'} class="w-4 h-4" />
                </td>
                <td class="px-4 py-3">
                    <input type="radio" name="defaultVariant" data-field="default" ${combo.isDefault ? 'checked' : ''} class="w-4 h-4" />
                </td>
                <td class="px-4 py-3 text-right">
                    <button data-action="remove" data-idx="${idx}" class="text-red-500 hover:text-red-700 text-sm">Remove</button>
                </td>
            </tr>
        `;
    }).join('');

    cards.innerHTML = combos.map((combo, idx) => {
        const exists = !!combo.exists;
        const display = Object.entries(combo.displayValues || {}).map(([k, v]) => `<span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium">${k}: ${v}</span>`).join(' ');
        return `
            <div class="bg-white rounded-lg border p-4 space-y-3" data-card-idx="${idx}">
                <div class="flex items-start justify-between">
                    <div class="flex flex-wrap gap-1.5">${display}</div>
                    <button data-action="remove" data-idx="${idx}" class="text-red-500 text-sm">Remove</button>
                </div>
                ${exists ? '<span class="text-xs text-amber-600">Existing variant</span>' : ''}
                <div class="grid grid-cols-2 gap-3">
                    <div class="col-span-2">
                        <label class="block text-xs text-gray-600 mb-1">SKU</label>
                        <input type="text" data-field="sku" value="${exists ? combo.sku || '' : combo.suggestedSku || ''}" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs text-gray-600 mb-1">Price</label>
                        <input type="number" data-field="price" step="0.01" min="0" value="${combo.price ?? 0}" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs text-gray-600 mb-1">Compare At</label>
                        <input type="number" data-field="compareAt" step="0.01" min="0" value="${combo.compareAtPrice ?? ''}" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs text-gray-600 mb-1">Stock</label>
                        <input type="number" data-field="stock" min="0" value="${combo.stockQuantity ?? 0}" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" />
                    </div>
                    <div class="flex items-end gap-3 pb-1">
                        <label class="flex items-center gap-1.5 text-sm text-gray-700"><input type="checkbox" data-field="active" ${combo.isActive === false ? '' : 'checked'} class="w-4 h-4" /> Active</label>
                        <label class="flex items-center gap-1.5 text-sm text-gray-700"><input type="radio" name="defaultVariant" data-field="default" ${combo.isDefault ? 'checked' : ''} class="w-4 h-4" /> Default</label>
                    </div>
                </div>
            </div>
        `;
    }).join('');

    document.querySelectorAll('[data-action="remove"]').forEach(btn => {
        btn.addEventListener('click', () => {
            combos.splice(parseInt(btn.dataset.idx), 1);
            renderCombos();
        });
    });

    updateSaveSummary();
}

function updateSaveSummary() {
    const newCount = combos.filter(c => !c.exists).length;
    const updateCount = combos.filter(c => c.exists).length;
    document.getElementById('saveSummary').textContent = `${combos.length} total (${newCount} new, ${updateCount} existing)`;
}

document.getElementById('btnApplyBulk').addEventListener('click', () => {
    const priceAdj = parseFloat(document.getElementById('bulkPriceAdjustment').value);
    const priceMode = document.getElementById('bulkPriceMode').value;
    const stockAdj = parseInt(document.getElementById('bulkStockAdjustment').value);

    combos.forEach(combo => {
        if (!isNaN(priceAdj)) {
            const current = combo.price ?? 0;
            combo.price = priceMode === 'percent' ? +(current * (1 + priceAdj / 100)).toFixed(2) : +(current + priceAdj).toFixed(2);
        }
        if (!isNaN(stockAdj)) {
            const current = combo.stockQuantity ?? 0;
            combo.stockQuantity = Math.max(0, current + stockAdj);
        }
    });
    renderCombos();
});

document.getElementById('btnActivateAll').addEventListener('click', () => {
    combos.forEach(c => c.isActive = true);
    renderCombos();
});

document.getElementById('btnDeactivateAll').addEventListener('click', () => {
    combos.forEach(c => c.isActive = false);
    renderCombos();
});

document.getElementById('btnSaveVariants').addEventListener('click', async () => {
    const variants = combos.map(combo => ({
        productId: currentProductId,
        sku: combo.sku || combo.suggestedSku || '',
        barcode: null,
        price: parseFloat(combo.price) || 0,
        compareAtPrice: combo.compareAtPrice ? parseFloat(combo.compareAtPrice) : null,
        costPrice: null,
        weight: null,
        isDefault: combo.isDefault || false,
        isActive: combo.isActive !== false,
        stockQuantity: parseInt(combo.stockQuantity) || 0,
        imageUrl: null,
        notes: null,
        attributeValueIds: combo.attributeValueIds || []
    }));

    const response = await fetch(`/api/admin/products/${currentProductId}/variants/save-generated`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(variants)
    });
    if (response.ok) {
        alert('Variants saved successfully.');
        await loadExistingVariants();
    } else {
        const err = await response.json();
        alert(err.error || 'Failed to save variants');
    }
});

async function loadExistingVariants() {
    const response = await fetch(`/api/admin/products/${currentProductId}/variants`);
    existingVariants = response.ok ? await response.json() : [];
    if (!Array.isArray(existingVariants)) existingVariants = [];
    combos = [];
    document.getElementById('combinationsSection').classList.add('hidden');
    await loadProducts();
}
</script>
}
