@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Review";
    ViewData["PageTitle"] = "Review";
    var reviewId = ViewData["ReviewId"] as Guid? ?? Guid.Empty;
}

<div class="space-y-4 pb-28" id="reviewDetailRoot">
    <div class="flex items-center justify-between gap-3">
        <a href="/admin/reviews" class="text-sm text-gray-500 hover:text-brand-primary flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to reviews
        </a>
        <div id="headerActions" class="hidden lg:flex gap-2"></div>
    </div>

    <div id="reviewBody" class="space-y-4">
        <p class="text-center text-gray-400 py-10">Loading review...</p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const reviewId = '@reviewId';

            function esc(value) {
                if (value === null || value === undefined) return '';
                return String(value).replace(/[&<>"']/g, c => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[c]));
            }

            function stars(rating) {
                let html = '<span class="flex items-center gap-0.5">';
                for (let i = 1; i <= 5; i++) {
                    html += i <= rating
                        ? '<svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/></svg>'
                        : '<svg class="w-4 h-4 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/></svg>';
                }
                return html + '</span>';
            }

            const statusColors = {
                Pending: 'bg-amber-50 text-amber-700',
                Approved: 'bg-emerald-50 text-emerald-700',
                Rejected: 'bg-red-50 text-red-600',
                Hidden: 'bg-gray-100 text-gray-600'
            };

            async function api(path, options) {
                const res = await fetch(path, options);
                const body = await res.json().catch(() => ({}));
                if (!res.ok) {
                    throw new Error(body.error || body.title || 'Request failed');
                }
                return body;
            }

            function badge(status) {
                return `<span class="inline-flex px-2 py-1 rounded-full text-xs font-medium ${statusColors[status] || 'bg-gray-100 text-gray-600'}">${esc(status)}</span>`;
            }

            function actionButton(label, cls, fn) {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = `px-4 py-2 rounded-lg text-sm font-medium ${cls}`;
                button.textContent = label;
                button.addEventListener('click', fn);
                return button;
            }

            function moderate(status, note) {
                return api(`/api/admin/reviews/${reviewId}/moderate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: status, notes: note || null })
                });
            }

            function confirmDialog(title, message, confirmLabel, cls, onConfirm) {
                const overlay = document.createElement('div');
                overlay.className = 'fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4';
                overlay.innerHTML = `
                    <div class="bg-white rounded-t-2xl sm:rounded-2xl w-full sm:max-w-lg p-5 space-y-4">
                        <h3 class="text-lg font-bold">${esc(title)}</h3>
                        <p class="text-sm text-gray-600">${esc(message)}</p>
                        <textarea id="moderationNote" maxlength="2000" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-primary" placeholder="Optional moderation note"></textarea>
                        <div class="flex justify-end gap-3 pt-2">
                            <button type="button" class="btn-close-dialog px-4 py-2 border border-gray-300 rounded-lg text-sm">Cancel</button>
                            <button type="button" class="btn-confirm px-5 py-2 ${cls} text-white rounded-lg text-sm font-medium">${esc(confirmLabel)}</button>
                        </div>
                    </div>`;
                document.body.appendChild(overlay);
                overlay.querySelector('.btn-close-dialog').addEventListener('click', () => overlay.remove());
                overlay.querySelector('.btn-confirm').addEventListener('click', async () => {
                    const note = overlay.querySelector('#moderationNote').value.trim();
                    overlay.querySelector('.btn-confirm').disabled = true;
                    try {
                        await onConfirm(note);
                        overlay.remove();
                    } catch (err) {
                        alert(err.message);
                        overlay.querySelector('.btn-confirm').disabled = false;
                    }
                });
            }

            async function loadReview() {
                const root = document.getElementById('reviewDetailRoot');
                const review = await api(`/api/admin/reviews/${reviewId}`);
                render(review);
            }

            function render(r) {
                const body = document.getElementById('reviewBody');
                const headerActions = document.getElementById('headerActions');

                const notesHtml = r.moderationNotes
                    ? r.moderationNotes.split('\n').map(line => `<div class="text-sm text-gray-700 whitespace-pre-line">${esc(line)}</div>`).join('<div class="h-px bg-gray-100 my-2"></div>')
                    : '<p class="text-sm text-gray-400">No moderation notes yet.</p>';

                body.innerHTML = `
                    <div class="bg-white rounded-lg border p-5">
                        <div class="flex items-start justify-between gap-3 flex-wrap">
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    ${stars(r.rating)}
                                    ${badge(r.status)}
                                    ${r.isFlagged ? '<span class="inline-flex px-2 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-700">Flagged</span>' : ''}
                                </div>
                                <h2 class="text-xl font-bold text-gray-900 mt-2">${esc(r.title || 'Untitled review')}</h2>
                            </div>
                            <div class="flex gap-2" id="moderateActions"></div>
                        </div>

                        <p class="text-sm text-gray-700 mt-3 whitespace-pre-line">${esc(r.body || '')}</p>

                        ${r.images && r.images.length > 0 ? `
                            <div class="flex gap-2 mt-4 flex-wrap">
                                ${r.images.map(img => `<a href="${esc(img.url)}" target="_blank" rel="noopener"><img src="${esc(img.url)}" alt="Review photo" class="w-20 h-20 rounded-lg object-cover" loading="lazy" /></a>`).join('')}
                            </div>` : ''}
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                        <div class="bg-white rounded-lg border p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Customer</h3>
                            <p class="text-sm font-medium text-gray-900">${esc(r.displayName)}</p>
                            <p class="text-xs text-gray-500 mt-1">User ID: ${esc(r.userId)}</p>
                            <p class="text-xs text-gray-500 mt-1">${r.isVerifiedPurchase ? '<span class="text-emerald-600 font-semibold">Verified purchase</span>' : '<span class="text-gray-500">Not verified</span>'}</p>
                            ${r.orderNumber ? `<p class="text-xs text-gray-500 mt-1">Order <span class="font-mono">${esc(r.orderNumber)}</span></p>` : ''}
                            ${r.orderItemName ? `<p class="text-xs text-gray-500 mt-1">Line: ${esc(r.orderItemName)}</p>` : ''}
                        </div>
                        <div class="bg-white rounded-lg border p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Product</h3>
                            <div class="flex items-center gap-3">
                                ${r.productImageUrl ? `<img src="${esc(r.productImageUrl)}" alt="" class="w-12 h-12 rounded-lg object-cover" />` : ''}
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate">${esc(r.productName)}</p>
                                    <a href="/products/${esc(r.productSlug)}" target="_blank" rel="noopener" class="text-xs text-brand-primary hover:underline">View on storefront</a>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white rounded-lg border p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Details</h3>
                            <p class="text-sm text-gray-700">Helpful votes: <span class="font-medium">${r.helpfulCount}</span></p>
                            <p class="text-sm text-gray-700 mt-1">Submitted: ${esc(new Date(r.createdAtUtc).toLocaleString())}</p>
                            ${r.updatedAtUtc ? `<p class="text-sm text-gray-700 mt-1">Updated: ${esc(new Date(r.updatedAtUtc).toLocaleString())}</p>` : ''}
                        </div>
                    </div>

                    <div class="bg-white rounded-lg border p-5">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Moderation notes</h3>
                            <button type="button" id="btnAddNote" class="px-3 py-1.5 border border-gray-300 rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50">Add note</button>
                        </div>
                        <div class="space-y-2">${notesHtml}</div>
                    </div>
                `;

                const moderateActions = document.getElementById('moderateActions');
                if (r.status !== 'Approved') {
                    moderateActions.appendChild(actionButton('Approve', 'bg-emerald-600 text-white', () => {
                        confirmDialog('Approve review', 'The review becomes visible on the product page and counts towards the rating.', 'Approve', 'bg-emerald-600', (note) => {
                            return moderate('Approved', note).then(() => location.reload());
                        });
                    }));
                }
                if (r.status !== 'Rejected') {
                    moderateActions.appendChild(actionButton('Reject', 'bg-red-600 text-white', () => {
                        confirmDialog('Reject review', 'The review is removed from the public product page.', 'Reject', 'bg-red-600', (note) => {
                            return moderate('Rejected', note).then(() => location.reload());
                        });
                    }));
                }
                if (r.status !== 'Hidden') {
                    moderateActions.appendChild(actionButton('Hide', 'bg-gray-700 text-white', () => {
                        confirmDialog('Hide review', 'The review is suppressed without being deleted.', 'Hide', 'bg-gray-700', (note) => {
                            return moderate('Hidden', note).then(() => location.reload());
                        });
                    }));
                }
                moderateActions.appendChild(actionButton('Delete', 'bg-red-50 text-red-600 border border-red-200', () => {
                    confirmDialog('Delete review', 'Permanently deletes this review. Approved reviews must be hidden instead unless flagged.', 'Delete', 'bg-red-600', () => {
                        return api(`/api/admin/reviews/${reviewId}/delete`, { method: 'POST' }).then(() => { window.location = '/admin/reviews'; });
                    });
                }));

                document.getElementById('btnAddNote').addEventListener('click', () => {
                    confirmDialog('Add moderation note', 'Internal note for your team. Does not change the review status.', 'Save note', 'bg-brand-primary', (note) => {
                        return api(`/api/admin/reviews/${reviewId}/notes`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ note: note || null })
                        }).then(() => location.reload());
                    });
                });
            }

            loadReview().catch(err => {
                document.getElementById('reviewBody').innerHTML =
                    `<div class="bg-white rounded-lg border p-6 text-center text-red-600 text-sm">${esc(err.message)}</div>`;
            });
        })();
    </script>
}
