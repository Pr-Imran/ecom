@model FashionStore.Web.Models.InvoiceViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Invoice " + Model.Invoice.InvoiceNumber;
    ViewData["PageTitle"] = "Invoice";
    var orderId = ViewData["OrderId"] as Guid? ?? Model.Invoice.OrderId;
}

@section Styles {
    <style>
        @@media print {
            body { background: #fff; }
            .no-print { display: none !important; }
            .print-actions { display: none !important; }
            #invoiceBody { border: 0; }
        }
    </style>
}

<div class="space-y-4 pb-28 no-print">
    <div class="flex items-center justify-between gap-3">
        <a href="/admin/orders/@orderId" class="text-sm text-gray-500 hover:text-brand-primary flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to order
        </a>
    </div>

    @if (TempData["InvoiceEmailMessage"] is string emailMessage)
    {
        <div class="rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700">@emailMessage</div>
    }

    <div class="flex flex-wrap items-center gap-2 no-print">
        <button onclick="window.print()" class="px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium">
            Print
        </button>
        <a href="/admin/orders/@orderId/invoice.pdf" class="px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium">
            Download PDF
        </a>
        <form method="post" action="/admin/orders/@orderId/invoice/email" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-sm font-medium">
                Email PDF
            </button>
        </form>
        <form method="post" action="/admin/orders/@orderId/invoice/regenerate" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-sm font-medium">
                Regenerate
            </button>
        </form>
    </div>
</div>

<partial name="_InvoiceBody" model="Model" />

@if (Model.SendHistory.Count > 0)
{
    <div class="mt-6 bg-white rounded-lg border border-gray-200 p-5 no-print">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Email send history</h3>
        <ul class="divide-y divide-gray-100">
            @foreach (var log in Model.SendHistory)
            {
                <li class="py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                    <div class="text-sm">
                        <span class="font-medium text-gray-800">@log.SentTo</span>
                        <span class="text-gray-500"> · @log.Subject</span>
                    </div>
                    <div class="text-xs text-gray-500 flex items-center gap-2">
                        @if (log.Succeeded)
                        {
                            <span class="text-green-700 font-medium">Delivered</span>
                        }
                        else
                        {
                            <span class="text-red-700 font-medium">Failed</span>
                        }
                        <span>@log.SentAtUtc.ToLocalTime().ToString("MMM d, yyyy HH:mm")</span>
                    </div>
                </li>
            }
        </ul>
    </div>
}
