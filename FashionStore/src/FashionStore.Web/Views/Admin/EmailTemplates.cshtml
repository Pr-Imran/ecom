@using FashionStore.Application.Email
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Email Templates";
    ViewData["PageTitle"] = "Email Templates";
    var previews = (IReadOnlyList<EmailTemplatePreview>)ViewData["EmailTemplatePreviews"]!;
}

<div class="space-y-4 pb-24">
    <div class="flex items-center justify-between">
        <p class="text-sm text-gray-500">Responsive preview of every transactional email template rendered with sample data.</p>
        <a href="/admin/emails" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 whitespace-nowrap inline-flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to email log
        </a>
    </div>

    @if (previews.Count == 0)
    {
        <div class="bg-white rounded-lg border p-8 text-center text-gray-500 text-sm">No templates found.</div>
    }

    @foreach (var preview in previews)
    {
        <script type="application/json" data-html-for="@preview.Name">@Html.Raw(JsonSerializer.Serialize(preview.Html))</script>
    }

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
        @foreach (var preview in previews)
        {
            <div class="bg-white rounded-lg border overflow-hidden">
                <div class="px-4 py-3 border-b bg-gray-50 flex items-center justify-between gap-2">
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-gray-900">@preview.Name</p>
                        <p class="text-xs text-gray-500 truncate">@preview.Subject</p>
                    </div>
                    <button type="button" class="btn-open-preview text-xs font-medium text-brand-primary hover:underline whitespace-nowrap" data-name="@preview.Name">
                        Preview full size
                    </button>
                </div>
                <div class="p-4">
                    <div class="border rounded-lg overflow-hidden max-h-64">
                        <iframe class="w-full h-64 border-0" data-iframe="@preview.Name" sandbox="" loading="lazy"></iframe>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Full-size preview modal *@
<div id="previewModal" class="hidden fixed inset-0 z-50 bg-black/60">
    <div class="bg-white rounded-2xl w-full h-full sm:max-w-3xl sm:h-auto sm:max-h-[85vh] mx-auto sm:my-8 flex flex-col overflow-hidden">
        <div class="px-5 py-4 border-b flex items-center justify-between">
            <div>
                <h3 id="previewModalTitle" class="text-base font-bold"></h3>
                <p id="previewModalSubject" class="text-xs text-gray-500"></p>
            </div>
            <button type="button" id="btnClosePreview" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <iframe id="previewModalFrame" class="w-full flex-1 min-h-0 border-0" sandbox=""></iframe>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const htmlSources = {};
            document.querySelectorAll('script[data-html-for]').forEach(script => {
                htmlSources[script.dataset.htmlFor] = JSON.parse(script.textContent);
            });

            const previews = @Html.Raw(JsonSerializer.Serialize(previews.Select(p => new { p.Name, p.Subject })));

            document.querySelectorAll('iframe[data-iframe]').forEach(frame => {
                frame.srcdoc = htmlSources[frame.dataset.iframe] || '';
            });

            const modal = document.getElementById('previewModal');
            const modalFrame = document.getElementById('previewModalFrame');

            function openPreview(name) {
                const meta = previews.find(p => p.name === name);
                document.getElementById('previewModalTitle').textContent = meta ? meta.name : name;
                document.getElementById('previewModalSubject').textContent = meta ? meta.subject : '';
                modalFrame.srcdoc = htmlSources[name] || '';
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }

            function closePreview() {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                modalFrame.srcdoc = '';
                document.body.style.overflow = '';
            }

            document.querySelectorAll('.btn-open-preview').forEach(btn => {
                btn.addEventListener('click', () => openPreview(btn.dataset.name));
            });
            document.getElementById('btnClosePreview').addEventListener('click', closePreview);
            modal.addEventListener('click', e => {
                if (e.target === modal) closePreview();
            });
        })();
    </script>
}
