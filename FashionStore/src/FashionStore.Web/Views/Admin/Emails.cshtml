@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Emails";
    ViewData["PageTitle"] = "Emails";
}

<div class="space-y-4 pb-24">
    @* Search + actions *@
    <div class="flex flex-col sm:flex-row gap-3">
        <div class="flex-1 flex gap-2">
            <div class="relative flex-1">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input type="search" id="emailSearch" placeholder="Search recipient or subject..."
                       class="w-full border border-gray-300 rounded-lg pl-10 pr-4 py-2.5 text-sm focus:ring-2 focus:ring-brand-primary focus:border-transparent" />
            </div>
            <button id="btnApplySearch" class="px-4 py-2 bg-brand-primary text-white rounded-lg hover:bg-brand-primary/90 text-sm font-medium whitespace-nowrap">Search</button>
        </div>
        <div class="flex gap-2">
            <select id="filterStatus" class="border border-gray-300 rounded-lg px-3 py-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-brand-primary">
                <option value="">All statuses</option>
                <option value="Pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Sent">Sent</option>
                <option value="Failed">Failed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
            <a href="/admin/emails/templates" class="px-4 py-2.5 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 whitespace-nowrap inline-flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                Template previews
            </a>
        </div>
    </div>

    @* Desktop table *@
    <div class="hidden lg:block bg-white rounded-lg border overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-gray-50 border-b">
                <tr>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Recipient</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Subject</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Attempts</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Created</th>
                    <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody id="emailsTableBody"></tbody>
        </table>
    </div>

    @* Mobile cards *@
    <div id="emailsCards" class="lg:hidden space-y-3">
        <div class="bg-white rounded-lg border p-4 text-center text-gray-500 text-sm py-8">
            <p>Loading emails...</p>
        </div>
    </div>

    @* Pagination *@
    <div id="pagination" class="hidden items-center justify-between gap-3">
        <p id="pageInfo" class="text-sm text-gray-500"></p>
        <div class="flex gap-2">
            <button id="btnPrevPage" class="px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50">Previous</button>
            <button id="btnNextPage" class="px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50">Next</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const statusColors = {
                Pending: 'bg-blue-50 text-blue-700',
                Processing: 'bg-amber-50 text-amber-700',
                Sent: 'bg-emerald-50 text-emerald-700',
                Failed: 'bg-red-50 text-red-600',
                Cancelled: 'bg-gray-100 text-gray-600'
            };

            let state = { page: 1, pageSize: 20, totalCount: 0, hasMore: false };

            function api(path, options) {
                return fetch(path, options).then(async res => {
                    if (res.ok) return res.json();
                    let error = 'Request failed';
                    try {
                        const body = await res.json();
                        error = body.error || body.title || error;
                    } catch (e) { /* ignore */ }
                    throw new Error(error);
                });
            }

            function esc(value) {
                if (value === null || value === undefined) return '';
                return String(value).replace(/[&<>"']/g, c => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[c]));
            }

            function badge(value, colors) {
                return `<span class="inline-flex px-2 py-1 rounded-full text-xs font-medium ${colors[value] || 'bg-gray-100 text-gray-600'}">${esc(value)}</span>`;
            }

            function buildQuery() {
                const params = new URLSearchParams();
                const search = document.getElementById('emailSearch').value.trim();
                if (search) params.set('search', search);
                const status = document.getElementById('filterStatus').value;
                if (status) params.set('status', status);
                params.set('page', state.page);
                params.set('pageSize', state.pageSize);
                return params.toString();
            }

            async function loadEmails() {
                const html = await api('/api/admin/emails?' + buildQuery());
                state.page = html.page;
                state.pageSize = html.pageSize;
                state.totalCount = html.totalCount;
                state.hasMore = html.hasMore;
                renderEmails(html.items || []);
                renderPagination();
            }

            function renderEmails(emails) {
                const tbody = document.getElementById('emailsTableBody');
                if (emails.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-10 text-center text-gray-500 text-sm">No emails match your filters.</td></tr>';
                } else {
                    tbody.innerHTML = emails.map(e => `
                        <tr class="hover:bg-gray-50 border-b">
                            <td class="px-6 py-4">
                                <p class="text-sm font-medium text-gray-900">${esc(e.toEmail)}</p>
                                ${e.recipientName ? `<p class="text-xs text-gray-500">${esc(e.recipientName)}</p>` : ''}
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-700">${esc(e.subject)}</td>
                            <td class="px-6 py-4">${badge(e.status, statusColors)}</td>
                            <td class="px-6 py-4">
                                <p class="text-sm text-gray-700">${e.attemptCount}/${e.maxAttempts}</p>
                                ${e.lastError ? `<p class="text-xs text-red-500 max-w-[180px] truncate" title="${esc(e.lastError)}">${esc(e.lastError)}</p>` : ''}
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">${new Date(e.createdAtUtc).toLocaleString()}</td>
                            <td class="px-6 py-4">
                                <button class="btn-resend px-3 py-1.5 border border-gray-300 rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50"
                                        data-id="${e.id}" data-subject="${esc(e.subject)}">Resend</button>
                            </td>
                        </tr>`).join('');
                }

                const cards = document.getElementById('emailsCards');
                if (emails.length === 0) {
                    cards.innerHTML = '<div class="bg-white rounded-lg border p-4 text-center text-gray-500 text-sm py-10"><p>No emails match your filters.</p></div>';
                } else {
                    cards.innerHTML = emails.map(e => `
                        <div class="bg-white rounded-lg border p-4">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="text-sm font-semibold text-gray-900 truncate">${esc(e.toEmail)}</p>
                                    <p class="text-xs text-gray-500 mt-0.5 truncate">${esc(e.subject)}</p>
                                </div>
                                ${badge(e.status, statusColors)}
                            </div>
                            <div class="flex items-center justify-between mt-3">
                                <p class="text-xs text-gray-500">${new Date(e.createdAtUtc).toLocaleString()} · ${e.attemptCount}/${e.maxAttempts} attempts</p>
                                <button class="btn-resend px-3 py-1.5 border border-gray-300 rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50" data-id="${e.id}">Resend</button>
                            </div>
                            ${e.lastError ? `<p class="text-xs text-red-500 mt-2">${esc(e.lastError)}</p>` : ''}
                        </div>`).join('');
                }

                document.querySelectorAll('.btn-resend').forEach(btn => {
                    btn.addEventListener('click', () => resend(btn.dataset.id));
                });
            }

            function renderPagination() {
                const pagination = document.getElementById('pagination');
                if (state.totalCount === 0) {
                    pagination.classList.add('hidden');
                    return;
                }
                pagination.classList.remove('hidden');
                pagination.classList.add('flex');
                const start = (state.page - 1) * state.pageSize + 1;
                const end = Math.min(state.page * state.pageSize, state.totalCount);
                document.getElementById('pageInfo').textContent = `${start}–${end} of ${state.totalCount} emails`;
                document.getElementById('btnPrevPage').disabled = state.page <= 1;
                document.getElementById('btnNextPage').disabled = !state.hasMore;
            }

            async function resend(id) {
                try {
                    const result = await api('/api/admin/emails/' + id + '/resend', { method: 'POST' });
                    if (result.success) loadEmails();
                } catch (err) {
                    alert(err.message);
                }
            }

            document.getElementById('btnApplySearch').addEventListener('click', () => { state.page = 1; loadEmails(); });
            document.getElementById('emailSearch').addEventListener('keydown', e => {
                if (e.key === 'Enter') { state.page = 1; loadEmails(); }
            });
            document.getElementById('filterStatus').addEventListener('change', () => { state.page = 1; loadEmails(); });
            document.getElementById('btnPrevPage').addEventListener('click', () => {
                if (state.page > 1) { state.page--; loadEmails(); }
            });
            document.getElementById('btnNextPage').addEventListener('click', () => {
                if (state.hasMore) { state.page++; loadEmails(); }
            });

            loadEmails();
        })();
    </script>
}
