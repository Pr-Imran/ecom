@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Brands";
    ViewData["PageTitle"] = "Brands";
}

<div class="space-y-4">
    @* Desktop Toolbar *@
    <div class="hidden lg:flex items-center justify-between gap-4">
        <div class="flex-1 max-w-md">
            <input type="text" id="desktopSearch" placeholder="Search brands..." 
                   class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
        </div>
        <div class="flex items-center gap-2">
            <label class="text-sm text-gray-600">Show:</label>
            <select id="filterStatus" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary">
                <option value="active">Active Only</option>
                <option value="all">All</option>
            </select>
            <button id="btnAdd" class="px-4 py-2 bg-brand-primary text-white rounded-lg hover:bg-brand-primary/90 text-sm font-medium">
                + Add Brand
            </button>
        </div>
    </div>

    @* Brands List - Desktop Table *@
    <div class="hidden lg:block bg-white rounded-lg shadow-sm border overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50 border-b">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Website</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody id="brandsTableBody" class="divide-y divide-gray-200">
                <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">
                        <p>No brands yet. Click "Add Brand" to create one.</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @* Brands List - Mobile Cards *@
    <div id="brandsCards" class="lg:hidden space-y-3 pb-24">
        <div class="bg-white rounded-lg border p-4 text-center text-gray-500 text-sm py-8">
            <p>No brands yet. Tap the + button to create one.</p>
        </div>
    </div>
</div>

@* Floating Add Button (Mobile) *@
<button id="btnAddMobile" class="lg:hidden fixed bottom-20 right-4 w-14 h-14 bg-brand-primary text-white rounded-full shadow-lg flex items-center justify-center hover:bg-brand-primary/90 z-30">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
    </svg>
</button>

@* Brand Form Modal *@
<div id="brandModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-white rounded-t-2xl sm:rounded-2xl w-full sm:max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="sticky top-0 bg-white border-b px-6 py-4 flex items-center justify-between rounded-t-2xl">
            <h3 id="modalTitle" class="text-lg font-bold">Add Brand</h3>
            <button class="btn-close-modal text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form id="brandForm" class="p-6 space-y-4">
            <input type="hidden" id="brandId" />
            
            <div>
                <label for="brandName" class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
                <input type="text" id="brandName" required maxlength="200"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
            </div>

            <div>
                <label for="brandSlug" class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
                <input type="text" id="brandSlug" maxlength="200" readonly
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 bg-gray-50 text-gray-600 text-sm" />
                <p class="text-xs text-gray-500 mt-1">Auto-generated from name</p>
            </div>

            <div>
                <label for="brandDescription" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea id="brandDescription" maxlength="2000" rows="3"
                          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="brandLogoUrl" class="block text-sm font-medium text-gray-700 mb-1">Logo URL</label>
                    <input type="url" id="brandLogoUrl" maxlength="500"
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
                </div>
                <div>
                    <label for="brandWebsiteUrl" class="block text-sm font-medium text-gray-700 mb-1">Website URL</label>
                    <input type="url" id="brandWebsiteUrl" maxlength="500"
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
                </div>
            </div>

            <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="brandIsActive" checked class="w-4 h-4 text-brand-primary border-gray-300 rounded focus:ring-brand-primary" />
                    <span class="text-sm text-gray-700">Active</span>
                </label>
                <div class="flex-1">
                    <label for="brandDisplayOrder" class="block text-sm font-medium text-gray-700 mb-1">Display Order</label>
                    <input type="number" id="brandDisplayOrder" value="0" min="0"
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm" />
                </div>
            </div>

            <div class="border-t pt-4 mt-4">
                <h4 class="text-sm font-medium text-gray-700 mb-3">SEO</h4>
                <div class="space-y-3">
                    <div>
                        <label for="brandSeoTitle" class="block text-xs text-gray-600 mb-1">SEO Title</label>
                        <input type="text" id="brandSeoTitle" maxlength="200"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label for="brandSeoDescription" class="block text-xs text-gray-600 mb-1">SEO Description</label>
                        <textarea id="brandSeoDescription" maxlength="2000" rows="2"
                                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm"></textarea>
                    </div>
                </div>
            </div>
        </form>
        <div class="sticky bottom-0 bg-white border-t px-6 py-4 flex items-center justify-end gap-3 rounded-b-2xl">
            <button type="button" class="btn-close-modal px-4 py-2 border border-gray-300 rounded-lg text-sm hover:bg-gray-50">Cancel</button>
            <button type="submit" form="brandForm" class="px-6 py-2 bg-brand-primary text-white rounded-lg text-sm hover:bg-brand-primary/90 font-medium">Save Brand</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let brands = [];
        let isEditing = false;

        document.getElementById('brandName').addEventListener('input', function() {
            const slug = this.value.toLowerCase().replace(/ /g, '-').replace(/--+/g, '-').trim('-');
            document.getElementById('brandSlug').value = slug;
        });

        document.querySelectorAll('.btn-close-modal').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('brandModal').classList.add('hidden');
            });
        });

        document.getElementById('btnAdd').addEventListener('click', openAddModal);
        document.getElementById('btnAddMobile').addEventListener('click', openAddModal);

        function openAddModal() {
            isEditing = false;
            document.getElementById('modalTitle').textContent = 'Add Brand';
            document.getElementById('brandForm').reset();
            document.getElementById('brandId').value = '';
            document.getElementById('brandModal').classList.remove('hidden');
        }

        async function loadBrands() {
            const includeInactive = document.getElementById('filterStatus').value === 'all';
            const response = await fetch(`/api/admin/brands?includeInactive=${includeInactive}`);
            if (response.ok) {
                brands = await response.json();
                renderBrands();
            }
        }

        function renderBrands() {
            const tableBody = document.getElementById('brandsTableBody');
            if (brands.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">No brands found</td></tr>';
            } else {
                tableBody.innerHTML = brands.map(b => `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900">${b.name}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${b.slug}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${b.websiteUrl || '-'}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${b.displayOrder}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium ${b.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                ${b.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <button onclick="editBrand('${b.id}')" class="text-brand-primary hover:text-brand-primary/80 mr-3">Edit</button>
                            <button onclick="deleteBrand('${b.id}')" class="text-red-600 hover:text-red-700">Delete</button>
                        </td>
                    </tr>
                `).join('');
            }

            const cardsContainer = document.getElementById('brandsCards');
            if (brands.length === 0) {
                cardsContainer.innerHTML = '<div class="bg-white rounded-lg border p-4 text-center text-gray-500 text-sm py-8"><p>No brands yet.</p></div>';
            } else {
                cardsContainer.innerHTML = brands.map(b => `
                    <div class="bg-white rounded-lg border p-4">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex-1">
                                <h3 class="font-bold text-gray-900">${b.name}</h3>
                                <p class="text-xs text-gray-500 mt-1">${b.slug}</p>
                            </div>
                            <span class="px-2 py-1 rounded-full text-xs font-medium ${b.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                ${b.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </div>
                        ${b.websiteUrl ? `<div class="text-xs text-gray-600 mb-3">Website: ${b.websiteUrl}</div>` : ''}
                        <div class="flex gap-2 pt-3 border-t">
                            <button onclick="editBrand('${b.id}')" class="flex-1 px-3 py-2 bg-brand-primary text-white rounded-lg text-sm">Edit</button>
                            <button onclick="deleteBrand('${b.id}')" class="px-3 py-2 border border-red-200 text-red-600 rounded-lg text-sm">Delete</button>
                        </div>
                    </div>
                `).join('');
            }
        }

        async function editBrand(id) {
            const brand = brands.find(b => b.id === id);
            if (!brand) return;

            isEditing = true;
            document.getElementById('modalTitle').textContent = 'Edit Brand';
            document.getElementById('brandId').value = brand.id;
            document.getElementById('brandName').value = brand.name;
            document.getElementById('brandSlug').value = brand.slug;
            document.getElementById('brandDescription').value = brand.description || '';
            document.getElementById('brandLogoUrl').value = brand.logoUrl || '';
            document.getElementById('brandWebsiteUrl').value = brand.websiteUrl || '';
            document.getElementById('brandDisplayOrder').value = brand.displayOrder;
            document.getElementById('brandIsActive').checked = brand.isActive;
            document.getElementById('brandSeoTitle').value = brand.seoTitle || '';
            document.getElementById('brandSeoDescription').value = brand.seoDescription || '';
            
            document.getElementById('brandModal').classList.remove('hidden');
        }

        async function deleteBrand(id) {
            if (!confirm('Are you sure you want to delete this brand?')) return;

            const response = await fetch(`/api/admin/brands/${id}`, { method: 'DELETE' });
            if (response.ok) {
                await loadBrands();
            } else {
                const error = await response.json();
                alert(error.error || 'Failed to delete brand');
            }
        }

        document.getElementById('brandForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const data = {
                id: document.getElementById('brandId').value || undefined,
                name: document.getElementById('brandName').value,
                description: document.getElementById('brandDescription').value,
                logoUrl: document.getElementById('brandLogoUrl').value || null,
                websiteUrl: document.getElementById('brandWebsiteUrl').value || null,
                displayOrder: parseInt(document.getElementById('brandDisplayOrder').value),
                isActive: document.getElementById('brandIsActive').checked,
                seoTitle: document.getElementById('brandSeoTitle').value || null,
                seoDescription: document.getElementById('brandSeoDescription').value || null
            };

            const url = isEditing ? `/api/admin/brands/${data.id}` : '/api/admin/brands';
            const method = isEditing ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                document.getElementById('brandModal').classList.add('hidden');
                await loadBrands();
            } else {
                const error = await response.json();
                alert(error.error || 'Failed to save brand');
            }
        });

        document.getElementById('filterStatus').addEventListener('change', loadBrands);
        loadBrands();
    </script>
}
