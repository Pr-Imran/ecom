@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "FAQs";
    ViewData["PageTitle"] = "FAQs";
}

<div class="space-y-4 pb-28">
    @* Header actions *@
    <div class="flex justify-end">
        <button id="btnNewFaq" class="px-4 py-2.5 bg-brand-primary text-white rounded-lg hover:bg-brand-primary/90 text-sm font-medium whitespace-nowrap">
            Add FAQ
        </button>
    </div>

    @* Preview cards *@
    <div id="faqsList" class="space-y-3">
        <div class="bg-white rounded-lg border p-6 text-center text-gray-500 text-sm">
            <p>Loading FAQs...</p>
        </div>
    </div>
</div>

@* Editor modal *@
<div id="faqModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/40" data-close-modal></div>
    <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center p-0 sm:p-6">
        <div class="bg-white w-full sm:max-w-xl rounded-t-2xl sm:rounded-2xl shadow-xl max-h-[90vh] flex flex-col">
            <div class="flex items-center justify-between px-6 py-4 border-b">
                <h3 id="modalTitle" class="text-lg font-semibold text-gray-900">New FAQ</h3>
                <button class="btn-icon" data-close-modal aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="p-6 overflow-y-auto space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Question</label>
                        <input type="text" id="fQuestion" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                        <input type="text" id="fCategory" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="Shipping, Returns..." />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Display Order</label>
                        <input type="number" id="fOrder" value="0" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Answer</label>
                        <textarea id="fAnswer" rows="5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-primary"></textarea>
                        <p class="text-xs text-gray-500 mt-1">HTML is sanitized on save.</p>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" id="fActive" checked class="rounded border-gray-300" />
                            Active (shown on the FAQ page)
                        </label>
                    </div>
                </div>
            </div>
            <div class="flex items-center justify-between px-6 py-4 border-t">
                <span id="deleteFaqBtnWrap" class="hidden">
                    <button id="btnDeleteFaq" class="px-4 py-2 text-sm font-medium text-red-600 hover:text-red-700">Delete</button>
                </span>
                <div class="flex gap-2 ml-auto">
                    <button class="px-4 py-2 text-sm border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50" data-close-modal>Cancel</button>
                    <button id="btnSaveFaq" class="px-4 py-2 text-sm font-medium bg-brand-primary text-white rounded-lg hover:bg-brand-primary/90">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            let editingId = null;
            let faqs = [];

            function api(path, options) {
                return fetch(path, options).then(async res => {
                    if (res.ok) return res.json();
                    let error = 'Request failed';
                    try {
                        const body = await res.json();
                        error = body.error || body.title || error;
                    } catch (e) { /* ignore */ }
                    throw new Error(error);
                });
            }

            function esc(value) {
                if (value === null || value === undefined) return '';
                return String(value).replace(/[&<>"']/g, c => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[c]));
            }

            async function loadFaqs() {
                faqs = await api('/api/admin/content/faqs');
                const container = document.getElementById('faqsList');

                if (faqs.length === 0) {
                    container.innerHTML = `<div class="bg-white rounded-lg border p-6 text-center text-gray-500 text-sm"><p>No FAQs yet. Add one to get started.</p></div>`;
                    return;
                }

                container.innerHTML = faqs.map(faq => `
                    <div class="bg-white rounded-lg border shadow-sm p-4 cursor-pointer hover:border-brand-primary/50 transition-colors" data-faq-id="${faq.id}">
                        <div class="flex items-start gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h3 class="font-semibold text-gray-900">${esc(faq.question)}</h3>
                                    ${faq.isActive
                                        ? '<span class="inline-flex px-2 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Active</span>'
                                        : '<span class="inline-flex px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Inactive</span>'}
                                </div>
                                <p class="text-xs text-gray-400 mt-1">${esc(faq.category || 'General')} &middot; Order ${faq.displayOrder}</p>
                            </div>
                            <svg class="w-4 h-4 text-gray-400 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </div>
                    </div>
                `).join('');

                container.querySelectorAll('[data-faq-id]').forEach(el => {
                    el.addEventListener('click', () => openEditor(el.dataset.faqId));
                });
            }

            function openEditor(id) {
                editingId = id || null;
                document.getElementById('modalTitle').textContent = id ? 'Edit FAQ' : 'New FAQ';
                document.getElementById('deleteFaqBtnWrap').classList.toggle('hidden', !id);

                if (id) {
                    const faq = faqs.find(f => f.id === id);
                    if (!faq) return;
                    document.getElementById('fQuestion').value = faq.question || '';
                    document.getElementById('fCategory').value = faq.category || '';
                    document.getElementById('fAnswer').value = faq.answer || '';
                    document.getElementById('fOrder').value = faq.displayOrder ?? 0;
                    document.getElementById('fActive').checked = faq.isActive;
                } else {
                    document.getElementById('fQuestion').value = '';
                    document.getElementById('fCategory').value = '';
                    document.getElementById('fAnswer').value = '';
                    document.getElementById('fOrder').value = '0';
                    document.getElementById('fActive').checked = true;
                }
                document.getElementById('faqModal').classList.remove('hidden');
            }

            function payload() {
                return JSON.stringify({
                    question: document.getElementById('fQuestion').value,
                    answer: document.getElementById('fAnswer').value,
                    category: document.getElementById('fCategory').value,
                    displayOrder: parseInt(document.getElementById('fOrder').value || '0', 10),
                    isActive: document.getElementById('fActive').checked
                });
            }

            function bindModal() {
                const modal = document.getElementById('faqModal');
                modal.querySelectorAll('[data-close-modal]').forEach(el => el.addEventListener('click', () => modal.classList.add('hidden')));

                document.getElementById('btnSaveFaq').addEventListener('click', async () => {
                    const options = {
                        method: editingId ? 'PUT' : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: payload()
                    };
                    const path = editingId ? '/api/admin/content/faqs/' + editingId : '/api/admin/content/faqs';
                    try {
                        await api(path, options);
                        modal.classList.add('hidden');
                        await loadFaqs();
                    } catch (err) { alert(err.message); }
                });

                document.getElementById('btnDeleteFaq').addEventListener('click', async () => {
                    if (!editingId) return;
                    if (!confirm('Delete this FAQ?')) return;
                    try {
                        await api('/api/admin/content/faqs/' + editingId, { method: 'DELETE' });
                        modal.classList.add('hidden');
                        await loadFaqs();
                    } catch (err) { alert(err.message); }
                });
            }

            document.getElementById('btnNewFaq').addEventListener('click', () => openEditor(null));
            bindModal();
            loadFaqs();
        })();
    </script>
}
