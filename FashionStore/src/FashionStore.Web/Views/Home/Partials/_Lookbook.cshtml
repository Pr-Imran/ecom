@model LookbookDto?

@if (Model is null)
{
    return;
}

<section class="mt-8 md:mt-12">
    <div class="container mx-auto px-4">
        <div class="relative rounded-brand overflow-hidden">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="w-full aspect-[4/3] md:aspect-[21/9] object-cover"
                     loading="lazy"
                     width="1280"
                     height="550"
                     onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
                <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent"></div>
            }
            else
            {
                <div class="w-full aspect-[4/3] md:aspect-[21/9] bg-brand-primary flex items-center"></div>
            }

            <div class="absolute inset-0 flex items-center">
                <div class="px-6 md:px-12 text-white max-w-xl">
                    <h2 class="text-2xl md:text-4xl font-bold leading-tight">@Model.Title</h2>
                    @if (!string.IsNullOrEmpty(Model.Subtitle))
                    {
                        <p class="mt-3 text-white/85 text-sm md:text-base">@Model.Subtitle</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.LinkText))
                    {
                        <a href="@(Model.LinkUrl ?? "#")"
                           class="mt-6 inline-flex items-center justify-center px-6 py-3 bg-white text-brand-primary font-semibold rounded-brand hover:bg-gray-100 transition-colors text-sm min-h-[44px]">
                            @Model.LinkText
                            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
