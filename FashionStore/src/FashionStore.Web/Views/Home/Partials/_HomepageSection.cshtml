@model HomePageSectionData

<section class="container mx-auto px-4 mt-6 md:mt-10">
    @if (Model.SectionType == "custom")
    {
        @if (!string.IsNullOrEmpty(Model.Html))
        {
            <div class="prose prose-brand max-w-3xl mx-auto text-brand-text-primary">
                @Html.Raw(Model.Html)
            </div>
        }
    }
    else
    {
        <div class="text-center mb-6">
            <h2 class="text-2xl md:text-3xl font-bold text-brand-text-primary">@Model.Title</h2>
            @if (!string.IsNullOrEmpty(Model.Subtitle))
            {
                <p class="text-sm text-brand-text-muted mt-1">@Model.Subtitle</p>
            }
        </div>
    }
</section>
