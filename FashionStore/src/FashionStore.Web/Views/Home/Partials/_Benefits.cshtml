@model IReadOnlyList<BenefitDto>

@if (Model.Count == 0)
{
    return;
}

@{
    string GetIconPath(string iconName)
    {
        return iconName.ToLowerInvariant() switch
        {
            "truck" => "M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1",
            "refresh" => "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
            "shield" => "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
            "headset" => "M3 10h1m16 0h-1M3 10a9 9 0 0118 0m-18 0v6a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3zm18 0v6a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3z",
            "tag" => "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z",
            "sparkle" => "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L2.98 10.1c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
            "lock" => "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
            _ => "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        };
    }
}

<section class="mt-8 md:mt-12">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
            @foreach (var benefit in Model)
            {
                <div class="flex flex-col items-center text-center p-5 bg-white border border-brand-border rounded-brand">
                    <div class="w-12 h-12 rounded-full bg-brand-surface border border-brand-border flex items-center justify-center mb-3">
                        @if (!string.IsNullOrEmpty(benefit.Icon) && benefit.Icon.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="@benefit.Icon" alt="" class="w-6 h-6 object-contain" loading="lazy" width="24" height="24" />
                        }
                        else
                        {
                            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@GetIconPath(benefit.Icon)" />
                            </svg>
                        }
                    </div>
                    <h3 class="text-sm font-bold text-brand-text-primary">@benefit.Title</h3>
                    <p class="text-xs text-brand-text-muted mt-1 leading-relaxed">@benefit.Description</p>
                </div>
            }
        </div>
    </div>
</section>
