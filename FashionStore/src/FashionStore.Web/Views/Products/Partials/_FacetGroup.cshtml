@model FacetGroupDto
@{
    var query = (ProductListQuery?)ViewData["Query"] ?? new ProductListQuery();
}
<div class="facet-group py-4">
    <h3 class="text-sm font-semibold text-brand-text-primary mb-2">@Model.Label</h3>
    <div class="space-y-0.5">
        @foreach (var value in Model.Values)
        {
            var href = Model.MultiSelect
                ? CatalogUrlBuilder.ToggleMulti(query, Model.Key, value.Value)
                : CatalogUrlBuilder.ToggleSingle(query, Model.Key, value.Value);
            var isSelected = value.Selected;
            if (Model.Key == "colour")
            {
                <a href="@href"
                   class="facet-option @(isSelected ? "facet-option-selected" : "")"
                   data-catalog-link>
                    <span class="flex items-center gap-2 min-w-0">
                        <span class="inline-block w-3.5 h-3.5 rounded-full border border-brand-border flex-shrink-0"></span>
                        <span class="truncate">@value.Label</span>
                    </span>
                    <span class="facet-count">@value.Count</span>
                </a>
            }
            else
            {
                <a href="@href"
                   class="facet-option @(isSelected ? "facet-option-selected" : "")"
                   data-catalog-link>
                    <span class="flex items-center gap-2 min-w-0">
                        @if (Model.MultiSelect)
                        {
                            <span class="w-4 h-4 border @(isSelected ? "border-brand-primary bg-brand-primary text-white" : "border-gray-300") rounded flex-shrink-0 inline-flex items-center justify-center">
                                @if (isSelected)
                                {
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                                    </svg>
                                }
                            </span>
                        }
                        <span class="truncate">@value.Label</span>
                    </span>
                    <span class="facet-count">@value.Count</span>
                </a>
            }
        }
    </div>
</div>
