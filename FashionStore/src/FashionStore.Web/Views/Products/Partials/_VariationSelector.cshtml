@model ProductDetailsData
@{
    var options = Model.Variations.AvailableOptions;
}

@foreach (var option in options)
{
    var isColour = option.Values.Any(v => !string.IsNullOrWhiteSpace(v.HexColour));
    <div class="mb-5" data-option-group data-option-slug="@option.AttributeSlug">
        <div class="flex items-center justify-between mb-2.5">
            <h3 class="text-sm font-semibold text-brand-text-primary">@option.AttributeName</h3>
            <span class="text-xs text-brand-text-muted" data-selected-label>Select @option.AttributeName.ToLowerInvariant()</span>
        </div>
        <div class="flex flex-wrap gap-2.5">
            @foreach (var value in option.Values)
            {
                if (isColour)
                {
                    <button type="button"
                            class="option-swatch"
                            style="background-color:@(value.HexColour ?? "#e5e7eb");"
                            data-option-value
                            data-option-slug="@option.AttributeSlug"
                            data-value-id="@value.Id"
                            data-value-slug="@value.Slug"
                            data-available="@(value.IsAvailable ? "true" : "false")"
                            title="@value.Name"
                            aria-pressed="false"
                            aria-label="@value.Name"
                            @(value.IsAvailable ? "" : "disabled")>
                        <span class="sr-only">@value.Name</span>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="option-chip"
                            data-option-value
                            data-option-slug="@option.AttributeSlug"
                            data-value-id="@value.Id"
                            data-value-slug="@value.Slug"
                            data-available="@(value.IsAvailable ? "true" : "false")"
                            aria-pressed="false"
                            @(value.IsAvailable ? "" : "disabled")>
                        @(value.DisplayValue ?? value.Name)
                    </button>
                }
            }
        </div>
    </div>
}
