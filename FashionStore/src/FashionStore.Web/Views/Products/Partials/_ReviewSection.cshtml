@model FashionStore.Application.DTOs.Reviews.ReviewListResultDto
@{
    var slug = (string?)ViewData["ProductSlug"] ?? string.Empty;
    var productName = (string?)ViewData["ProductName"] ?? string.Empty;
    var isAuthenticated = ViewData["IsAuthenticated"] as bool? ?? false;
    var eligibility = ViewData["ReviewEligibility"] as FashionStore.Application.DTOs.Reviews.ReviewEligibilityDto;
    var canWrite = isAuthenticated && eligibility is { IsEligible: true };
    var alreadyReviewed = isAuthenticated && eligibility is { AlreadyReviewed: true };
    var summary = Model.Summary;
    var average = summary.AverageRating;
}

<div class="flex items-center justify-between">
    <h2 id="reviews-heading" class="text-lg font-bold text-brand-text-primary">Reviews</h2>
    <a asp-controller="Reviews" asp-action="Index" asp-route-slug="@slug"
       class="text-sm text-brand-primary font-medium hover:underline">View all @Model.TotalCount</a>
</div>

<div class="mt-4 grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-4 lg:gap-8">
    <!-- Summary -->
    <div class="flex sm:flex-col items-center sm:items-start gap-3 sm:gap-1">
        <span class="text-4xl font-bold text-brand-text-primary leading-none">@(average.HasValue ? average.Value.ToString("0.0") : "–")</span>
        <div>
            <div class="flex items-center gap-0.5">
                @for (var s = 1; s <= 5; s++)
                {
                    var isFilled = average.HasValue && s <= Math.Round(average.Value, MidpointRounding.AwayFromZero);
                    <svg class="w-4 h-4 @(isFilled ? "text-brand-accent" : "text-gray-300")" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/>
                    </svg>
                }
            </div>
            <p class="text-xs text-brand-text-muted mt-0.5">@Model.TotalCount review@(Model.TotalCount == 1 ? "" : "s")</p>
        </div>
    </div>

    <!-- Distribution -->
    <div class="space-y-1.5">
        @foreach (var bucket in summary.Distribution)
        {
            var percentage = bucket.Count == 0 ? 0 : (int)Math.Round(bucket.Count / (double)summary.Distribution.Max(d => d.Count) * 100);
            <div class="flex items-center gap-2">
                <span class="w-7 text-xs font-semibold text-brand-text-muted flex items-center gap-0.5">
                    @bucket.Star
                    <svg class="w-3 h-3 fill-current text-brand-accent" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/>
                    </svg>
                </span>
                <div class="flex-1 h-2 rounded-full bg-gray-100 overflow-hidden">
                    <div class="h-full rounded-full bg-brand-accent @(bucket.Count == 0 ? "opacity-25" : "")" style="width: @percentage%"></div>
                </div>
                <span class="w-6 text-right text-xs text-brand-text-muted">@bucket.Count</span>
            </div>
        }
    </div>
</div>

<!-- Recent reviews -->
@if (Model.Items.Count > 0)
{
    <div class="mt-6 space-y-4">
        @foreach (var review in Model.Items.Take(2))
        {
            <div class="pt-4 border-t border-brand-border">
                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-0.5">
                        @for (var s = 1; s <= 5; s++)
                        {
                            <svg class="w-3.5 h-3.5 @(s <= review.Rating ? "text-brand-accent" : "text-gray-300")" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/>
                            </svg>
                        }
                    </div>
                    <span class="text-xs font-semibold text-brand-text-primary">@review.DisplayName</span>
                    @if (review.IsVerifiedPurchase)
                    {
                        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-full text-[0.625rem] font-bold bg-emerald-50 text-emerald-700">
                            <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                            Verified
                        </span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(review.Title))
                {
                    <h3 class="text-sm font-semibold text-brand-text-primary mt-1">@review.Title</h3>
                }
                <p class="text-sm text-gray-600 mt-0.5 line-clamp-2">@review.Body</p>
            </div>
        }
    </div>
}

<!-- CTA -->
<div class="mt-6 flex flex-col sm:flex-row gap-3">
    @if (canWrite)
    {
        <a asp-controller="Reviews" asp-action="Write" asp-route-slug="@slug" class="btn-primary">Write a review</a>
    }
    else if (alreadyReviewed)
    {
        <span class="text-sm text-brand-text-muted self-center">You have already reviewed this product.</span>
    }
    else if (isAuthenticated)
    {
        <span class="text-sm text-brand-text-muted self-center">@(eligibility?.ErrorMessage ?? string.Empty)</span>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn-outline">Log in to write a review</a>
    }
    <a asp-controller="Reviews" asp-action="Index" asp-route-slug="@slug" class="btn-outline">Read all reviews</a>
</div>
