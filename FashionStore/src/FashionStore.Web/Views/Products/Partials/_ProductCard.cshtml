@model ProductListItemDto
@{
    var listMode = ViewData["ListMode"] is bool b && b;
    var imageUrl = Model.ImageCardUrl ?? Model.ImageUrl ?? "/images/placeholder.svg";
    var showRating = Model.ReviewCount > 0;
}

@if (listMode)
{
    <a href="/products/@Model.Slug" class="group flex gap-4 bg-white border border-brand-border rounded-brand p-3" aria-label="@Model.Name">
        <div class="relative w-28 sm:w-36 aspect-[4/5] rounded-brand-sm overflow-hidden bg-brand-surface flex-shrink-0">
            <img src="@imageUrl"
                 alt="@(Model.ImageAltText ?? Model.Name)"
                 class="w-full h-full object-cover transition-transform duration-brand group-hover:scale-105"
                 loading="lazy"
                 width="144"
                 height="180"
                 onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
        </div>
        <div class="flex flex-col justify-center min-w-0">
            @if (!string.IsNullOrEmpty(Model.BrandName))
            {
                <div class="text-xs uppercase tracking-wide text-brand-text-muted font-medium">@Model.BrandName</div>
            }
            <h3 class="text-sm font-medium text-brand-text-primary line-clamp-2 leading-snug">@Model.Name</h3>
            <div class="inline-flex items-baseline gap-1.5 flex-wrap mt-1">
                <span class="price-current">$@Model.Price.ToString("N2")</span>
                @if (Model.CompareAtPrice.HasValue && Model.CompareAtPrice.Value > Model.Price)
                {
                    <span class="price-original">$@Model.CompareAtPrice.Value.ToString("N2")</span>
                }
                @if (Model.DiscountPercent.HasValue && Model.DiscountPercent.Value > 0)
                {
                    <span class="price-discount">-@Model.DiscountPercent%</span>
                }
            </div>
            @if (showRating)
            {
                <div class="flex items-center gap-1 mt-1.5 text-xs text-brand-text-muted" aria-label="Rating @Model.AverageRating.ToString("0.0") out of 5">
                    <svg class="w-3.5 h-3.5 text-brand-accent" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/>
                    </svg>
                    <span class="font-medium text-brand-text-primary">@Model.AverageRating.ToString("0.0")</span>
                    <span>(@Model.ReviewCount)</span>
                </div>
            }
            @if (!Model.IsInStock)
            {
                <span class="badge badge-danger mt-2 self-start">Sold out</span>
            }
            else if (Model.IsLowStock)
            {
                <span class="badge badge-warning mt-2 self-start">Low stock</span>
            }
        </div>
    </a>
}
else
{
    <a href="/products/@Model.Slug" class="group block" aria-label="@Model.Name">
        <div class="relative aspect-[4/5] rounded-brand-sm overflow-hidden bg-brand-surface border border-brand-border">
            <img src="@imageUrl"
                 alt="@(Model.ImageAltText ?? Model.Name)"
                 class="w-full h-full object-cover transition-transform duration-brand group-hover:scale-105"
                 loading="lazy"
                 width="400"
                 height="500"
                 onerror="this.onerror=null;this.src='/images/placeholder.svg';" />

            @if (Model.DiscountPercent.HasValue && Model.DiscountPercent.Value > 0)
            {
                <span class="absolute top-2 left-2 badge badge-danger">-@Model.DiscountPercent%</span>
            }
            @if (Model.IsNew)
            {
                <span class="absolute top-2 @(Model.DiscountPercent.HasValue && Model.DiscountPercent.Value > 0 ? "left-16" : "left-2") badge badge-neutral">New</span>
            }
            @if (!Model.IsInStock)
            {
                <span class="absolute bottom-2 left-2 right-2 text-center text-xs font-semibold bg-white/90 text-gray-700 py-1.5 rounded-brand-sm">Sold out</span>
            }
            else if (Model.IsLowStock)
            {
                <span class="absolute top-2 right-2 badge badge-warning">Low stock</span>
            }
        </div>

        <div class="mt-2 space-y-1">
            @if (!string.IsNullOrEmpty(Model.BrandName))
            {
                <div class="text-xs uppercase tracking-wide text-brand-text-muted font-medium">@Model.BrandName</div>
            }
            <h3 class="text-sm font-medium text-brand-text-primary line-clamp-2 leading-snug">@Model.Name</h3>

            @if (showRating)
            {
                <div class="flex items-center gap-1 text-xs text-brand-text-muted" aria-label="Rating @Model.AverageRating.ToString("0.0") out of 5">
                    <svg class="w-3.5 h-3.5 text-brand-accent" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/>
                    </svg>
                    <span class="font-medium text-brand-text-primary">@Model.AverageRating.ToString("0.0")</span>
                    <span>(@Model.ReviewCount)</span>
                </div>
            }

            <div class="inline-flex items-baseline gap-1.5 flex-wrap">
                <span class="price-current">$@Model.Price.ToString("N2")</span>
                @if (Model.CompareAtPrice.HasValue && Model.CompareAtPrice.Value > Model.Price)
                {
                    <span class="price-original">$@Model.CompareAtPrice.Value.ToString("N2")</span>
                }
            </div>

            @if (Model.Colours.Count > 0)
            {
                <div class="flex items-center gap-1.5 pt-0.5" aria-label="Available colours">
                    @foreach (var colour in Model.Colours)
                    {
                        <span class="inline-block w-3.5 h-3.5 rounded-full border border-brand-border"
                              style="background-color: @(colour.HexColour ?? "#e5e7eb");"
                              title="@colour.Name"></span>
                    }
                </div>
            }
        </div>
    </a>
}
