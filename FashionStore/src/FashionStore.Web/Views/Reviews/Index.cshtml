@model FashionStore.Web.Models.ReviewPageViewModel
@{
    ViewData["Title"] = $"Reviews for {Model.Product.Name}";
    ViewData["HideMobileHeader"] = true;
    ViewData["HideBottomNav"] = true;
    var summary = Model.Reviews.Summary;
    var average = summary.AverageRating;
    var total = summary.ReviewCount;
    var maxBucket = summary.Distribution.Count == 0 ? 0 : summary.Distribution.Max(d => d.Count);
    var sort = string.IsNullOrWhiteSpace(Model.Query.Sort) ? "recent" : Model.Query.Sort.ToLowerInvariant();
    var activeRating = Model.Query.Rating;
    var photosOnly = Model.Query.HasPhotos ?? false;
    var canWrite = Model.IsAuthenticated && Model.Eligibility is { IsEligible: true };
    var alreadyReviewed = Model.IsAuthenticated && Model.Eligibility is { AlreadyReviewed: true };
}

@section Styles {
    <style>
        .review-appbar { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,0.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-brand-border, #e5e7eb); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .review-card { border: 1px solid var(--color-brand-border, #e5e7eb); border-radius: 14px; background: #fff; overflow: hidden; }
        .star { width: 1rem; height: 1rem; flex-shrink: 0; }
        .star.lg { width: 1.5rem; height: 1.5rem; }
        .star.fill { color: var(--color-brand-accent, #E8A33D); }
        .star.empty { color: #D1D5DB; }
        .verified-pill { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.6875rem; font-weight: 700; background: #DCFCE7; color: #166534; }
        .filter-chip { padding: 0.375rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; border: 1px solid var(--color-brand-border, #e5e7eb); background: #fff; color: #4B5563; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem; }
        .filter-chip.active { background: var(--color-brand-primary, #8B4513); border-color: var(--color-brand-primary, #8B4513); color: #fff; }
        .review-thumb { width: 72px; height: 72px; border-radius: 10px; object-fit: cover; background: var(--color-brand-surface, #f9fafb); flex-shrink: 0; }
        .helpful-btn { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.375rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; border: 1px solid var(--color-brand-border, #e5e7eb); background: #fff; color: #4B5563; cursor: pointer; transition: all 0.15s; }
        .helpful-btn.active { background: #FEF3C7; border-color: #F59E0B; color: #92400E; }
        .helpful-btn:disabled { opacity: 0.6; cursor: default; }
        .sort-select { padding: 0.375rem 0.625rem; border-radius: 0.5rem; font-size: 0.75rem; font-weight: 600; border: 1px solid var(--color-brand-border, #e5e7eb); background: #fff; color: #4B5563; }
        .bar-track { height: 0.375rem; border-radius: 999px; background: #F3F4F6; overflow: hidden; }
        .bar-fill { height: 100%; border-radius: 999px; background: var(--color-brand-accent, #E8A33D); }
    </style>
}

<!-- App-like header -->
<header class="review-appbar lg:hidden" role="banner">
    <div class="flex items-center justify-between gap-2 px-3 py-2">
        <div class="flex items-center gap-1 min-w-0">
            <button type="button" class="btn-icon -ml-2" onclick="history.back()" aria-label="Go back">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <span class="text-base font-bold text-brand-text-primary truncate">Reviews</span>
        </div>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-bold text-brand-primary tracking-tight flex-shrink-0">FashionStore</a>
    </div>
</header>

<div class="container mx-auto px-4 pt-4 pb-16 safe-bottom lg:pt-8 max-w-3xl">
    <!-- Desktop heading -->
    <div class="hidden lg:flex items-center justify-between mb-6">
        <div>
            <p class="text-sm text-brand-text-muted">
                <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Product.Slug" class="hover:underline">@Model.Product.Name</a>
            </p>
            <h1 class="text-2xl font-bold text-brand-text-primary mt-1">Reviews</h1>
        </div>
        @if (canWrite)
        {
            <a asp-action="Write" asp-route-slug="@Model.Product.Slug" class="btn-primary">Write a review</a>
        }
        else if (alreadyReviewed)
        {
            <span class="text-sm text-brand-text-muted">You have reviewed this product.</span>
        }
        else if (Model.IsAuthenticated)
        {
            <span class="text-sm text-brand-text-muted">@(Model.Eligibility?.ErrorMessage ?? string.Empty)</span>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn-outline">Log in to write a review</a>
        }
    </div>

    @if (TempData["ReviewMessage"] != null)
    {
        <div class="alert-success mb-4" role="alert"><p class="text-sm">@TempData["ReviewMessage"]</p></div>
    }
    @if (TempData["ReviewError"] != null)
    {
        <div class="alert-danger mb-4" role="alert"><p class="text-sm">@TempData["ReviewError"]</p></div>
    }

    <!-- Mobile summary card -->
    <div class="review-card p-4 mb-4 lg:hidden">
        <p class="text-xs text-brand-text-muted">@Model.Product.Name</p>
        <div class="flex items-center justify-between mt-2">
            <div class="flex items-end gap-2">
                <span class="text-4xl font-bold text-brand-text-primary leading-none">@(average.HasValue ? average.Value.ToString("0.0") : "–")</span>
                <div class="pb-0.5">
                    <div class="flex items-center gap-0.5">
                        @for (var s = 1; s <= 5; s++)
                        {
                            <svg class="star @(s <= Math.Round(average ?? 0) ? "fill" : "empty")" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/>
                            </svg>
                        }
                    </div>
                    <p class="text-xs text-brand-text-muted mt-0.5">@total review@(total == 1 ? "" : "s")</p>
                </div>
            </div>
            @if (canWrite)
            {
                <a asp-action="Write" asp-route-slug="@Model.Product.Slug" class="btn-primary">Write a review</a>
            }
        </div>

        <!-- Distribution bars -->
        <div class="mt-4 space-y-1.5">
            @foreach (var bucket in summary.Distribution.OrderByDescending(d => d.Star))
            {
                <a asp-action="Index" asp-route-slug="@Model.Product.Slug" asp-route-rating="@bucket.Star"
                   asp-route-sort="@sort" asp-route-hasPhotos="@(photosOnly ? "true" : null)"
                   class="flex items-center gap-2 text-xs @(activeRating == bucket.Star ? "font-bold text-brand-primary" : "text-brand-text-muted")" style="text-decoration: none;">
                    <span class="w-3 text-right">@bucket.Star</span>
                    <svg class="star fill" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/></svg>
                    <div class="bar-track flex-1"><div class="bar-fill" style="width: @(maxBucket == 0 ? 0 : bucket.Count * 100 / maxBucket)%"></div></div>
                    <span class="w-6 text-right">@bucket.Count</span>
                </a>
            }
        </div>
    </div>

    <!-- Sort + filters -->
    <div class="flex items-center justify-between gap-2 mb-3">
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar flex-1">
            <a asp-action="Index" asp-route-slug="@Model.Product.Slug" asp-route-sort="@sort"
               asp-route-hasPhotos="@(photosOnly ? "true" : null)"
               class="filter-chip @(activeRating == null ? "active" : "")">All</a>
            @for (var s = 5; s >= 1; s--)
            {
                <a asp-action="Index" asp-route-slug="@Model.Product.Slug" asp-route-sort="@sort"
                   asp-route-rating="@s" asp-route-hasPhotos="@(photosOnly ? "true" : null)"
                   class="filter-chip @(activeRating == s ? "active" : "")">@s star</a>
            }
            <a asp-action="Index" asp-route-slug="@Model.Product.Slug" asp-route-sort="@sort"
               asp-route-rating="@activeRating"
               asp-route-hasPhotos="@(photosOnly ? null : "true")"
               class="filter-chip @(photosOnly ? "active" : "")">With photos</a>
        </div>
        <select id="sortSelect" class="sort-select" aria-label="Sort reviews">
            <option value="recent" selected="@(sort == "recent")">Most recent</option>
            <option value="helpful" selected="@(sort == "helpful")">Most helpful</option>
            <option value="high" selected="@(sort == "high")">Highest rated</option>
            <option value="low" selected="@(sort == "low")">Lowest rated</option>
        </select>
    </div>

    <!-- Review list -->
    @if (Model.Reviews.Items.Count == 0)
    {
        <div class="review-card p-6 text-center">
            <p class="text-sm font-semibold text-brand-text-primary">No reviews found</p>
            <p class="text-xs text-brand-text-muted mt-1">No reviews match your filters yet.</p>
        </div>
    }
    else
    {
        foreach (var review in Model.Reviews.Items)
        {
            <article class="review-card p-4 mb-3" data-review-id="@review.ReviewId">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1">
                        @for (var s = 1; s <= 5; s++)
                        {
                            <svg class="star @(s <= review.Rating ? "fill" : "empty")" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/>
                            </svg>
                        }
                    </div>
                    <span class="text-xs text-brand-text-muted">@review.CreatedAtUtc.ToString("MMM d, yyyy")</span>
                </div>

                <div class="flex items-center gap-1.5 mt-2">
                    <span class="text-sm font-bold text-brand-text-primary">@review.DisplayName</span>
                    @if (review.IsVerifiedPurchase)
                    {
                        <span class="verified-pill">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
                            Verified Purchase
                        </span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(review.Title))
                {
                    <h3 class="text-sm font-bold text-brand-text-primary mt-2">@review.Title</h3>
                }
                @if (!string.IsNullOrWhiteSpace(review.Body))
                {
                    <p class="text-sm text-brand-text-secondary mt-1 whitespace-pre-line">@review.Body</p>
                }

                @if (review.Images.Count > 0)
                {
                    <div class="flex gap-2 mt-3 overflow-x-auto no-scrollbar">
                        @foreach (var image in review.Images)
                        {
                            <img class="review-thumb" src="@image.Url" alt="Review photo" loading="lazy" />
                        }
                    </div>
                }

                <div class="flex items-center justify-between mt-3 pt-3 border-t border-brand-border/60">
                    <button type="button" class="helpful-btn @(review.IsHelpful ? "active" : "")"
                            data-helpful data-review-id="@review.ReviewId" data-review-helpful="@(review.IsHelpful ? "true" : "false")"
                            @(Model.IsAuthenticated ? string.Empty : "disabled")>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20M7 20v-9.5M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5m5 0V5a2 2 0 00-2-2h-1v8"/></svg>
                        <span>Helpful</span>
                        <span data-helpful-count class="text-brand-text-muted">@review.HelpfulCount</span>
                    </button>
                </div>
            </article>
        }

        if (Model.Reviews.HasMore || Model.Reviews.Page > 1)
        {
            <nav class="flex items-center justify-between mt-5 text-sm" aria-label="Pagination">
                @if (Model.Reviews.Page > 1)
                {
                    <a asp-action="Index" asp-route-slug="@Model.Product.Slug" asp-route-sort="@sort"
                       asp-route-rating="@activeRating" asp-route-hasPhotos="@(photosOnly ? "true" : null)"
                       asp-route-page="@(Model.Reviews.Page - 1)" class="btn-outline">Previous</a>
                }
                else
                {
                    <span></span>
                }
                @if (Model.Reviews.HasMore)
                {
                    <a asp-action="Index" asp-route-slug="@Model.Product.Slug" asp-route-sort="@sort"
                       asp-route-rating="@activeRating" asp-route-hasPhotos="@(photosOnly ? "true" : null)"
                       asp-route-page="@(Model.Reviews.Page + 1)" class="btn-outline">Next</a>
                }
            </nav>
        }
    }

    @if (canWrite)
    {
        <div class="mt-6 lg:hidden">
            <a asp-action="Write" asp-route-slug="@Model.Product.Slug" class="btn-primary w-full">Write a review</a>
        </div>
    }

    @if (Model.IsAuthenticated)
    {
        <form id="helpful-csrf" method="post" class="hidden" aria-hidden="true">@Html.AntiForgeryToken()</form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var sortSelect = document.getElementById('sortSelect');
            if (sortSelect) {
                sortSelect.addEventListener('change', function () {
                    var url = new URL(window.location.href);
                    url.searchParams.set('sort', sortSelect.value);
                    url.searchParams.set('page', '1');
                    window.location = url.toString();
                });
            }

            @if (Model.IsAuthenticated)
            {
                <text>
                document.querySelectorAll('[data-helpful]').forEach(function (btn) {
                    btn.addEventListener('click', async function () {
                        var reviewId = btn.getAttribute('data-review-id');
                        var count = btn.querySelector('[data-helpful-count]');
                        btn.disabled = true;
                        try {
                            var form = document.getElementById('helpful-csrf');
                            var data = new FormData();
                            data.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);
                            var response = await fetch('/reviews/' + reviewId + '/helpful', {
                                method: 'POST',
                                body: data,
                                credentials: 'same-origin'
                            });
                            var payload = await response.json();
                            if (payload.success) {
                                btn.classList.toggle('active', payload.voted);
                                btn.setAttribute('data-review-helpful', payload.voted);
                                count.textContent = payload.helpfulCount;
                            }
                        } catch (e) { /* keep state */ }
                        btn.disabled = false;
                    });
                });
                </text>
            }
        })();
    </script>
}
