@model FashionStore.Web.Models.WriteReviewViewModel
@{
    ViewData["Title"] = "Write a Review";
    ViewData["HideMobileHeader"] = true;
    ViewData["HideBottomNav"] = true;
    var product = Model.Product;
}

@section Styles {
    <style>
        .write-appbar { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,0.94); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-brand-border, #e5e7eb); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .star-pick { width: 2.25rem; height: 2.25rem; color: #D1D5DB; cursor: pointer; transition: transform 0.12s, color 0.12s; }
        .star-pick.active { color: var(--color-brand-accent, #E8A33D); transform: scale(1.08); }
        .photo-thumb { width: 88px; height: 88px; border-radius: 12px; object-fit: cover; border: 1px solid var(--color-brand-border, #e5e7eb); background: var(--color-brand-surface, #f9fafb); flex-shrink: 0; }
        .photo-add { width: 88px; height: 88px; border-radius: 12px; border: 1.5px dashed #D1D5DB; background: #fff; color: #6B7280; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem; font-size: 0.6875rem; font-weight: 600; cursor: pointer; flex-shrink: 0; }
        .sticky-submit { position: sticky; bottom: 0; z-index: 20; background: rgba(255,255,255,0.94); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-top: 1px solid var(--color-brand-border, #e5e7eb); padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom)); }
    </style>
}

<!-- App-like header -->
<header class="write-appbar lg:hidden" role="banner">
    <div class="flex items-center justify-between gap-2 px-3 py-2">
        <div class="flex items-center gap-1">
            <button type="button" class="btn-icon -ml-2" onclick="history.back()" aria-label="Go back">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <span class="text-base font-bold text-brand-text-primary">Write a review</span>
        </div>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-bold text-brand-primary tracking-tight">FashionStore</a>
    </div>
</header>

<div class="container mx-auto px-4 pt-4 pb-32 safe-bottom lg:pt-8 max-w-xl">
    <!-- Desktop heading -->
    <div class="hidden lg:block mb-6">
        <p class="text-sm text-brand-text-muted">
            <a asp-controller="Products" asp-action="Details" asp-route-slug="@product.Slug" class="hover:underline">@product.Name</a>
        </p>
        <h1 class="text-2xl font-bold text-brand-text-primary mt-1">Write a review</h1>
    </div>

    @if (TempData["ReviewError"] != null)
    {
        <div class="alert-danger mb-4" role="alert"><p class="text-sm">@TempData["ReviewError"]</p></div>
    }

    <!-- Product card -->
    <section class="bg-white border border-brand-border rounded-brand p-4 mb-4">
        <div class="flex items-center gap-3">
            <div class="flex-1 min-w-0">
                <p class="text-sm font-bold text-brand-text-primary truncate">@product.Name</p>
                <span class="verified-pill inline-flex items-center gap-1 px-2 py-0.5 mt-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    Verified purchase
                </span>
            </div>
            <a asp-controller="Products" asp-action="Details" asp-route-slug="@product.Slug" class="text-sm text-brand-primary font-medium hover:underline flex-shrink-0">View product</a>
        </div>
    </section>

    <!-- Form -->
    <form asp-action="Submit" asp-controller="Reviews" method="post" enctype="multipart/form-data" id="reviewForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ProductId" value="@product.ProductId" />
        <input type="hidden" name="ProductSlug" value="@product.Slug" />

        <!-- Rating -->
        <section class="bg-white border border-brand-border rounded-brand p-4 mb-4">
            <h2 class="text-sm font-bold text-brand-text-primary mb-3">Your rating</h2>
            <div class="flex items-center gap-1" role="radiogroup" aria-label="Star rating" id="starPicker">
                @for (var s = 1; s <= 5; s++)
                {
                    <button type="button" class="star-pick @(s == 5 ? "active" : "")" data-star="@s" aria-label="@s star@s">
                        <svg class="w-full h-full" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.448a1 1 0 00-.363 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.368-2.448a1 1 0 00-1.175 0l-3.368 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.235 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z"/>
                        </svg>
                    </button>
                }
            </div>
            <input type="hidden" name="Rating" id="Rating" value="5" />
            <p class="text-xs text-brand-text-muted mt-2" id="ratingLabel">Excellent</p>
        </section>

        <!-- Title -->
        <section class="bg-white border border-brand-border rounded-brand p-4 mb-4">
            <label for="Title" class="form-label">Title <span class="text-brand-text-muted font-normal">(optional)</span></label>
            <input type="text" id="Title" name="Title" maxlength="200" class="form-input"
                   placeholder="Great quality and fit" />
        </section>

        <!-- Body -->
        <section class="bg-white border border-brand-border rounded-brand p-4 mb-4">
            <label for="Body" class="form-label">Review <span class="text-brand-text-muted font-normal">(min 10 characters)</span></label>
            <textarea id="Body" name="Body" rows="6" maxlength="4000" class="form-input resize-y"
                      placeholder="How did it fit? How is the quality? Would you recommend it?"></textarea>
        </section>

        <!-- Photos -->
        <section class="bg-white border border-brand-border rounded-brand p-4 mb-4">
            <h2 class="text-sm font-bold text-brand-text-primary mb-1">Add photos <span class="text-brand-text-muted font-normal">(optional, up to 6)</span></h2>
            <p class="text-xs text-brand-text-muted mb-3">JPG, PNG or WebP under 5 MB each.</p>
            <div class="flex gap-2 overflow-x-auto scrollbar-hide" id="photoPreview"></div>
            <input type="file" id="Photos" name="Photos" accept="image/jpeg,image/png,image/webp" multiple class="hidden" />
            <button type="button" id="addPhotoBtn" class="photo-add mt-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Add photo
            </button>
        </section>
    </form>

    <!-- Sticky submit -->
    <div class="sticky-submit lg:static lg:border-0 lg:p-0">
        <button type="submit" form="reviewForm" class="btn-primary w-full lg:w-auto">Submit review</button>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var labels = { 1: 'Poor', 2: 'Fair', 3: 'Good', 4: 'Great', 5: 'Excellent' };
            var stars = document.querySelectorAll('.star-pick');
            var ratingInput = document.getElementById('Rating');
            var ratingLabel = document.getElementById('ratingLabel');

            function setRating(value) {
                ratingInput.value = value;
                stars.forEach(function (star) {
                    star.classList.toggle('active', Number(star.getAttribute('data-star')) <= value);
                });
                ratingLabel.textContent = labels[value];
            }

            stars.forEach(function (star) {
                star.addEventListener('click', function () {
                    setRating(Number(star.getAttribute('data-star')));
                });
            });

            var fileInput = document.getElementById('Photos');
            var preview = document.getElementById('photoPreview');

            document.getElementById('addPhotoBtn').addEventListener('click', function () {
                fileInput.click();
            });

            fileInput.addEventListener('change', function () {
                preview.innerHTML = '';
                Array.from(fileInput.files || []).slice(0, 6).forEach(function (file) {
                    var url = URL.createObjectURL(file);
                    var img = document.createElement('img');
                    img.src = url;
                    img.className = 'photo-thumb';
                    img.alt = 'Selected photo';
                    preview.appendChild(img);
                });
            });

            document.getElementById('reviewForm').addEventListener('submit', function (e) {
                var body = document.getElementById('Body').value.trim();
                if (body.length < 10) {
                    e.preventDefault();
                    document.getElementById('Body').focus();
                    alert('Your review needs to be at least 10 characters.');
                    return;
                }
                if (fileInput.files && fileInput.files.length > 6) {
                    e.preventDefault();
                    alert('You can attach up to 6 photos per review.');
                }
            });
        })();
    </script>
}
