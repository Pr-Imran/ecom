@model FashionStore.Application.DTOs.Auth.ResetPasswordRequest
@{
    ViewData["Title"] = "Reset Password";
}

<div class="min-h-screen flex items-center justify-center py-8 px-4 bg-brand-surface">
    <div class="w-full max-w-md">
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-brand-primary">Reset Password</h1>
            <p class="mt-2 text-sm text-brand-text-muted">Create a new secure password</p>
        </div>

        <div class="card">
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
                {
                    foreach (var error in ViewData.ModelState[string.Empty].Errors)
                    {
                        <div class="alert-danger mb-4" role="alert">
                            <p class="text-sm">@error.ErrorMessage</p>
                        </div>
                    }
                }

                <form asp-action="ResetPassword" method="POST" class="space-y-5">
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div>
                        <label for="NewPassword" class="form-label">New Password</label>
                        <input asp-for="NewPassword" type="password" required minlength="8"
                               class="form-input" placeholder="Min. 8 characters" />
                        <span asp-validation-for="NewPassword" class="text-brand-danger text-sm mt-1"></span>
                        <p class="text-xs text-brand-text-muted mt-1">Use uppercase, lowercase, and numbers</p>
                    </div>

                    <button type="submit" class="btn-primary w-full">Reset Password</button>
                </form>

                <div class="mt-6 text-center">
                    <a asp-action="Login" class="text-sm text-brand-text-muted hover:text-brand-accent">
                        ← Back to login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
