@model FashionStore.Application.DTOs.Auth.ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="min-h-screen flex items-center justify-center py-8 px-4 bg-brand-surface">
    <div class="w-full max-w-md">
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-brand-primary">Forgot Password?</h1>
            <p class="mt-2 text-sm text-brand-text-muted">Enter your email to receive reset instructions</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success mb-4" role="alert">
                <p class="text-sm">@TempData["SuccessMessage"]</p>
            </div>
        }

        <div class="card">
            <div class="card-body">
                <form asp-action="ForgotPassword" method="POST" class="space-y-5">
                    <div>
                        <label for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" type="email" required class="form-input" placeholder="you@example.com" />
                        <p class="text-xs text-brand-text-muted mt-1 text-center">
                            If an account exists with this email, you'll receive password reset instructions.
                        </p>
                    </div>

                    <button type="submit" class="btn-primary w-full">Send Reset Link</button>
                </form>

                <div class="mt-6 text-center">
                    <a asp-action="Login" class="text-sm text-brand-text-muted hover:text-brand-accent">
                        ← Back to login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
