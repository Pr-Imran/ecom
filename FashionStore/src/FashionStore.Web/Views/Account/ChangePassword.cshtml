@model FashionStore.Application.DTOs.Auth.ChangePasswordRequest
@{
    ViewData["Title"] = "Change Password";
}

<div class="max-w-md mx-auto px-4 py-8">
    <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-brand-primary">Change Password</h1>
    </div>

    <div class="card">
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success mb-4" role="alert">
                    <p class="text-sm">@TempData["SuccessMessage"]</p>
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
            {
                foreach (var error in ViewData.ModelState[string.Empty].Errors)
                {
                    <div class="alert-danger mb-4" role="alert">
                        <p class="text-sm">@error.ErrorMessage</p>
                    </div>
                }
            }

            <form asp-action="ChangePassword" method="POST" class="space-y-5">
                <div>
                    <label for="CurrentPassword" class="form-label">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" required class="form-input" />
                    <span asp-validation-for="CurrentPassword" class="text-brand-danger text-sm mt-1"></span>
                </div>

                <div>
                    <label for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" type="password" required minlength="8" class="form-input" />
                    <span asp-validation-for="NewPassword" class="text-brand-danger text-sm mt-1"></span>
                </div>

                <div class="pt-2">
                    <button type="submit" class="btn-primary w-full">Update Password</button>
                    <a asp-action="Index" asp-controller="Home" class="btn-outline w-full mt-3 inline-block text-center">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
