@model bool
@{
    ViewData["Title"] = "Confirm Email";
}

<div class="min-h-screen flex items-center justify-center py-8 px-4 bg-brand-surface">
    <div class="w-full max-w-md">
        <div class="card">
            <div class="card-body text-center">
                @if (Model)
                {
                    <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-brand-primary mb-2">Email Confirmed</h2>
                    <p class="text-brand-text-muted mb-4">Thank you for confirming your email. You can now sign in.</p>
                    <a asp-action="Login" class="btn-primary inline-block">Sign In</a>
                }
                else
                {
                    <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-brand-primary mb-2">Confirmation Failed</h2>
                    <p class="text-brand-text-muted mb-4">The confirmation link may have expired. Please request a new confirmation email.</p>
                    <a asp-action="Contact" class="btn-primary inline-block">Contact Support</a>
                }
            </div>
        </div>
    </div>
</div>
