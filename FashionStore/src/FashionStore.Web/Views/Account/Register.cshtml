@model FashionStore.Application.DTOs.Auth.RegisterRequest
@{
    ViewData["Title"] = "Create Account";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="min-h-screen flex items-center justify-center py-8 px-4 bg-brand-surface">
    <div class="w-full max-w-md">
        <div class="text-center mb-6">
            <h1 class="text-3xl font-bold text-brand-primary">Create Account</h1>
            <p class="mt-2 text-sm text-brand-text-muted">Start your fashion journey</p>
        </div>

        <div class="card">
            <div class="card-body">
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    foreach (var key in ViewData.ModelState.Keys)
                    {
                        foreach (var error in ViewData.ModelState[key].Errors)
                        {
                            <div class="alert-danger mb-4" role="alert">
                                <p class="text-sm">@error.ErrorMessage</p>
                            </div>
                        }
                    }
                }

                <form asp-action="Register" method="POST" class="space-y-5">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" type="text" class="form-input" placeholder="First" />
                        </div>
                        <div>
                            <label for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" type="text" class="form-input" placeholder="Last" />
                        </div>
                    </div>

                    <div>
                        <label for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" autocomplete="email" required class="form-input" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-brand-danger text-sm mt-1"></span>
                    </div>

                    <div>
                        <label for="PhoneNumber" class="form-label">Phone (optional)</label>
                        <input asp-for="PhoneNumber" type="tel" class="form-input" placeholder="+1 (555) 000-0000" />
                    </div>

                    <div>
                        <label for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" autocomplete="new-password" required minlength="8"
                               class="form-input" placeholder="Min. 8 characters" />
                        <span asp-validation-for="Password" class="text-brand-danger text-sm mt-1"></span>
                        <p class="text-xs text-brand-text-muted mt-1">Must contain uppercase, lowercase, number</p>
                    </div>

                    <div class="flex items-center">
                        <input asp-for="AcceptTerms" type="checkbox" required class="form-checkbox" />
                        <label asp-for="AcceptTerms" class="ml-2 text-sm text-brand-text-primary">
                            I agree to the <a href="#" class="text-brand-accent hover:underline">Terms</a> and <a href="#" class="text-brand-accent hover:underline">Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" class="btn-primary w-full">Create Account</button>
                </form>

                <div class="mt-6 text-center">
                    <p class="text-sm text-brand-text-muted">
                        Already have an account?
                        <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="text-brand-accent font-medium hover:underline">
                            Sign in
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
