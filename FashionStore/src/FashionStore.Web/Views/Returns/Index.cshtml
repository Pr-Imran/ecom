@model FashionStore.Application.DTOs.Returns.CustomerReturnListResultDto
@using FashionStore.Domain.Enums
@{
    ViewData["Title"] = "My Returns";
    ViewData["HideMobileHeader"] = true;
    var appliedStatus = (ReturnStatus?)ViewData["AppliedStatus"];
    var pageSize = Model.PageSize;
}

@section Styles {
    <style>
        .return-appbar { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,0.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-brand-border, #e5e7eb); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .return-card { border: 1px solid var(--color-brand-border, #e5e7eb); border-radius: 14px; background: #fff; overflow: hidden; }
        .return-thumb { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; background: var(--color-brand-surface, #f9fafb); flex-shrink: 0; }
        .status-pill { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.125rem 0.625rem; border-radius: 999px; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; }
        .status-requested, .status-underreview { background: #FEF3C7; color: #92400E; }
        .status-approved, .status-awaitingshipment { background: #DBEAFE; color: #1E40AF; }
        .status-intransit, .status-received { background: #EDE9FE; color: #5B21B6; }
        .status-inspected, .status-refundpending { background: #E0E7FF; color: #3730A3; }
        .status-refunded, .status-exchanged, .status-closed { background: #DCFCE7; color: #166534; }
        .status-rejected { background: #FEE2E2; color: #991B1B; }
        .filter-chip { padding: 0.375rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; border: 1px solid var(--color-brand-border, #e5e7eb); background: #fff; color: #4B5563; }
        .filter-chip.active { background: var(--color-brand-primary, #8B4513); border-color: var(--color-brand-primary, #8B4513); color: #fff; }
    </style>
}

<!-- App-like header -->
<header class="return-appbar lg:hidden" role="banner">
    <div class="flex items-center justify-between gap-2 px-3 py-2">
        <div class="flex items-center gap-1">
            <button type="button" class="btn-icon -ml-2" onclick="history.back()" aria-label="Go back">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <span class="text-base font-bold text-brand-text-primary">My Returns</span>
            @if (Model.TotalCount > 0)
            {
                <span class="text-sm text-brand-text-muted">(@Model.TotalCount)</span>
            }
        </div>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-bold text-brand-primary tracking-tight">
            FashionStore
        </a>
    </div>
</header>

<!-- Desktop heading -->
<div class="hidden lg:block container mx-auto px-4 pt-6">
    <h1 class="text-2xl font-bold text-brand-text-primary">My Returns</h1>
</div>

<div class="container mx-auto px-4 pt-3 pb-10 safe-bottom lg:pt-6">
    <!-- Status filter -->
    <div class="flex gap-2 overflow-x-auto scrollbar-hide -mx-4 px-4">
        <a href="@Url.Action("Index")" class="filter-chip @(appliedStatus is null ? "active" : "")">All</a>
        @foreach (var status in new[]
        {
            ReturnStatus.Requested,
            ReturnStatus.UnderReview,
            ReturnStatus.Approved,
            ReturnStatus.InTransit,
            ReturnStatus.Received,
            ReturnStatus.Inspected,
            ReturnStatus.Refunded,
            ReturnStatus.Exchanged,
            ReturnStatus.Rejected,
            ReturnStatus.Closed
        })
        {
            <a href="@Url.Action("Index", new { status })" class="filter-chip @(appliedStatus == status ? "active" : "")">
                @(status == ReturnStatus.AwaitingShipment ? "Awaiting shipment" : status.ToString())
            </a>
        }
    </div>

    @if (TempData["ReturnMessage"] != null)
    {
        <div class="alert-success mt-4" role="alert"><p class="text-sm">@TempData["ReturnMessage"]</p></div>
    }
    @if (TempData["ReturnError"] != null)
    {
        <div class="alert-danger mt-4" role="alert"><p class="text-sm">@TempData["ReturnError"]</p></div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-16">
            <div class="mx-auto mb-4 w-20 h-20 text-brand-text-muted">
                <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
            </div>
            <h2 class="text-lg font-bold text-brand-text-primary">No returns yet</h2>
            <p class="text-sm text-brand-text-muted mt-2 max-w-sm mx-auto">
                When you start a return or exchange it will show up here so you can follow its progress.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn-primary mt-6 px-6 py-3 text-center">Start shopping</a>
        </div>
    }
    else
    {
        <ul class="mt-4 space-y-4">
            @foreach (var item in Model.Items)
            {
                <li>
                    <a asp-action="Details" asp-route-returnNumber="@item.ReturnNumber" class="return-card block hover:border-brand-primary transition-colors">
                        <div class="px-4 pt-3 pb-2 flex items-center justify-between gap-2">
                            <span class="text-xs font-bold text-brand-text-primary">@item.ReturnNumber</span>
                            <span class="status-pill status-@item.Status.ToLowerInvariant()">@(item.Status == "AwaitingShipment" ? "Awaiting shipment" : item.Status)</span>
                        </div>
                        <div class="px-4 pb-2 flex items-center gap-3">
                            @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                            {
                                <img src="@item.ThumbnailUrl" alt="@item.FirstItemName" class="return-thumb" loading="lazy" />
                            }
                            else
                            {
                                <div class="return-thumb flex items-center justify-center text-brand-text-muted">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                    </svg>
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-brand-text-primary truncate">@item.FirstItemName</p>
                                <p class="text-xs text-brand-text-muted">Order @item.OrderNumber · @item.ItemCount item(s)@(item.IsExchange ? " · Exchange" : "")</p>
                            </div>
                            <div class="text-right flex-shrink-0">
                                @if (item.RefundableAmount > 0m)
                                {
                                    <p class="text-sm font-bold text-brand-text-primary">@item.RefundableAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</p>
                                }
                                <p class="text-[11px] text-brand-text-muted">@item.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</p>
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>

        @if (Model.HasMore || Model.Page > 1)
        {
            var totalPages = Math.Max(1, (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize));
            <nav class="mt-6 flex items-center justify-between" aria-label="Pagination">
                @if (Model.Page > 1)
                {
                    <a href="@Url.Action("Index", new { status = appliedStatus, page = Model.Page - 1, pageSize })" class="btn-icon text-brand-text-primary" aria-label="Previous page">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </a>
                }
                else
                {
                    <span></span>
                }
                <span class="text-xs text-brand-text-muted">Page @Model.Page of @totalPages</span>
                @if (Model.HasMore)
                {
                    <a href="@Url.Action("Index", new { status = appliedStatus, page = Model.Page + 1, pageSize })" class="btn-icon text-brand-text-primary" aria-label="Next page">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                }
                else
                {
                    <span></span>
                }
            </nav>
        }
    }
</div>
