@model FashionStore.Web.Models.ReturnStartViewModel
@{
    ViewData["Title"] = "Start a Return";
    ViewData["HideMobileHeader"] = true;
    var order = Model.Order;
    var guestToken = Model.GuestAccessToken;
    var reasons = Model.Reasons;
}

@section Styles {
    <style>
        .wizard-appbar { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,0.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-brand-border, #e5e7eb); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .step-dot { width: 28px; height: 28px; border-radius: 999px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; border: 1px solid var(--color-brand-border, #e5e7eb); color: #9CA3AF; background: #fff; }
        .step-dot.active { background: var(--color-brand-primary, #8B4513); border-color: var(--color-brand-primary, #8B4513); color: #fff; }
        .step-dot.done { background: #D1FAE5; border-color: #6EE7B7; color: #166534; }
        .reason-card { border: 1px solid var(--color-brand-border, #e5e7eb); border-radius: 14px; padding: 1rem; background: #fff; cursor: pointer; transition: border-color .15s, background .15s; }
        .reason-card.selected { border-color: var(--color-brand-primary, #8B4513); background: #FFFBF5; box-shadow: 0 0 0 1px var(--color-brand-primary, #8B4513); }
        .item-row { border: 1px solid var(--color-brand-border, #e5e7eb); border-radius: 14px; padding: 0.875rem; background: #fff; }
        .thumb { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; background: var(--color-brand-surface, #f9fafb); flex-shrink: 0; }
        .qty-btn { width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--color-brand-border, #e5e7eb); background: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.125rem; font-weight: 700; color: var(--color-brand-text-primary); }
        .qty-btn:disabled { opacity: .35; }
        .sticky-submit { position: sticky; bottom: 0; z-index: 20; background: rgba(255,255,255,0.94); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-top: 1px solid var(--color-brand-border, #e5e7eb); padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom)); }
        .step-body { display: none; }
        .step-body.active { display: block; }
        .exchange-pill { border: 1px solid var(--color-brand-border, #e5e7eb); border-radius: 999px; padding: 0.5rem 0.875rem; font-size: 0.8125rem; font-weight: 600; cursor: pointer; }
        .exchange-pill.selected { background: var(--color-brand-primary, #8B4513); border-color: var(--color-brand-primary, #8B4513); color: #fff; }
    </style>
}

<!-- App-like header -->
<header class="wizard-appbar lg:hidden" role="banner">
    <div class="flex items-center justify-between gap-2 px-3 py-2">
        <div class="flex items-center gap-1">
            <button type="button" class="btn-icon -ml-2" onclick="history.back()" aria-label="Go back">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <span class="text-base font-bold text-brand-text-primary">Start a return</span>
        </div>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-bold text-brand-primary tracking-tight">FashionStore</a>
    </div>
</header>

<div class="container mx-auto px-4 pt-4 pb-32 safe-bottom lg:pt-8 max-w-2xl">
    <!-- Desktop heading -->
    <div class="hidden lg:block mb-6">
        <h1 class="text-2xl font-bold text-brand-text-primary">Start a return</h1>
        <p class="text-sm text-brand-text-muted mt-1">Order @order.PublicOrderNumber</p>
    </div>

    <!-- Step indicator -->
    <ol class="flex items-center justify-center gap-2 mb-6 lg:mb-8" aria-label="Return steps">
        <li class="flex items-center gap-2">
            <span class="step-dot active" data-step-dot="1">1</span>
            <span class="text-xs font-semibold text-brand-text-primary">Items</span>
        </li>
        <li class="flex-1 h-px bg-brand-border mx-1"></li>
        <li class="flex items-center gap-2">
            <span class="step-dot" data-step-dot="2">2</span>
            <span class="text-xs font-semibold text-brand-text-muted">Reason</span>
        </li>
        <li class="flex-1 h-px bg-brand-border mx-1"></li>
        <li class="flex items-center gap-2">
            <span class="step-dot" data-step-dot="3">3</span>
            <span class="text-xs font-semibold text-brand-text-muted">Confirm</span>
        </li>
    </ol>

    @if (TempData["ReturnError"] != null)
    {
        <div class="alert-danger mb-4" role="alert"><p class="text-sm">@TempData["ReturnError"]</p></div>
    }

    @if (!order.WithinWindow || order.Items.All(i => !i.IsReturnable))
    {
        <div class="text-center py-12">
            <div class="mx-auto mb-4 w-16 h-16 text-brand-text-muted">
                <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                </svg>
            </div>
            <h2 class="text-lg font-bold text-brand-text-primary">No items can be returned</h2>
            <p class="text-sm text-brand-text-muted mt-2 max-w-sm mx-auto">
                @if (!order.WithinWindow)
                {
                    <text>@order.WindowErrorMessage</text>
                }
                else
                {
                    <text>The items in this order are not eligible for a return or exchange.</text>
                }
            </p>
            <a asp-controller="Order" asp-action="Details" asp-route-publicOrderNumber="@order.PublicOrderNumber" asp-route-t="@guestToken" class="btn-primary mt-6 px-6 py-3 text-center">Back to order</a>
        </div>
    }
    else
    {
        <form method="post" asp-action="Create" enctype="multipart/form-data" id="returnForm">
            <input type="hidden" name="PublicOrderNumber" value="@order.PublicOrderNumber" />
            <input type="hidden" name="T" value="@guestToken" />
            <input type="hidden" name="IsExchange" value="@(Model.IsExchange ? "true" : "false")" id="isExchangeInput" />

            <!-- Step 1: Items -->
            <section class="step-body active" data-step="1">
                <h2 class="text-sm font-bold text-brand-text-primary mb-3">Which items are you returning?</h2>
                <div class="space-y-3">
                    @foreach (var item in order.Items)
                    {
                        var index = order.Items.ToList().IndexOf(item);
                        <div class="item-row @(item.IsReturnable ? "" : "opacity-60")">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="thumb" loading="lazy" />
                                }
                                else
                                {
                                    <div class="thumb flex items-center justify-center text-brand-text-muted">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                                        </svg>
                                    </div>
                                }
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-brand-text-primary truncate">@item.ProductName</p>
                                    <p class="text-xs text-brand-text-muted">
                                        @item.Sku
                                        @if (!string.IsNullOrEmpty(item.ColourName)) { <text> · @item.ColourName</text> }
                                        @if (!string.IsNullOrEmpty(item.SizeName)) { <text> · @item.SizeName</text> }
                                    </p>
                                    @if (!item.IsReturnable)
                                    {
                                        <p class="text-[11px] font-medium text-brand-danger mt-0.5">@item.RestrictionReason</p>
                                    }
                                    else
                                    {
                                        <p class="text-[11px] text-brand-text-muted mt-0.5">Available to return: @item.QuantityAvailable of @item.Quantity</p>
                                    }
                                </div>
                            </div>
                            @if (item.IsReturnable)
                            {
                                <div class="mt-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2" data-qty-group data-max="@item.QuantityAvailable" data-unit-refund="@(item.QuantityAvailable > 0 ? (item.RefundableAmount / item.QuantityAvailable).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "0")">
                                        <input type="hidden" name="Items[@index].OrderItemId" value="@item.OrderItemId" />
                                        <input type="hidden" name="Items[@index].Quantity" value="0" data-qty />
                                        <button type="button" class="qty-btn" data-qty-dec aria-label="Decrease quantity" disabled>−</button>
                                        <span class="w-8 text-center text-sm font-bold text-brand-text-primary" data-qty-label>0</span>
                                        <button type="button" class="qty-btn" data-qty-inc aria-label="Increase quantity">+</button>
                                    </div>
                                    <span class="text-xs text-brand-text-muted">Refund @item.RefundableAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="Items[@index].OrderItemId" value="@item.OrderItemId" />
                                <input type="hidden" name="Items[@index].Quantity" value="0" />
                            }
                        </div>
                    }
                </div>
            </section>

            <!-- Step 2: Reason -->
            <section class="step-body" data-step="2">
                <h2 class="text-sm font-bold text-brand-text-primary mb-1">What is the reason?</h2>
                <p class="text-xs text-brand-text-muted mb-3">Your reason helps us improve. Select the closest match.</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Return reason">
                    @foreach (var reason in reasons)
                    {
                        <label class="reason-card" data-reason-card>
                            <input type="radio" name="ReasonCode" value="@reason.Code" class="sr-only" @(reason.Code == "ChangedMind" ? "checked" : "") />
                            <span class="flex items-start gap-3">
                                <span class="mt-0.5 w-5 h-5 rounded-full border-2 border-brand-border flex-shrink-0" data-reason-radio></span>
                                <span>
                                    <span class="block text-sm font-semibold text-brand-text-primary">@reason.Label</span>
                                    @if (!string.IsNullOrEmpty(reason.Description))
                                    {
                                        <span class="block text-xs text-brand-text-muted mt-0.5">@reason.Description</span>
                                    }
                                </span>
                            </span>
                        </label>
                    }
                </div>
            </section>

            <!-- Step 3: Confirm -->
            <section class="step-body" data-step="3">
                <h2 class="text-sm font-bold text-brand-text-primary mb-3">Confirm your return</h2>

                <div class="bg-white border border-brand-border rounded-xl p-4 space-y-2 mb-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-brand-text-muted">Resolution</span>
                        <div class="flex gap-2">
                            <button type="button" class="exchange-pill @(Model.IsExchange ? "" : "selected")" data-mode="refund">Refund</button>
                            <button type="button" class="exchange-pill @(Model.IsExchange ? "selected" : "")" data-mode="exchange">Exchange</button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-brand-text-muted">Items selected</span>
                        <span class="text-sm font-bold text-brand-text-primary" data-selected-count>0</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-brand-text-muted">Estimated refund</span>
                        <span class="text-sm font-bold text-brand-text-primary" data-refund-total>$0.00</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="notes" class="block text-xs font-medium text-brand-text-muted mb-1">Notes (optional)</label>
                    <textarea id="notes" name="Notes" rows="3" maxlength="2000" class="w-full rounded-brand-sm border border-brand-border bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/40" placeholder="Anything we should know?"></textarea>
                </div>

                <div>
                    <label for="photos" class="block text-xs font-medium text-brand-text-muted mb-1">Photos (optional, up to 6)</label>
                    <label for="photos" class="flex items-center justify-center gap-2 w-full border-2 border-dashed border-brand-border rounded-xl px-4 py-6 text-sm text-brand-text-muted hover:border-brand-primary transition-colors cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <span data-photo-label>Tap to attach photos</span>
                    </label>
                    <input type="file" id="photos" name="Photos" class="hidden" accept="image/*" multiple data-photo-input />
                    <p class="text-[11px] text-brand-text-muted mt-1">JPG, PNG or WebP up to 5&nbsp;MB each.</p>
                </div>
            </section>

            <!-- Sticky submit -->
            <div class="sticky-submit fixed bottom-0 left-0 right-0 lg:static lg:p-0 lg:border-0 lg:bg-transparent">
                <div class="container max-w-2xl mx-auto flex gap-3">
                    <button type="button" class="hidden flex-none px-5 py-3 rounded-brand-sm border border-brand-border text-sm font-semibold text-brand-text-primary" data-step-back>Back</button>
                    <button type="button" class="flex-1 px-6 py-3 rounded-brand-sm border border-brand-border text-sm font-semibold text-brand-text-primary" data-step-next>Continue</button>
                    <button type="submit" class="hidden flex-1 px-6 py-3 rounded-brand-sm bg-brand-primary text-white text-sm font-bold" data-step-submit>Submit return</button>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var currentStep = 1;
            var maxStep = 3;
            var data = {};

            function collectItems() {
                var selections = [];
                document.querySelectorAll('[data-qty-group]').forEach(function (group, idx) {
                    var qty = parseInt(group.querySelector('[data-qty]').value || '0', 10);
                    if (qty > 0) {
                        selections.push({
                            orderItemId: group.querySelector('input[name$=".OrderItemId"]').value,
                            quantity: qty
                        });
                    }
                });
                return selections;
            }

            function totalRefund() {
                var total = 0;
                document.querySelectorAll('[data-qty-group]').forEach(function (group) {
                    var qty = parseInt(group.querySelector('[data-qty]').value || '0', 10);
                    var unit = parseFloat(group.getAttribute('data-unit-refund')) || 0;
                    total += qty * unit;
                });
                return total;
            }

            function renderStep() {
                document.querySelectorAll('.step-body').forEach(function (s) {
                    s.classList.toggle('active', s.getAttribute('data-step') == currentStep);
                });
                document.querySelectorAll('[data-step-dot]').forEach(function (dot) {
                    var n = parseInt(dot.getAttribute('data-step-dot'), 10);
                    dot.textContent = n < currentStep ? '✓' : n;
                    dot.classList.toggle('active', n === currentStep);
                    dot.classList.toggle('done', n < currentStep);
                });
                var back = document.querySelector('[data-step-back]');
                var next = document.querySelector('[data-step-next]');
                var submit = document.querySelector('[data-step-submit]');
                back.classList.toggle('hidden', currentStep === 1);
                if (currentStep === maxStep) {
                    next.classList.add('hidden');
                    submit.classList.remove('hidden');
                    submit.classList.add('flex-1');
                } else {
                    next.classList.remove('hidden');
                    submit.classList.add('hidden');
                }
                if (currentStep === 2) {
                    next.textContent = 'Continue';
                }
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            document.querySelectorAll('[data-qty-inc]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var group = btn.closest('[data-qty-group]');
                    var input = group.querySelector('[data-qty]');
                    var label = group.querySelector('[data-qty-label]');
                    var max = parseInt(group.getAttribute('data-max'), 10);
                    var value = parseInt(input.value || '0', 10);
                    if (value < max) {
                        input.value = value + 1;
                        label.textContent = value + 1;
                        var dec = group.querySelector('[data-qty-dec]');
                        dec.disabled = false;
                    }
                    updateSummary();
                });
            });

            document.querySelectorAll('[data-qty-dec]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var group = btn.closest('[data-qty-group]');
                    var input = group.querySelector('[data-qty]');
                    var label = group.querySelector('[data-qty-label]');
                    var value = parseInt(input.value || '0', 10);
                    if (value > 0) {
                        input.value = value - 1;
                        label.textContent = value - 1;
                        if (value - 1 === 0) btn.disabled = true;
                    }
                    updateSummary();
                });
            });

            document.querySelectorAll('[data-reason-card]').forEach(function (card) {
                card.addEventListener('click', function () {
                    var radio = card.querySelector('input[type="radio"]');
                    radio.checked = true;
                    document.querySelectorAll('[data-reason-card]').forEach(function (c) {
                        c.classList.toggle('selected', c === card);
                    });
                    document.querySelectorAll('[data-reason-radio]').forEach(function (r, i) {
                        var inCard = r.closest('[data-reason-card]');
                        var checked = inCard === card;
                        r.classList.toggle('bg-brand-primary', checked);
                        r.classList.toggle('border-brand-primary', checked);
                        r.style.borderColor = checked ? 'var(--color-brand-primary)' : '';
                    });
                });
            });

            document.querySelectorAll('[data-mode]').forEach(function (pill) {
                pill.addEventListener('click', function () {
                    var mode = pill.getAttribute('data-mode');
                    document.querySelector('#isExchangeInput').value = mode === 'exchange' ? 'true' : 'false';
                    document.querySelectorAll('[data-mode]').forEach(function (p) {
                        p.classList.toggle('selected', p === pill);
                    });
                });
            });

            document.querySelector('[data-photo-input]').addEventListener('change', function () {
                var count = this.files.length;
                document.querySelector('[data-photo-label]').textContent = count > 0 ? count + ' photo(s) attached' : 'Tap to attach photos';
            });

            function updateSummary() {
                var selections = collectItems();
                document.querySelector('[data-selected-count]').textContent = selections.reduce(function (s, i) { return s + i.quantity; }, 0);
                document.querySelector('[data-refund-total]').textContent = totalRefund().toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            }

            document.querySelector('[data-step-next]').addEventListener('click', function () {
                if (currentStep === 1) {
                    var selections = collectItems();
                    if (selections.length === 0) {
                        if (window.showToast) window.showToast('Select at least one item to return.', 'error');
                        return;
                    }
                }
                if (currentStep === 2) {
                    var reason = document.querySelector('input[name="ReasonCode"]:checked');
                    if (!reason) {
                        if (window.showToast) window.showToast('Choose a return reason.', 'error');
                        return;
                    }
                    updateSummary();
                }
                if (currentStep < maxStep) {
                    currentStep++;
                    renderStep();
                }
            });

            document.querySelector('[data-step-back]').addEventListener('click', function () {
                if (currentStep > 1) {
                    currentStep--;
                    renderStep();
                }
            });

            renderStep();
        })();
    </script>
}
