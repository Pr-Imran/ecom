@model FashionStore.Application.DTOs.Returns.ReturnDetailDto
@{
    ViewData["Title"] = "Return";
    ViewData["HideMobileHeader"] = true;
    var guestToken = ViewData["GuestAccessToken"] as string;
    var guestOrder = ViewData["GuestOrderNumber"] as string;
    var statusLower = Model.Status.ToLowerInvariant();
    var canShip = Model.Status is "Approved" or "AwaitingShipment";
    var canWithdraw = Model.Status is "Requested" or "UnderReview" or "Approved" or "AwaitingShipment";
    var canUpload = Model.Status is not ("Rejected" or "Closed");
}

@section Styles {
    <style>
        .detail-appbar { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,0.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-brand-border, #e5e7eb); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .return-card { border: 1px solid var(--color-brand-border, #e5e7eb); border-radius: 14px; background: #fff; overflow: hidden; }
        .thumb { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; background: var(--color-brand-surface, #f9fafb); flex-shrink: 0; }
        .status-pill { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.125rem 0.625rem; border-radius: 999px; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; }
        .status-requested, .status-underreview { background: #FEF3C7; color: #92400E; }
        .status-approved, .status-awaitingshipment { background: #DBEAFE; color: #1E40AF; }
        .status-intransit, .status-received { background: #EDE9FE; color: #5B21B6; }
        .status-inspected, .status-refundpending { background: #E0E7FF; color: #3730A3; }
        .status-refunded, .status-exchanged, .status-closed { background: #DCFCE7; color: #166534; }
        .status-rejected { background: #FEE2E2; color: #991B1B; }
        .timeline-line { position: absolute; left: 11px; top: 24px; bottom: 0; width: 2px; background: var(--color-brand-border, #e5e7eb); }
        .timeline-dot { width: 24px; height: 24px; border-radius: 999px; display: flex; align-items: center; justify-content: center; font-size: 0.625rem; font-weight: 700; flex-shrink: 0; border: 1px solid var(--color-brand-border, #e5e7eb); background: #fff; color: #9CA3AF; }
        .timeline-dot.done { background: #D1FAE5; border-color: #6EE7B7; color: #166534; }
        .timeline-dot.current { background: var(--color-brand-primary, #8B4513); border-color: var(--color-brand-primary, #8B4513); color: #fff; }
        .sticky-actions { position: sticky; bottom: 0; z-index: 20; background: rgba(255,255,255,0.94); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-top: 1px solid var(--color-brand-border, #e5e7eb); padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom)); }
    </style>
}

<!-- App-like header -->
<header class="detail-appbar lg:hidden" role="banner">
    <div class="flex items-center justify-between gap-2 px-3 py-2">
        <div class="flex items-center gap-1">
            <button type="button" class="btn-icon -ml-2" onclick="history.back()" aria-label="Go back">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <span class="text-base font-bold text-brand-text-primary">Return details</span>
        </div>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-bold text-brand-primary tracking-tight">FashionStore</a>
    </div>
</header>

<div class="container mx-auto px-4 pt-4 pb-32 safe-bottom lg:pt-8 max-w-2xl">
    <!-- Desktop heading -->
    <div class="hidden lg:block mb-6">
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold text-brand-text-primary">@Model.ReturnNumber</h1>
            <span class="status-pill status-@statusLower">@(Model.Status == "AwaitingShipment" ? "Awaiting shipment" : Model.Status)</span>
        </div>
        <p class="text-sm text-brand-text-muted mt-1">
            Order <a asp-controller="Order" asp-action="Details" asp-route-publicOrderNumber="@Model.OrderNumber" asp-route-t="@guestToken" class="text-brand-primary hover:underline">@Model.OrderNumber</a>
            · Created @Model.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
        </p>
    </div>

    @if (TempData["ReturnMessage"] != null)
    {
        <div class="alert-success mb-4" role="alert"><p class="text-sm">@TempData["ReturnMessage"]</p></div>
    }
    @if (TempData["ReturnError"] != null)
    {
        <div class="alert-danger mb-4" role="alert"><p class="text-sm">@TempData["ReturnError"]</p></div>
    }

    <!-- Mobile status header -->
    <div class="lg:hidden return-card p-4 mb-4">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs text-brand-text-muted">@Model.ReturnNumber</p>
                <p class="text-sm font-bold text-brand-text-primary mt-0.5">@(Model.Items.FirstOrDefault()?.ProductName ?? "Return")</p>
            </div>
            <span class="status-pill status-@statusLower">@(Model.Status == "AwaitingShipment" ? "Awaiting shipment" : Model.Status)</span>
        </div>
        <p class="text-xs text-brand-text-muted mt-2">
            Order @Model.OrderNumber · Created @Model.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
        </p>
    </div>

    <!-- Financial summary -->
    <section class="return-card p-4 mb-4">
        <h2 class="text-sm font-bold text-brand-text-primary mb-2">Return summary</h2>
        <div class="space-y-1.5 text-sm">
            <div class="flex items-center justify-between">
                <span class="text-brand-text-muted">Reason</span>
                <span class="font-medium text-brand-text-primary">@Model.ReasonCode</span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-brand-text-muted">Resolution</span>
                <span class="font-medium text-brand-text-primary">@(Model.Resolution == "Exchange" ? "Exchange" : "Refund")</span>
            </div>
            @if (Model.IsExchange)
            {
                <div class="flex items-center justify-between">
                    <span class="text-brand-text-muted">Type</span>
                    <span class="font-medium text-brand-text-primary">Exchange request</span>
                </div>
            }
            <div class="flex items-center justify-between">
                <span class="text-brand-text-muted">Refundable amount</span>
                <span class="font-bold text-brand-text-primary">@Model.RefundableAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
            </div>
            @if (Model.RefundedAmount > 0m)
            {
                <div class="flex items-center justify-between">
                    <span class="text-brand-text-muted">Refunded amount</span>
                    <span class="font-bold text-emerald-600">@Model.RefundedAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.TrackingNumber))
            {
                <div class="flex items-center justify-between">
                    <span class="text-brand-text-muted">Tracking</span>
                    <span class="font-medium text-brand-text-primary">@(Model.CarrierCode?.ToUpperInvariant() + " " ?? "")@Model.TrackingNumber</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.CustomerNotes))
            {
                <div class="pt-2 mt-2 border-t border-brand-border">
                    <p class="text-xs text-brand-text-muted">Your note</p>
                    <p class="text-sm text-brand-text-primary mt-1">@Model.CustomerNotes</p>
                </div>
            }
        </div>
    </section>

    <!-- Items -->
    <section class="return-card p-4 mb-4">
        <h2 class="text-sm font-bold text-brand-text-primary mb-3">Items (@Model.Items.Count)</h2>
        <div class="space-y-3">
            @foreach (var item in Model.Items)
            {
                <div class="flex items-center gap-3">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.ProductName" class="thumb" loading="lazy" />
                    }
                    else
                    {
                        <div class="thumb flex items-center justify-center text-brand-text-muted">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                            </svg>
                        </div>
                    }
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-brand-text-primary truncate">@item.ProductName</p>
                        <p class="text-xs text-brand-text-muted">
                            @item.Sku
                            @if (!string.IsNullOrEmpty(item.ColourName)) { <text> · @item.ColourName</text> }
                            @if (!string.IsNullOrEmpty(item.SizeName)) { <text> · @item.SizeName</text> }
                            · × @item.Quantity
                        </p>
                        @if (item.Condition != "Undetermined")
                        {
                            <p class="text-[11px] mt-0.5 @(item.Condition == "Sellable" ? "text-emerald-600" : "text-brand-danger") font-medium">
                                Condition: @item.Condition@(item.IsRestocked ? " · restocked" : "")
                            </p>
                        }
                    </div>
                    <span class="text-sm font-bold text-brand-text-primary">@item.RefundableAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                </div>
            }
        </div>
    </section>

    <!-- Timeline -->
    <section class="return-card p-4 mb-4">
        <h2 class="text-sm font-bold text-brand-text-primary mb-3">Status timeline</h2>
        <ol class="relative">
            @foreach (var entry in Model.Timeline)
            {
                var isLast = entry.Sequence == Model.Timeline.Count;
                <li class="relative pl-8 pb-4 @(isLast ? "pb-0" : "")">
                    @if (!isLast)
                    {
                        <span class="timeline-line"></span>
                    }
                    <span class="timeline-dot @(isLast ? "current" : "done")">@entry.Sequence</span>
                    <div class="pt-0.5">
                        <p class="text-sm font-semibold text-brand-text-primary">
                            @(entry.ToStatus == "AwaitingShipment" ? "Awaiting shipment" : entry.ToStatus)
                        </p>
                        @if (!string.IsNullOrEmpty(entry.Note))
                        {
                            <p class="text-xs text-brand-text-muted mt-0.5">@entry.Note</p>
                        }
                        <p class="text-[11px] text-brand-text-muted mt-0.5">
                            @entry.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")@(string.IsNullOrEmpty(entry.Actor) ? "" : $" · {entry.Actor}")
                        </p>
                    </div>
                </li>
            }
        </ol>
    </section>

    <!-- Refunds -->
    @if (Model.Refunds.Count > 0)
    {
        <section class="return-card p-4 mb-4">
            <h2 class="text-sm font-bold text-brand-text-primary mb-3">Refunds</h2>
            <div class="space-y-3">
                @foreach (var refund in Model.Refunds)
                {
                    <div class="border border-brand-border rounded-xl p-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-semibold text-brand-text-primary">@refund.ReferenceNumber</span>
                            <span class="text-sm font-bold text-brand-text-primary">@refund.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                        </div>
                        <p class="text-xs text-brand-text-muted mt-1">
                            @refund.Type@(refund.IsGatewayRefund ? " · gateway" : " · manual") · @refund.Status
                        </p>
                        @if (!string.IsNullOrEmpty(refund.FailureReason))
                        {
                            <p class="text-[11px] text-brand-danger mt-1">@refund.FailureReason</p>
                        }
                        @if (refund.CompletedAtUtc.HasValue)
                        {
                            <p class="text-[11px] text-brand-text-muted mt-1">Completed @refund.CompletedAtUtc.Value.ToLocalTime().ToString("MMM d, yyyy")</p>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <!-- Exchanges -->
    @if (Model.Exchanges.Count > 0)
    {
        <section class="return-card p-4 mb-4">
            <h2 class="text-sm font-bold text-brand-text-primary mb-3">Exchanges</h2>
            <div class="space-y-3">
                @foreach (var exchange in Model.Exchanges)
                {
                    <div class="border border-brand-border rounded-xl p-3">
                        <p class="text-sm font-semibold text-brand-text-primary">@exchange.ProductName</p>
                        <p class="text-xs text-brand-text-muted mt-0.5">@exchange.Sku · × @exchange.Quantity · @exchange.Status</p>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Photos -->
    @if (Model.Attachments.Count > 0)
    {
        <section class="return-card p-4 mb-4">
            <h2 class="text-sm font-bold text-brand-text-primary mb-3">Photos (@Model.Attachments.Count)</h2>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var attachment in Model.Attachments)
                {
                    <a href="@attachment.Url" target="_blank" rel="noopener" class="aspect-square rounded-xl overflow-hidden border border-brand-border block">
                        <img src="@attachment.Url" alt="@attachment.OriginalFileName" class="w-full h-full object-cover" loading="lazy" />
                    </a>
                }
            </div>
        </section>
    }

    <!-- Ship-back form -->
    @if (canShip)
    {
        <section class="return-card p-4 mb-4" id="ship">
            <h2 class="text-sm font-bold text-brand-text-primary mb-1">Ship your items back</h2>
            <p class="text-xs text-brand-text-muted mb-3">Your return has been approved. Add the courier tracking details once you have dropped it off.</p>
            <form method="post" asp-action="Ship" asp-route-returnNumber="@Model.ReturnNumber">
                @Html.AntiForgeryToken()
                @if (guestToken != null)
                {
                    <input type="hidden" name="t" value="@guestToken" />
                    <input type="hidden" name="order" value="@guestOrder" />
                }
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="carrierCode" class="block text-xs font-medium text-brand-text-muted mb-1">Carrier (optional)</label>
                        <input id="carrierCode" name="carrierCode" maxlength="50" placeholder="UPS, FedEx, DHL..." class="w-full rounded-brand-sm border border-brand-border bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/40" />
                    </div>
                    <div>
                        <label for="trackingNumber" class="block text-xs font-medium text-brand-text-muted mb-1">Tracking number</label>
                        <input id="trackingNumber" name="trackingNumber" maxlength="100" required class="w-full rounded-brand-sm border border-brand-border bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/40" />
                    </div>
                </div>
                <button type="submit" class="w-full mt-3 py-3 rounded-brand-sm bg-brand-primary text-white text-sm font-bold">I've shipped it back</button>
            </form>
        </section>
    }

    <!-- Upload more photos -->
    @if (canUpload)
    {
        <section class="return-card p-4 mb-4">
            <h2 class="text-sm font-bold text-brand-text-primary mb-3">Add photos</h2>
            <form method="post" asp-action="UploadAttachments" asp-route-returnNumber="@Model.ReturnNumber" enctype="multipart/form-data" id="uploadForm">
                @Html.AntiForgeryToken()
                @if (guestToken != null)
                {
                    <input type="hidden" name="t" value="@guestToken" />
                    <input type="hidden" name="order" value="@guestOrder" />
                }
                <label for="files" class="flex items-center justify-center gap-2 w-full border-2 border-dashed border-brand-border rounded-xl px-4 py-5 text-sm text-brand-text-muted hover:border-brand-primary transition-colors cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span>Tap to add photos</span>
                </label>
                <input type="file" id="files" name="files" class="hidden" accept="image/*" multiple />
                <button type="submit" class="w-full mt-3 py-3 rounded-brand-sm border border-brand-border text-brand-text-primary text-sm font-semibold" id="uploadBtn" disabled>Upload photos</button>
            </form>
        </section>
    }

    <!-- Withdraw -->
    @if (canWithdraw)
    {
        <section class="return-card p-4">
            <h2 class="text-sm font-bold text-brand-text-primary mb-1">Changed your mind?</h2>
            <p class="text-xs text-brand-text-muted mb-3">Withdrawing this return releases the items back to your account so you can submit a new request later.</p>
            <form method="post" asp-action="Cancel" asp-route-returnNumber="@Model.ReturnNumber"
                  onsubmit="return confirm('Withdraw this return request?');">
                @Html.AntiForgeryToken()
                @if (guestToken != null)
                {
                    <input type="hidden" name="t" value="@guestToken" />
                    <input type="hidden" name="order" value="@guestOrder" />
                }
                <button type="submit" class="w-full py-3 rounded-brand-sm border border-brand-danger text-brand-danger text-sm font-semibold">Withdraw return</button>
            </form>
        </section>
    }

    <!-- Sticky actions (mobile) -->
    @if (canShip || canWithdraw)
    {
        <div class="sticky-actions fixed bottom-0 left-0 right-0 lg:hidden">
            <div class="container max-w-2xl mx-auto flex gap-3">
                <a asp-controller="Order" asp-action="Details" asp-route-publicOrderNumber="@Model.OrderNumber" asp-route-t="@guestToken" class="flex-1 px-6 py-3 rounded-brand-sm border border-brand-border text-sm font-semibold text-brand-text-primary text-center">Back to order</a>
                @if (canShip)
                {
                    <a href="#ship" class="flex-1 px-6 py-3 rounded-brand-sm bg-brand-primary text-white text-sm font-bold text-center">Ship it back</a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var fileInput = document.querySelector('#files');
            var uploadBtn = document.querySelector('#uploadBtn');
            if (fileInput && uploadBtn) {
                fileInput.addEventListener('change', function () {
                    uploadBtn.disabled = fileInput.files.length === 0;
                });
                var form = document.querySelector('#uploadForm');
                if (form) {
                    form.addEventListener('submit', function () {
                        if (uploadBtn) uploadBtn.disabled = true;
                        if (window.showToast) window.showToast('Uploading…', 'info');
                    });
                }
            }
        })();
    </script>
}
