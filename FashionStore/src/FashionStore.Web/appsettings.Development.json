{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=FashionStore_Dev;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Store": {
    "Name": "FashionStore (Dev)",
    "ContactEmail": "dev@fashionstore.example.com"
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "UseSsl": false,
    "BaseUrl": "https://localhost:5001"
  },
  "Payments": {
    "Providers": [
      {
        "ProviderCode": "card",
        "DisplayName": "Card Payment",
        "IsEnabled": true,
        "WebhookSecret": "dev-placeholder-card-secret",
        "SupportsHostedCheckout": true
      },
      {
        "ProviderCode": "mfs",
        "DisplayName": "Mobile Wallet",
        "IsEnabled": true,
        "WebhookSecret": "dev-placeholder-mfs-secret",
        "SupportsHostedCheckout": false
      },
      {
        "ProviderCode": "bank",
        "DisplayName": "Bank Transfer",
        "IsEnabled": true,
        "WebhookSecret": "dev-placeholder-bank-secret",
        "SupportsHostedCheckout": false
      }
    ]
  },
  "Order": {
    "GuestAccessTokenSecret": "dev-guest-order-access-secret"
  },
  "DataProtection": {
    "ApplicationName": "FashionStore",
    "KeysDirectory": "App_Data/DataProtection-Keys"
  },
  "Checkout": {
    "ContinuationTokenSecret": "dev-checkout-continuation-secret"
  }
}
