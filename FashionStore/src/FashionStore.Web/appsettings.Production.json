{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 60,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 30
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Email": {
    "FromAddress": "noreply@fashionstore.example.com",
    "FromName": "FashionStore",
    "Provider": "Custom",
    "BaseUrl": "",
    "AdminAlertRecipients": "",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "UseSsl": true
  },
  "FileStorage": {
    "Provider": "Local",
    "BasePath": "uploads",
    "PublicUrlBase": "/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp", ".avif"]
  },
  "CloudFileStorage": {
    "Provider": "AzureBlob",
    "ContainerName": "fashionstore-assets",
    "ConnectionString": "",
    "AccountName": "",
    "AccountKey": "",
    "BucketName": "",
    "Region": "",
    "RetryCount": 3
  },
  "Payments": {
    "WebhookTimestampToleranceSeconds": 300,
    "ReturnUrl": "/checkout/confirmation",
    "CancelUrl": "/checkout/confirmation",
    "Providers": [
      {
        "ProviderCode": "cod",
        "DisplayName": "Cash on Delivery",
        "IsEnabled": true,
        "WebhookSecret": "",
        "SupportsHostedCheckout": false
      },
      {
        "ProviderCode": "card",
        "DisplayName": "Card Payment",
        "IsEnabled": true,
        "WebhookSecret": "",
        "SupportsHostedCheckout": true
      },
      {
        "ProviderCode": "mfs",
        "DisplayName": "Mobile Wallet",
        "IsEnabled": true,
        "WebhookSecret": "",
        "SupportsHostedCheckout": false
      },
      {
        "ProviderCode": "bank",
        "DisplayName": "Bank Transfer",
        "IsEnabled": true,
        "WebhookSecret": "",
        "SupportsHostedCheckout": false
      }
    ]
  },
  "Checkout": {
    "ContinuationTokenSecret": ""
  },
  "Order": {
    "GuestAccessTokenSecret": ""
  },
  "DataProtection": {
    "ApplicationName": "FashionStore",
    "KeysDirectory": "App_Data/DataProtection-Keys"
  },
  "BackgroundJobs": {
    "Enabled": true,
    "ServerName": "FashionStore-Prod-Server",
    "WorkerCount": 8,
    "RetentionDays": 30,
    "Queues": ["default", "email", "invoice", "cleanup"]
  },
  "Hangfire": {
    "DashboardEnabled": false,
    "DashboardRole": "SuperAdmin"
  }
}
