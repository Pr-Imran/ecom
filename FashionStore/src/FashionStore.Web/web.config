<?xml version="1.0" encoding="utf-8"?>
<!--
  FashionStore IIS hosting configuration (Windows Server + IIS).

  Requirements:
    * .NET 8 ASP.NET Core Hosting Bundle (v8.0.x) installed on the server
    * "dotnet" on the machine PATH, or a full path below
    * The application pool must run in "No Managed Code" / "InProcess"
      (hostingModel="inprocess" below)

  Published by `dotnet publish -c Release -o ./publish`; place the contents of
  the publish folder in the IIS site physical path (e.g. C:\inetpub\fashionstore).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\FashionStore.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
