{
  "name": "fashionstore-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI-level verification preparation for FashionStore",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:mobile": "playwright test --project=chromium-mobile",
    "test:desktop": "playwright test --project=chromium-desktop",
    "report": "playwright show-report",
    "install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.5.0"
  }
}
